\",\"changed\":\"\\u003Ctime datetime=\\u00222024-01-04T14:42:40-05:00\\u0022\\u003E1704397360\\u003C\\/time\\u003E\\n\"},{\"id\":\"666\",\"internal_id\":\"login-memory-error-mac\",\"type\":\"functional_content\",\"title\":\"Memory Failure\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EBluebook requires a minimum memory of 2 GB RAM.\\u0026nbsp;\\u003Cstrong\\u003EYou cannot test with this device.\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"login-memory-error-mac-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-01-04T14:40:44-05:00\\u0022\\u003E1704397244\\u003C\\/time\\u003E\\n\"},{\"id\":\"661\",\"internal_id\":\"login-os-error-cbook\",\"type\":\"functional_content\",\"title\":\"Operating System Failure\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003EYour device needs to be running \\u003C\\/span\\u003EChrome OS 144 or later.\\u003Cspan\\u003E\\u0026nbsp;\\u003Cstrong\\u003EYou cannot test with this device.\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"login-os-error-cbook-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-21T14:21:25-04:00\\u0022\\u003E1784658085\\u003C\\/time\\u003E\\n\"},{\"id\":\"656\",\"internal_id\":\"login-os-error-ipad\",\"type\":\"functional_content\",\"title\":\"Operating System Failure\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan class=\\u0022ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\\u0022 dir=\\u0022ltr\\u0022\\u003EYour device needs to be running iPad OS 18.0 or later.\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cstrong\\u003E Update your operating system and try again.\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"login-os-error-ipad-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-08-05T12:40:17-04:00\\u0022\\u003E1785948017\\u003C\\/time\\u003E\\n\"},{\"id\":\"651\",\"internal_id\":\"login-os-error-pc\",\"type\":\"functional_content\",\"title\":\"Operating System Failure\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003EYour device needs to be running Windows 11 24H2 or later.\\u0026nbsp;\\u003Cstrong\\u003EUpdate your operating system and try again.\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"login-os-error-pc-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-21T14:29:59-04:00\\u0022\\u003E1784658599\\u003C\\/time\\u003E\\n\"},{\"id\":\"646\",\"internal_id\":\"login-os-error-mac\",\"type\":\"functional_content\",\"title\":\"Operating System Failure\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYour device needs to be running macOS 15.0 or later.\\u0026nbsp;\\u003Cstrong\\u003EUpdate your operating system and try again.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"login-os-error-mac-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-21T14:31:09-04:00\\u0022\\u003E1784658669\\u003C\\/time\\u003E\\n\"},{\"id\":\"641\",\"internal_id\":\"option-eliminator\",\"type\":\"help_detail\",\"title\":\"Option Eliminator\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cimg src=\\u0027data:image\\/svg+xml;base64,\\u0027  alt=\\u0022\\u0022 \\/\\u003E \\n\\u003Cstrong\\u003EOption Eliminator: \\u003C\\/strong\\u003EOn any multiple-choice question, you can cross out answer options you think are wrong. Click the strikethrough button next to any answer option to cross it out (you can always undo this action). To turn off option eliminator mode, click the \\u003Cstrong\\u003EABC\\u003C\\/strong\\u003E button above the answer choices\\u003C\\/p\\u003E\\n\\n\\n\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-07-28T09:47:12-04:00\\u0022\\u003E1753710432\\u003C\\/time\\u003E\\n\"},{\"id\":\"636\",\"internal_id\":\"checkin-confirm-device\",\"type\":\"functional_content\",\"title\":\"Confirm Device Information\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"Who owns this device?\\n\",\"id\":\"checkin-confirm-device-p1\"},{\"content\":\"I own this device (or I borrowed it from someone I know).\\n\",\"id\":\"checkin-confirm-device-p2\"},{\"content\":\"I borrowed this device from College Board.\\n\",\"id\":\"checkin-confirm-device-p3\"},{\"content\":\"My school or test center owns this device.\\n\",\"id\":\"checkin-confirm-device-p4\"},{\"content\":\"Do other students use this device?\\n\",\"id\":\"checkin-confirm-device-p5\"},{\"content\":\"No, I\\u0027m the only student who uses this device.\\n\",\"id\":\"checkin-confirm-device-p6\"},{\"content\":\"Yes, I share this device with other students.\\n\",\"id\":\"checkin-confirm-device-p7\"},{\"content\":\"This information helps us resolve issues faster if you have a problem with your device.\\n\",\"id\":\"checkin-confirm-device-p8\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-08-15T17:07:47-04:00\\u0022\\u003E1660597667\\u003C\\/time\\u003E\\n\"},{\"id\":\"626\",\"internal_id\":\"checkin-lockdown-macos\",\"type\":\"functional_content\",\"title\":\"We\\u0027re About to Lock Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EIf you have any other apps or software running, please exit out of them now.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003EIf you attempt to use other programs or apps during the exam, your scores will be canceled.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"checkin-lockdown-macos-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-11-30T17:34:17-05:00\\u0022\\u003E1701383657\\u003C\\/time\\u003E\\n\"},{\"id\":\"621\",\"internal_id\":\"scoring-practice-hp\",\"type\":\"profile_collection\",\"title\":\"Bluebook Practice\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"866\",\"title\":\"AP Exam Previews\",\"body\":\"\\u003Cp\\u003EThese short previews will give you a way to see real AP questions in the app, try out the testing tools, and practice testing with any assistive technology you may use.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EAP Exam previews will not be scored.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"871\",\"title\":\"Full-Length AP Practice\",\"body\":\"\\u003Cp\\u003EFull-length AP practice is not available in Bluebook. Your AP teacher can assign practice exams to you in \\u003Cstrong\\u003EAP Classroom\\u003C\\/strong\\u003E. Please check there to see what practice resources are available for your course.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"1196\",\"title\":\"Full-Length PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9 Practice\",\"body\":\"\\u003Cp\\u003EIf you take a full-length practice test for any of the PSAT-related assessments, your scores will be available on \\u003Cstrong\\u003EMy Practice\\u003C\\/strong\\u003E. Make sure you sign in to My Practice the same way you signed in to Bluebook to see your practice test scores.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you take a practice test more than once, you\\u0027ll just see one listing for it on the \\u003Cstrong\\u003EPast \\u003C\\/strong\\u003Etab under \\u003Cstrong\\u003EPractice and Prepare\\u003C\\/strong\\u003E. But when you go to My Practice, each completed test will be listed.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/57\\u0022 hreflang=\\u0022en\\u0022\\u003EPSAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"616\",\"title\":\"SAT Test Preview\",\"body\":\"\\u003Cp\\u003EThis short preview gives you a way to see real SAT questions in the app, try out the testing tools, and practice testing with any assistive technology you may use.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you take the SAT test preview, you won\\u0027t get a score. To get a score on a practice test, return to the homepage and select \\u003Cstrong\\u003ESAT\\u0026nbsp;\\u003C\\/strong\\u003E\\u003Cstrong\\u003EFull-Length Practice\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\",\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"611\",\"title\":\"Full-Length SAT Practice\",\"body\":\"\\u003Cp\\u003EIf you take a full-length SAT practice test, your scores will be available on\\u0026nbsp;\\u003Cstrong\\u003EMy Practice\\u003C\\/strong\\u003E. Make sure you sign in to My Practice the same way you signed in to Bluebook to see your practice test scores.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you take a practice test more than once, you\\u0027ll just see one listing for it on the\\u0026nbsp;\\u003Cstrong\\u003EPast\\u0026nbsp;\\u003C\\/strong\\u003Etab under\\u0026nbsp;\\u003Cstrong\\u003EPractice and Prepare\\u003C\\/strong\\u003E. But when you go to My SAT, each completed test will be listed.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-06-28T16:09:56-04:00\\u0022\\u003E1687982996\\u003C\\/time\\u003E\\n\"},{\"id\":\"616\",\"internal_id\":\"prac-help-preview-sat\",\"type\":\"help_detail\",\"title\":\"SAT Test Preview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThis short preview gives you a way to see real SAT questions in the app, try out the testing tools, and practice testing with any assistive technology you may use.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you take the SAT test preview, you won\\u0027t get a score. To get a score on a practice test, return to the homepage and select \\u003Cstrong\\u003ESAT\\u0026nbsp;\\u003C\\/strong\\u003E\\u003Cstrong\\u003EFull-Length Practice\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"offering\":\"SAT, AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-02-09T19:51:03-05:00\\u0022\\u003E1675990263\\u003C\\/time\\u003E\\n\"},{\"id\":\"611\",\"internal_id\":\"prac-help-full-sat\",\"type\":\"help_detail\",\"title\":\"Full-Length SAT Practice\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you take a full-length SAT practice test, your scores will be available on\\u0026nbsp;\\u003Cstrong\\u003EMy Practice\\u003C\\/strong\\u003E. Make sure you sign in to My Practice the same way you signed in to Bluebook to see your practice test scores.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you take a practice test more than once, you\\u0027ll just see one listing for it on the\\u0026nbsp;\\u003Cstrong\\u003EPast\\u0026nbsp;\\u003C\\/strong\\u003Etab under\\u0026nbsp;\\u003Cstrong\\u003EPractice and Prepare\\u003C\\/strong\\u003E. But when you go to My SAT, each completed test will be listed.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-06-28T15:42:03-04:00\\u0022\\u003E1687981323\\u003C\\/time\\u003E\\n\"},{\"id\":\"606\",\"internal_id\":\"dont-see-yr-test-hp\",\"type\":\"profile_collection\",\"title\":\"Don\\u0027t See Your Test Here?\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"601\",\"title\":\"If You\\u0027re Taking an AP Exam\",\"body\":\"\\u003Cp\\u003EIf you\\u0027re registered for an AP Exam, you\\u0027ll see your exam listed on the Bluebook app homepage five days before your test date. Make sure you\\u2019re signed in to Bluebook with a College Board account.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf it\\u0027s within five days of your exam, and it\\u0027s not showing up in the app, please contact your teacher or your AP coordinator.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"1191\",\"title\":\"If You\\u2019re Taking a PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9\",\"body\":\"\\u003Cp\\u003EIf you\\u0027re registered for any PSAT-related assessment, your school will give you a sign-in ticket that you\\u2019ll use to access Bluebook. Then you\\u0027ll see your test listed on the homepage.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003EIf you signed in with a College Board account, you need to sign out and then sign back in using your sign-in ticket.\\u003C\\/p\\u003E\\u003Cp\\u003EIf your test is still not showing up, please contact your teacher or someone at your school.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/57\\u0022 hreflang=\\u0022en\\u0022\\u003EPSAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"596\",\"title\":\"If You\\u0027re Taking an SAT\",\"body\":\"\\u003Cp\\u003EIf you\\u0027re registered to take the SAT on a weekend, you\\u0027ll see it listed on the Bluebook homepage five days before your test date. Make sure you\\u2019re signed in to Bluebook with a College Board account (if not, you need to sign out then sign back in).\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you\\u0027re taking the SAT on a school day, your school will give you a sign-in ticket that you\\u2019ll use to access Bluebook (if you signed in with a College Board account, you need to sign out and then sign back in).\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf it\\u0027s within five days of your test, and it\\u0027s not showing up in the app, please contact your teacher or your SAT coordinator.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-06-28T16:05:33-04:00\\u0022\\u003E1687982733\\u003C\\/time\\u003E\\n\"},{\"id\":\"601\",\"internal_id\":\"dont-see-yr-test-ap\",\"type\":\"help_detail\",\"title\":\"If You\\u0027re Taking an AP Exam\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you\\u0027re registered for an AP Exam, you\\u0027ll see your exam listed on the Bluebook app homepage five days before your test date. Make sure you\\u2019re signed in to Bluebook with a College Board account.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf it\\u0027s within five days of your exam, and it\\u0027s not showing up in the app, please contact your teacher or your AP coordinator.\\u003C\\/p\\u003E\",\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-01-19T14:21:59-05:00\\u0022\\u003E1705692119\\u003C\\/time\\u003E\\n\"},{\"id\":\"596\",\"internal_id\":\"dont-see-yr-test-sat\",\"type\":\"help_detail\",\"title\":\"If You\\u0027re Taking an SAT\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you\\u0027re registered to take the SAT on a weekend, you\\u0027ll see it listed on the Bluebook homepage five days before your test date. Make sure you\\u2019re signed in to Bluebook with a College Board account (if not, you need to sign out then sign back in).\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you\\u0027re taking the SAT on a school day, your school will give you a sign-in ticket that you\\u2019ll use to access Bluebook (if you signed in with a College Board account, you need to sign out and then sign back in).\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf it\\u0027s within five days of your test, and it\\u0027s not showing up in the app, please contact your teacher or your SAT coordinator.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-01-19T14:20:46-05:00\\u0022\\u003E1705692046\\u003C\\/time\\u003E\\n\"},{\"id\":\"586\",\"internal_id\":\"checkin-overview-sat-linear\",\"type\":\"functional_content\",\"title\":\"Test Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe digital SAT, PSAT\\/NMSQT, PSAT 10, and PSAT 8\\/9 each consist of a Reading and Writing section and a Math section.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection 1: Reading and Writing (66 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Reading and Writing section. Each module has 33 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection 2: Math (54 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Math section. Each module has 27 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003EModules\\u003C\\/h2\\u003E\\u003Cp\\u003EWithin each section, the two modules are timed separately. If time permits, you can review your answers in a given module. When the timer reaches zero, you will automatically move on. Once you move on from any module, you cannot return to it.\\u003C\\/p\\u003E\\u003Ch2\\u003EDirections\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDirections for answering the questions appear at the start of each section. You can find these directions at the top-left corner of every question screen.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-sat-linear-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-31T12:55:00-04:00\\u0022\\u003E1722444900\\u003C\\/time\\u003E\\n\"},{\"id\":\"581\",\"internal_id\":\"bf-hp-generic\",\"type\":\"functional_content\",\"title\":\"Plan for Life After High School\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EWhether you\\u2019re interested in a four-year university, community college, or career training, BigFuture has what you need to start planning your future, your way.\\u003C\\/p\\u003E\",\"id\":\"bf-hp-generic-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-08-14T13:55:24-04:00\\u0022\\u003E1692035724\\u003C\\/time\\u003E\\n\"},{\"id\":\"576\",\"internal_id\":\"full-prac-intro-sat\",\"type\":\"functional_content\",\"title\":\"Practice Test\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch2\\u003ETiming\\u003C\\/h2\\u003E\\u003Cp\\u003EPractice tests are timed, but you can pause them. To continue on another device, you have to start over. We delete incomplete practice tests after 90 days.\\u003C\\/p\\u003E\",\"icon\":\"ico-clock\",\"id\":\"full-prac-intro-sat-p1\"},{\"content\":\"\\u003Ch2\\u003EScores\\u003C\\/h2\\u003E\\u003Cp\\u003EWhen you finish the practice test, go to\\u0026nbsp;\\u003Cstrong\\u003EMy Practice\\u0026nbsp;\\u003C\\/strong\\u003Eto see your scores and get personalized study tips.\\u003C\\/p\\u003E\",\"icon\":\"ico-scores\",\"id\":\"full-prac-intro-sat-p2\"},{\"content\":\"\\u003Ch2\\u003EAssistive Technology (AT)\\u003C\\/h2\\u003E\\u003Cp\\u003E\\u003Cspan\\u003EBe sure to practice with any AT you use for testing. If you configure your AT settings here, you may need to repeat this step on test day.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-assist-tech-figure\",\"id\":\"full-prac-intro-sat-p3\"},{\"content\":\"\\u003Ch2\\u003ENo Device Lock\\u003C\\/h2\\u003E\\u003Cp\\u003EWe don\\u2019t lock your device during practice. On test day, you\\u0027ll be blocked from using other programs or apps.\\u003C\\/p\\u003E\",\"icon\":\"ico-unlock\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-13T13:57:50-04:00\\u0022\\u003E1773424670\\u003C\\/time\\u003E\\n\"},{\"id\":\"571\",\"internal_id\":\"review4-ap\",\"type\":\"functional_content\",\"title\":\"Testing in Progress: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EWhen the timer reaches zero, your answers will be submitted automatically.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EDo not close your device, quit the app, or leave the room or your answers may not be submitted.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EIn the meantime, look \\u003Cspan\\u003Eover your work and go back to any questions you marked for review.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"review4-ap-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-24T18:50:13-04:00\\u0022\\u003E1774392613\\u003C\\/time\\u003E\\n\"},{\"id\":\"566\",\"internal_id\":\"review123-ap\",\"type\":\"functional_content\",\"title\":\"Check Your Work\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003ELook over your work and go back to any questions you marked for review.\\u003C\\/p\\u003E\\u003Cp\\u003EWhen the timer reaches zero, you\\u0027ll automatically move on. \\u003Cstrong\\u003EPlease stay seated and remain quiet.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"review123-sat-wkd-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-17T10:53:01-04:00\\u0022\\u003E1773759181\\u003C\\/time\\u003E\\n\"},{\"id\":\"561\",\"internal_id\":\"review4-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Testing in Progress: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EWhen the timer reaches zero, your answers will be submitted automatically.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EDo not close your device, quit the app, or leave the room or your answers may not be submitted.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EIn the meantime, please l\\u003Cspan\\u003Eook over your work and check any questions you marked for review.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"review4-sat-wkd-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT Weekend\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-12-17T17:09:44-05:00\\u0022\\u003E1734473384\\u003C\\/time\\u003E\\n\"},{\"id\":\"556\",\"internal_id\":\"review123-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Check Your Work\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003ELook over your work and check any questions you marked for review.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EWhen the timer reaches zero, you\\u0027ll automatically move on.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EPlease stay seated and remain quiet.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"review123-sat-wkd-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT Weekend\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-12-17T17:02:12-05:00\\u0022\\u003E1734472932\\u003C\\/time\\u003E\\n\"},{\"id\":\"551\",\"internal_id\":\"review4-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Testing in Progress: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EWhen the timer reaches zero, your answers will be submitted automatically.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EDo not close your device, quit the app, or leave the room or your answers may not be submitted.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EIn the meantime, please l\\u003Cspan\\u003Eook over your work and check any questions you marked for review.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"review4-sat-schoolday-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT School Day\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-12-17T17:09:04-05:00\\u0022\\u003E1734473344\\u003C\\/time\\u003E\\n\"},{\"id\":\"546\",\"internal_id\":\"review123-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Check Your Work\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003ELook over your work and check any questions you marked for review.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EWhen the timer reaches zero, you\\u0027ll automatically move on.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EPlease stay seated and remain quiet.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"review123-sat-schoolday-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT School Day\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-12-17T17:07:27-05:00\\u0022\\u003E1734473247\\u003C\\/time\\u003E\\n\"},{\"id\":\"541\",\"internal_id\":\"checkin-start-code-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Start Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EEnter your start code now to begin testing. Good luck!\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe start code contains \\u003Cstrong\\u003Enumbers only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-start-code-sat-wkd-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-06-21T13:11:18-04:00\\u0022\\u003E1655831478\\u003C\\/time\\u003E\\n\"},{\"id\":\"536\",\"internal_id\":\"checkin-start-code-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Start Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EEnter your start code now to begin testing. Good luck!\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe start code contains \\u003Cstrong\\u003Enumbers only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-start-code-sat-schoolday-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-06-21T13:10:23-04:00\\u0022\\u003E1655831423\\u003C\\/time\\u003E\\n\"},{\"id\":\"531\",\"internal_id\":\"checkin-start-code-ap\",\"type\":\"functional_content\",\"title\":\"Start Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EEnter your start code now to begin testing. Good luck!\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe start code contains \\u003Cstrong\\u003Enumbers only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-start-code-ap-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-06-21T13:10:52-04:00\\u0022\\u003E1655831452\\u003C\\/time\\u003E\\n\"},{\"id\":\"526\",\"internal_id\":\"checkin-room-code-sat-wkd\",\"type\":\"functional_content\",\"title\":\"On Test Day: Enter the Room Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYour proctor will give you a code. Enter it here to complete check-in.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe room code contains\\u0026nbsp;\\u003Cstrong\\u003Eletters only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-room-code-sat-wkd-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-12-14T12:03:26-05:00\\u0022\\u003E1702573406\\u003C\\/time\\u003E\\n\"},{\"id\":\"521\",\"internal_id\":\"checkin-room-code-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"On Test Day: Enter the Room Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe proctor will give you a code. Enter it here to complete check-in.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe room code contains\\u0026nbsp;\\u003Cstrong\\u003Eletters only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-room-code-sat-schoolday-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-12-14T12:00:48-05:00\\u0022\\u003E1702573248\\u003C\\/time\\u003E\\n\"},{\"id\":\"516\",\"internal_id\":\"checkin-room-code-ap\",\"type\":\"functional_content\",\"title\":\"On Test Day: Enter the Room Code\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe proctor will give you a code. Enter it here to complete check-in.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThe room code contains \\u003Cstrong\\u003Eletters only\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"id\":\"checkin-room-code-ap-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-12-14T12:02:33-05:00\\u0022\\u003E1702573353\\u003C\\/time\\u003E\\n\"},{\"id\":\"511\",\"internal_id\":\"question-menu\",\"type\":\"help_detail\",\"title\":\"Question Menu\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EAt the bottom of each testing screen, you\\u2019ll find a menu that allows you to navigate to any question in the section. You\\u2019ll see which questions you\\u2019ve answered, which you haven\\u2019t, and any that you\\u2019ve marked for review.\\u003C\\/p\\u003E\",\"offering\":\"SAT, AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-03-30T13:47:51-04:00\\u0022\\u003E1648662471\\u003C\\/time\\u003E\\n\"},{\"id\":\"506\",\"internal_id\":\"accomms-help-ap\",\"type\":\"profile_collection\",\"title\":\"Accommodations\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"276\",\"title\":\"Digital Testing Accommodations: AP Exams\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW93372691 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW93372691 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003ESome testing accommodations work differently on digital AP Exams than on the paper version of the exams. Other accommodations may not be needed for a digital AP Exam. On your personal info page, Bluebook will list only the accommodations that apply to your digital AP Exam.\\u202f\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW93372691 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW93372691 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW93372691 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019re approved for one of these accommodations, here\\u2019s how it\\u2019ll work in Bluebook.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW93372691 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAccommodation\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHow it Works in Bluebook\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtended Time\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW2781499 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll receive your approved amount of extended time in Bluebook.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW2781499 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBreaks as Needed\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW44857686 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll be able to pause the test time to take breaks as needed. The pause button appears below the timer.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW44857686 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtended Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW135138869 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYour section breaks will be twice as long as other test takers\\u2019. \\u003C\\/span\\u003E\\u003Cspan\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtra Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW111330351 BCX0 NormalTextRun CommentStart CommentHighlightPipeClickedRefresh CommentHighlightClickedRefresh\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW111330351 BCX0 NormalTextRun CommentHighlightClickedRefresh\\u0022 lang=\\u0022EN-US\\u0022\\u003E get an extra break between parts within a section (or midway through a section if there aren\\u2019t parts).\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW73975192 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E \\u003C\\/span\\u003E\\u003Cspan\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtra and Extended Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW176480585 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYour section breaks will be twice as long as other test takers\\u2019, and you\\u2019ll have extra breaks. \\u003C\\/span\\u003E\\u003Cspan\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW135038800 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EBraille (Refreshable Braille for Digital)\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW135038800 BCX0\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cp class=\\u0022Paragraph TrackedChange SCXW154984601 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW154984601 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor fully digital exams, you can use a screen reader or refreshable braille\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW154984601 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW154984601 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E If you use a screen reader, you need to use headphones, too, if \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW154984601 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Eyou\\u2019re \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW154984601 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Ein a room with other students.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW154984601 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW154984601 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW154984601 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor hybrid digital exams, you can use a screen reader or refreshable braille display for Section I and test with a human reader for Section II. If you\\u2019re approved for dictation, you can test with a human writer\\/scribe for Section II.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackedChange SCXW154984601 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun EmptyTextRun SCXW154984601 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP TrackedChange SCXW154984601 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBraille Writer\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cp class=\\u0022Paragraph TrackedChange SCXW48904616 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW48904616 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor fully digital exams, you\\u2019ll use braille writing software or you can connect an electronic braille writer to your device.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW48904616 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph TrackedChange SCXW48904616 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW48904616 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor hybrid digital exams, contact the College Board SSD office as soon as possible before the start of the 2025 AP Exam administration for guidance about the testing options available.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW48904616 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ELarge-Print Exam or \\u003C\\/strong\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW221440959 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EMagnification Device (Electronic\\/Non-Electronic)\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW221440959 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can zoom using your device\\u2019s native controls (Control +\\/- on a PC; Command +\\/- on a Mac; pinch and zoom on an iPad).\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EColor Overlay\\/Color Contrast\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use the color settings available through your operating system and\\/or device screen, or you can use a plastic overlay attached to your device\\u0027s screen.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHuman Reader for Digital Tests\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW202694189 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll need to be approved for this accommodation before the start of the 2025 AP Exam administration in order to have a human reader assist you on a fully digital or hybrid digital exam.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW202694189 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EScreen Reader (Embedded)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW196372449 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use the screen reader available through your device\\u0027s operating system or any College Board approved screen reader software (JAWS, NVDA, etc.). In addition to reading all text (reading passages, math problems and equations, and multiple-choice response questions\\/answers), your screen reader will also read all properties of the page (headers, footers, punctuation) and provide detailed descriptions of graphs and figures. And you\\u2019ll get up to time and one-half (+50%) on your test.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW196372449 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Embedded)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW144616270 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use the text-to-speech in Bluebook to read all text (reading passages, math problems and equations, and multiple-choice response questions\\/answers) and short descriptions of graphics.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW144616270 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EDictation for Digital Exams\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW56582324 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use speech-to-text functionality through your device or software. \\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW56582324 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAssistive Technology (AT)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use your approved assistive technology software.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003E4-Function Calculator\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW159617190 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EOnly available as an accommodation for\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackedChange SCXW159617190 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E AP Calculus AB, Calculus BC, Computer\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW159617190 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackedChange SCXW159617190 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EScience A, Computer Science Principles, and Precalculus\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW159617190 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E, and must be an approved handheld calculator.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW159617190 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ELimited Time\\/Multiple Day Testing\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW17055019 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf the test time exceeds your approved time, you will test over multiple days and\\/or for a limited amount of time per day.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW17055019 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAuditory Amplification\\/FM System\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW79806674 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW79806674 BCX0 NormalTextRun ContextualSpellingAndGrammarErrorV2Themed\\u0022 lang=\\u0022EN-US\\u0022\\u003Etest\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW79806674 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E with your FM system.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"741\",\"title\":\"Find Your Approved Accommodations\\u00a0\",\"body\":\"\\u003Cp\\u003EIf you have a College Board\\u2013approved accommodation, you should\\u2019ve received a letter from our SSD office (\\u201cSSD\\u201d stands for Services for Students with Disabilities). For more information, visit \\u003Cstrong\\u003Eaccommodations.collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"746\",\"title\":\"How to Apply for an Accommodation\",\"body\":\"\\u003Cp\\u003EFor most accommodations, the easiest thing to do is to have your school\\u2019s SSD coordinator apply for the accommodation on your behalf. (\\u201cSSD\\u201d stands for Services for Students with Disabilities.) If you\\u2019re not sure who the SSD coordinator is at your school, ask your counselor. For more information, visit \\u003Cstrong\\u003Eaccommodations.collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"751\",\"title\":\"Selecting Accommodations for Practice Tests\",\"body\":\"\\u003Cp\\u003EYou\\u2019re encouraged to apply accommodations to your full-length practice test so you can get a feel for how accommodations work with digital exams. But selecting accommodations on a practice test does not mean those accommodations will be applied to your actual test. On test day, only College Board\\u2013approved accommodations will be applied to your digital exam.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"277\",\"title\":\"Assistive Technology\",\"body\":\"\\u003Cp\\u003EAny approved assistive technology that you use when you\\u2019re online should still work during your exam. If you use assistive technologies (AT), such as screen readers (JAWS, NVDA, VoiceOver, ChromeVox, ZoomText Fusion, etc.) to interact with a standard web browser, the same commands can be used to navigate through content in the digital exam. The exception to this would be if you use a web-based assistive technology or a browser extension.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you use assistive technology, open\\/start the AT device or software before\\u003Cstrong\\u003E \\u003C\\/strong\\u003Eyou open Bluebook for practice and on exam day. On exam day, adjust any necessary settings before you start to check in for the digital exam. Exceptions are noted when configuration is not required ahead of the exam.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"1031\",\"title\":\"Zoom and Magnification\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Zoom and Magnification\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use the\\u0026nbsp;magnification\\u0026nbsp;feature, select the options from the floating accessibility menu:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull-screen magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + M\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 whole-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAdjust the full-screen magnifier from the floating\\u0026nbsp;\\u003Cstrong\\u003EAccessibility menu\\u0026nbsp;\\u0026gt;\\u0026nbsp;Settings\\u0026nbsp;\\u0026gt;\\u0026nbsp;Display and magnification\\u0026nbsp;\\u0026gt;\\u0026nbsp;Full screen magnifier\\u0026nbsp;\\u0026gt;\\u003C\\/strong\\u003E select any of these options:\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen continuously as mouse moves\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen keeping mouse at center of screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen when mouse touches edge of screen (default)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + D\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 split-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo adjust zoom level, select the down arrow in the\\u0026nbsp;\\u003Cstrong\\u003EDocked zoom level\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo change what\\u2019s magnified, move your pointer or press\\u0026nbsp;\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Zoom and Magnifier\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Magnifier: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 10:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fMagnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 11:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fAccessibility\\u0026nbsp;\\u0026gt;\\u202fVision:\\u0026nbsp;Magnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EOr press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fplus sign (+)\\u003C\\/strong\\u003E. To turn off the Magnifier, press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fEsc\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust the\\u0026nbsp;Magnifier view per your preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ELens\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fL\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fF\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fD\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003ECommand +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003ECommand +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo customize how the zoom area appears, go to\\u202f\\u003Cstrong\\u003EApple menu\\u202f\\u0026gt;\\u202fSystem Settings \\u0026gt;\\u202fAccessibility\\u003C\\/strong\\u003E\\u0026nbsp;and click\\u0026nbsp;\\u003Cstrong\\u003EZoom\\u202fon the right (keyboard shortcut:\\u202fOption\\u202f+\\u202fCommand\\u202f+\\u202f8)\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIn the Advanced Options, select the checkboxes for your zoom preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse keyboard shortcuts to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse trackpad gesture to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse scroll gesture with modifier keys to zoom\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ESelect\\u202fZoom\\u202fstyle\\u0026nbsp;options per student preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ESplit screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EPicture-in-picture\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPinch to zoom in or zoom out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor additional zoom options in the iPad, tap\\u202f\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fZoom\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust any of the following:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcuts:\\u0026nbsp;Control zoom using shortcuts on an external keyboard.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom controller:\\u202fTurn the controller on, set controller actions, and adjust the color and opacity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom region:\\u202fChoose Pinned Zoom, Full Screen Zoom, or Window Zoom.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom filters:\\u202fChoose None, Inverted, Grayscale, Grayscale Inverted, or Low Light.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMaximum zoom level:\\u202fDrag the slider to adjust the level.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\",\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"501\",\"title\":\"Verbal Instructions: Fully Digital\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003ENote: These instructions may vary slightly from what the proctor reads.\\u003C\\/em\\u003E]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will read this aloud:\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWelcome. If you\\u0026nbsp;haven\\u2019t\\u0026nbsp;completed check-in yet, pause while I read. You can finish checking in later.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EToday\\u0026nbsp;you\\u2019re\\u0026nbsp;taking a digital AP Exam.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ERemember, you agreed to follow rules preventing students from having an unfair advantage. I will dismiss anyone who tries to break those rules, and their scores will be canceled. They may also be prevented from taking College Board exams in the future.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science Principles, Computer Science A, and Environmental Science only:\\u0026nbsp;\\u003C\\/em\\u003EMake sure the subject listed on your printed reference booklet cover\\u0026nbsp;matches the title of\\u0026nbsp;the exam\\u0026nbsp;you\\u2019re\\u0026nbsp;taking.\\u0026nbsp;Write your name\\u0026nbsp;in the space provided on the cover of the\\u0026nbsp;booklet, and\\u0026nbsp;write the date next to your name.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDuring the exam, you may\\u0026nbsp;use the margins or any blank space in the reference information booklet for scratch work.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll\\u0026nbsp;come around\\u0026nbsp;soon\\u0026nbsp;to make sure you cleared your desk as instructed in Bluebook.\\u0026nbsp;If you still have any prohibited items, turn them off,\\u0026nbsp;and put them on your desk so I can collect them.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou should have 2 sheets of scratch paper, which\\u0026nbsp;I\\u2019ll\\u0026nbsp;collect after the exam.\\u0026nbsp;Write your full name, today\\u2019s date, and the exam name in the top right corner on both sheets.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science Principles only:\\u0026nbsp;\\u003C\\/em\\u003ENow check your Personalized Project Reference if you\\u0026nbsp;haven\\u2019t\\u0026nbsp;already. Make sure\\u0026nbsp;it\\u2019s\\u0026nbsp;yours, legible, and no pages are missing. Then place it under your desk until\\u0026nbsp;your\\u0026nbsp;break. If\\u0026nbsp;there\\u2019s\\u0026nbsp;a problem with it, let me know when\\u0026nbsp;I\\u2019m\\u0026nbsp;at your desk.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Environmental Science\\u0026nbsp;and Networking\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EIf you brought a calculator, put it on your desk so I can check it.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you still have any prohibited items, turn them off and put them on your desk so I can collect them.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor checks student desks,\\u0026nbsp;they\\u2019ll\\u0026nbsp;read this:\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease give me your attention again.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EBluebook will end Section I and start your break automatically.\\u0026nbsp;You might start your break at slightly different times than your neighbor, so please be quiet at all times.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science A only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts, place your scratch paper and reference booklet on your desk.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor\\u0026nbsp;Computer Science Principles\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts, place your Personalized Project Reference, scratch paper, and reference booklet\\u0026nbsp;on your desk,\\u0026nbsp;and keep\\u0026nbsp;them\\u0026nbsp;there until I collect\\u0026nbsp;them\\u0026nbsp;at the end of the exam.\\u0026nbsp;Don\\u2019t\\u0026nbsp;take it out of this room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor\\u0026nbsp;Environmental Science\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;calculator, scratch paper, and reference booklet\\u0026nbsp;on your desk.\\u0026nbsp;Leave your calculator on your desk any time you leave the room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Networking only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;calculator and scratch paper\\u0026nbsp;on your desk.\\u0026nbsp;Leave your calculator on your desk any time you leave the room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E[\\u003C\\/span\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor Seminar only:\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EThis exam has one section and there is no scheduled break.]\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW173149167 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;scratch paper\\u0026nbsp;on your desk.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your break is over, click the button to start Section II\\u2014don\\u2019t\\u0026nbsp;wait for me to tell you to.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo take an unscheduled break, go to the\\u0026nbsp;\\u003Cstrong\\u003EMore\\u003C\\/strong\\u003E\\u0026nbsp;menu and click\\u0026nbsp;\\u003Cstrong\\u003EUnscheduled Break\\u003C\\/strong\\u003E. Raise your hand and wait for me to dismiss you if you want to leave the room. You will lose testing time if you take an unscheduled break.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have an approved accommodation for breaks as needed, select\\u0026nbsp;\\u003Cstrong\\u003EPause\\u003C\\/strong\\u003E\\u0026nbsp;under the timer so you\\u0026nbsp;don\\u2019t\\u0026nbsp;lose testing time.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor pauses to answer questions,\\u0026nbsp;they\\u2019ll\\u0026nbsp;read this:\\u202f\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll give you the start code after I read these final instructions.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you see the low-battery warning on your screen, raise your hand so I can help you.\\u0026nbsp;Keep your laptop open or your tablet uncovered until I dismiss you.\\u0026nbsp;I\\u2019ve\\u0026nbsp;written a reminder here.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your exam ends, sit quietly until I make sure your answers are\\u0026nbsp;submitted. Remember that others may still be testing.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ERaise your hand if you need help or more scratch paper at any time. Are there any questions?\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen you enter the code and click\\u0026nbsp;\\u003Cstrong\\u003EStart Test\\u003C\\/strong\\u003E, your timer will start and you can begin testing.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you\\u0026nbsp;don\\u2019t see\\u0026nbsp;the start code screen yet, finish checking in.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll\\u0026nbsp;read the start code now and write it on the board. Good luck!\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"279\",\"title\":\"Link to Referenced Content\",\"body\":\"\\u003Cp\\u003EOn questions that refer to a specific section of the stimulus content, this symbol \\u003Cstrong\\u003E\\u0026gt;\\u0026gt;\\u003C\\/strong\\u003E will display after the reference. \\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EIf you\\u2019re using a screen reader and you navigate to \\u201clink to referenced content,\\u201d the referenced content will be read to you.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E \\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E For all users, if you scroll past the referenced content and you click on this symbol, the passage will scroll back so the referenced content is at the top of your screen.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"299\",\"title\":\"Screen Magnification\",\"body\":\"\\u003Cp\\u003EScreen magnification technology enlarges the content displayed on the computer screen in order to assist students with visual impairments. Although the exam app supports some non-embedded screen magnifier tools from third parties, all users can zoom using their device\\u2019s native controls (Control +\\/- on a PC; Command +\\/- on a Mac; pinch and zoom on an iPad).\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"290\",\"title\":\"Text-to-Speech\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019re approved for the accommodation \\u201cText-to-Speech (Embedded),\\u201d then a built-in text-to-speech (TTS) tool will be available whenever you test with Bluebook. You don\\u2019t need to do anything to configure this tool.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EUse the \\u003Cstrong\\u003EPlay\\/Pause \\u003C\\/strong\\u003Ebutton to hear entire passages or engage \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EClick Mode \\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Eto hear specific sentences.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can adjust voice selection, speed, or volume of the playback.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun MacChromeBold NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u0027re testing\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E on a Mac or iPad and you\\u0027re approved for embedded text-to-speech, you can now choose from any \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun ContextualSpellingAndGrammarErrorV2Themed CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003Evoices\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E previously downloaded to the device in addition to standard Bluebook options.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"289\",\"title\":\"Speech-to-Text\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Dictation\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChromebook provides two options for using the dictation feature for items requiring text entry: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003EDictation:\\u003C\\/em\\u003E\\u0026nbsp;From the floating accessibility menu, select \\u003Cstrong\\u003EDictation\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003ESpeak with the onscreen keyboard:\\u0026nbsp;\\u003C\\/em\\u003EFrom the floating accessibility menu select \\u003Cstrong\\u003EOnscreen keyboard\\u003C\\/strong\\u003E. At the top of the onscreen keyboard, select\\u0026nbsp;\\u003Cstrong\\u003ESpeak\\u003C\\/strong\\u003E\\u0026nbsp;(microphone).\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EYou can move, float, dock, and resize the onscreen keyboard.\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003ETap or select where you want to type (input field, free-response questions, essays, etc.). Press\\u202f\\u003Cstrong\\u003ESearch\\u202f+\\u202fD\\u003C\\/strong\\u003E\\u0026nbsp;or \\u202f\\u003Cstrong\\u003ELauncher\\u202f+\\u202fD\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Speech\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Speech, follow the steps below for your operating system:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 10:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fSpeech Recognition\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 11:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fVoice Access\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcut: Press\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fCtrl\\u202f+\\u202fS\\u202f\\u003C\\/strong\\u003Eto turn on speech recognition.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;For Windows 10 or 11, to help with navigation and selecting elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it\\u202f(e.g.,\\u0026nbsp;\\u201c19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use\\u0026nbsp;Voice Control\\u0026nbsp;on a Mac, go to \\u003Cstrong\\u003ESystem Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u0026nbsp;\\u003C\\/em\\u003ETo help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ERecommended:\\u003C\\/em\\u003E Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Voice Control Guide \\u0026gt; Open Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using\\u0026nbsp;Voice Control\\u0026nbsp;on an iPad, go to\\u0026nbsp;\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;To help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ERecommended: Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Open Voice Control Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"278\",\"title\":\"Screen Readers\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook ChromeVox\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo enable ChromeVox, press \\u003Cstrong\\u003ECtrl\\u0026nbsp;+\\u0026nbsp;Alt\\u0026nbsp;+\\u0026nbsp;Z\\u003C\\/strong\\u003E or select it from the floating accessibility menu.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003ENote: \\u003C\\/strong\\u003EIf you\\u0027re approved to use a screen reader and you don\\u0027t see the floating accessibility menu on your Chromebook, let someone at your school know right away.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIf ChromeVox turns off when you launch the Bluebook app or at any time, you can turn it back on with \\u003Cstrong\\u003ECtrl + Alt + Z\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETest content can be navigated with the keyboard. Depending on your keyboard, you can press the \\u003Cstrong\\u003ESearch\\u0026nbsp;\\u003C\\/strong\\u003Eor \\u003Cstrong\\u003ELauncher\\u003C\\/strong\\u003E key for some shortcuts. Both keys work the same way.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation: \\u003C\\/strong\\u003EUse the keyboard shortcuts if parts of the content are not initially reading.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead items on a page\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + right arrow (or left arrow to move back)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EGo to the next\\/previous line\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + up\\/down arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading from the current location\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Narrator\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start or stop Narrator, press the \\u003Cstrong\\u003EWindows logo key + Ctrl + Enter\\u003C\\/strong\\u003E together.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EImportant:\\u0026nbsp;\\u003C\\/strong\\u003EThe Narrator key is a modifier key in the Narrator commands. Both the \\u003Cstrong\\u003ECaps Lock\\u003C\\/strong\\u003E and \\u003Cstrong\\u003EInsert\\u003C\\/strong\\u003E keys are the Narrator key by default. The Narrator key is referred to as \\u201cNarrator\\u201d in commands.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart or stop Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003EWindows logo key + Ctrl + Enter\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EExit Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + Esc\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the next item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + right arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the previous item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + down arrow or Narrator + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChoose \\u003Cstrong\\u003EApple\\u003C\\/strong\\u003E menu \\u0026gt; \\u003Cstrong\\u003ESystem Settings\\u003C\\/strong\\u003E, then click \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E in the sidebar. Click \\u003Cstrong\\u003EVoiceOver on\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPress \\u003Cstrong\\u003ECommand + F5\\u003C\\/strong\\u003E with the keyboard to turn VoiceOver on\\/off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E VO is an abbreviation for VoiceOver keys \\u003Cstrong\\u003EControl + Option\\u003C\\/strong\\u003E.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Command\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ETurn the screen reader on\\/off\\u003C\\/td\\u003E\\u003Ctd\\u003ECommand + F5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead next\\/previous item\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + right arrow\\/left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead the next focusable item (e.g., link, button)\\u003C\\/td\\u003E\\u003Ctd\\u003ETab\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously from this point on\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + A\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver: Go to \\u003Cstrong\\u003ESettings\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EVoiceOver\\u003C\\/strong\\u003E, then on or off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EiPad Only: \\u003C\\/strong\\u003ENavigating Multiple-Choice Answer Options\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard-only users can navigate to a\\u202fradio\\u202fbutton option with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMore radio button options can be accessed with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey and the\\u202f\\u003Cstrong\\u003Espacebar\\u003C\\/strong\\u003E to make an explicit selection.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAlternatively, keyboard-only users can navigate through multiple-choice options with\\u202f\\u003Cstrong\\u003EOption\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys or\\u202f\\u003Cstrong\\u003EControl\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"297\",\"title\":\"Refreshable Braille Displays\",\"body\":\"\\u003Cp\\u003ERBDs are used to read text-only content on digital exams. Alternative text descriptions are embedded in the exams for all graphics. RBDs must be properly set up before they can be used by students. For information about installing and setting up RBDs, refer to the product\\u2019s provided instructions and manuals.\\u003C\\/p\\u003E\\u003Cp\\u003ERefreshable braille is not recommended for students that require tactile graphics. Students can request a braille exam or raised line drawings.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-04-18T11:28:56-04:00\\u0022\\u003E1681831736\\u003C\\/time\\u003E\\n\"},{\"id\":\"501\",\"internal_id\":\"proctor-instrux-ap\",\"type\":\"help_detail\",\"title\":\"Verbal Instructions: Fully Digital\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003ENote: These instructions may vary slightly from what the proctor reads.\\u003C\\/em\\u003E]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will read this aloud:\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWelcome. If you\\u0026nbsp;haven\\u2019t\\u0026nbsp;completed check-in yet, pause while I read. You can finish checking in later.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EToday\\u0026nbsp;you\\u2019re\\u0026nbsp;taking a digital AP Exam.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ERemember, you agreed to follow rules preventing students from having an unfair advantage. I will dismiss anyone who tries to break those rules, and their scores will be canceled. They may also be prevented from taking College Board exams in the future.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science Principles, Computer Science A, and Environmental Science only:\\u0026nbsp;\\u003C\\/em\\u003EMake sure the subject listed on your printed reference booklet cover\\u0026nbsp;matches the title of\\u0026nbsp;the exam\\u0026nbsp;you\\u2019re\\u0026nbsp;taking.\\u0026nbsp;Write your name\\u0026nbsp;in the space provided on the cover of the\\u0026nbsp;booklet, and\\u0026nbsp;write the date next to your name.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDuring the exam, you may\\u0026nbsp;use the margins or any blank space in the reference information booklet for scratch work.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll\\u0026nbsp;come around\\u0026nbsp;soon\\u0026nbsp;to make sure you cleared your desk as instructed in Bluebook.\\u0026nbsp;If you still have any prohibited items, turn them off,\\u0026nbsp;and put them on your desk so I can collect them.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou should have 2 sheets of scratch paper, which\\u0026nbsp;I\\u2019ll\\u0026nbsp;collect after the exam.\\u0026nbsp;Write your full name, today\\u2019s date, and the exam name in the top right corner on both sheets.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science Principles only:\\u0026nbsp;\\u003C\\/em\\u003ENow check your Personalized Project Reference if you\\u0026nbsp;haven\\u2019t\\u0026nbsp;already. Make sure\\u0026nbsp;it\\u2019s\\u0026nbsp;yours, legible, and no pages are missing. Then place it under your desk until\\u0026nbsp;your\\u0026nbsp;break. If\\u0026nbsp;there\\u2019s\\u0026nbsp;a problem with it, let me know when\\u0026nbsp;I\\u2019m\\u0026nbsp;at your desk.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Environmental Science\\u0026nbsp;and Networking\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EIf you brought a calculator, put it on your desk so I can check it.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you still have any prohibited items, turn them off and put them on your desk so I can collect them.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor checks student desks,\\u0026nbsp;they\\u2019ll\\u0026nbsp;read this:\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease give me your attention again.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EBluebook will end Section I and start your break automatically.\\u0026nbsp;You might start your break at slightly different times than your neighbor, so please be quiet at all times.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Computer Science A only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts, place your scratch paper and reference booklet on your desk.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor\\u0026nbsp;Computer Science Principles\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts, place your Personalized Project Reference, scratch paper, and reference booklet\\u0026nbsp;on your desk,\\u0026nbsp;and keep\\u0026nbsp;them\\u0026nbsp;there until I collect\\u0026nbsp;them\\u0026nbsp;at the end of the exam.\\u0026nbsp;Don\\u2019t\\u0026nbsp;take it out of this room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor\\u0026nbsp;Environmental Science\\u0026nbsp;only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;calculator, scratch paper, and reference booklet\\u0026nbsp;on your desk.\\u0026nbsp;Leave your calculator on your desk any time you leave the room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E[\\u003Cem\\u003EFor Networking only:\\u0026nbsp;\\u003C\\/em\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;calculator and scratch paper\\u0026nbsp;on your desk.\\u0026nbsp;Leave your calculator on your desk any time you leave the room.]\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E[\\u003C\\/span\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor Seminar only:\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW173149167 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EThis exam has one section and there is no scheduled break.]\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW173149167 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your break starts,\\u0026nbsp;place your\\u0026nbsp;scratch paper\\u0026nbsp;on your desk.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your break is over, click the button to start Section II\\u2014don\\u2019t\\u0026nbsp;wait for me to tell you to.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo take an unscheduled break, go to the\\u0026nbsp;\\u003Cstrong\\u003EMore\\u003C\\/strong\\u003E\\u0026nbsp;menu and click\\u0026nbsp;\\u003Cstrong\\u003EUnscheduled Break\\u003C\\/strong\\u003E. Raise your hand and wait for me to dismiss you if you want to leave the room. You will lose testing time if you take an unscheduled break.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have an approved accommodation for breaks as needed, select\\u0026nbsp;\\u003Cstrong\\u003EPause\\u003C\\/strong\\u003E\\u0026nbsp;under the timer so you\\u0026nbsp;don\\u2019t\\u0026nbsp;lose testing time.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor pauses to answer questions,\\u0026nbsp;they\\u2019ll\\u0026nbsp;read this:\\u202f\\u202f\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll give you the start code after I read these final instructions.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you see the low-battery warning on your screen, raise your hand so I can help you.\\u0026nbsp;Keep your laptop open or your tablet uncovered until I dismiss you.\\u0026nbsp;I\\u2019ve\\u0026nbsp;written a reminder here.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen your exam ends, sit quietly until I make sure your answers are\\u0026nbsp;submitted. Remember that others may still be testing.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ERaise your hand if you need help or more scratch paper at any time. Are there any questions?\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhen you enter the code and click\\u0026nbsp;\\u003Cstrong\\u003EStart Test\\u003C\\/strong\\u003E, your timer will start and you can begin testing.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you\\u0026nbsp;don\\u2019t see\\u0026nbsp;the start code screen yet, finish checking in.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EI\\u2019ll\\u0026nbsp;read the start code now and write it on the board. Good luck!\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-11T17:58:52-04:00\\u0022\\u003E1773266332\\u003C\\/time\\u003E\\n\"},{\"id\":\"496\",\"internal_id\":\"proctor-instrux-sat-schoolday\",\"type\":\"help_detail\",\"title\":\"Verbal Instructions\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will read this aloud:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun EmptyTextRun SCXW59790163 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EWelcome. Today you\\u2019re taking the SAT, an important step toward your college and career goals.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EPlease listen carefully to these instructions. When I finish, I\\u2019ll give you the start code. If you haven\\u2019t completed check-in yet, pause while I read. You can finish checking in later.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019d like to follow along as I read these instructions, click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EReview the Instructions\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E. If you\\u2019re not on the start code screen yet, click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EHelp\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E and then \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EVerbal Instructions\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou agreed to follow the rules and keep test content confidential. I will dismiss anyone who tries to break the rules, and their scores will be canceled. They may also be prevented from taking College Board tests in the future.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EBluebook should be the only application open on your device unless you\\u2019re using approved assistive technology. Other open applications will be detected and could result in score cancellation.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EClose all other applications now. Does anyone need to close other applications?\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will pause so you can close any other applications, then they\\u2019ll read this:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EBluebook times everyone individually and will tell you when it\\u2019s time to take your break. You might start your break at slightly different times than your neighbor, so please be quiet at all times.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003ETo take a break at any other time, go to the \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EMore \\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Emenu and click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EUnscheduled Break\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E. You will lose testing time if you take an unscheduled break.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you have an approved accommodation for breaks as needed, select \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EPause\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E under the timer instead so you don\\u2019t lose testing time.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll come around soon to make sure you cleared your desk as instructed in Bluebook. I\\u2019ll also give you any materials related to your accommodations. And if you brought a calculator, I\\u2019ll make sure it\\u2019s acceptable.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you have phones, smartwatches, or other prohibited devices, turn them off now.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou should have 1 sheet of scratch paper, which I\\u2019ll collect after the test so don\\u2019t tear it. Write your full name in the top right corner. If you don\\u2019t have one, let me know when I come by your desk.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EIf students in your room are approved for certain accommodations, you\\u0027ll hear additional instructions:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor students testing with a screen reader: \\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019re using text-to-speech, a screen reader, or other approved assistive technology, now is the time to make sure it\\u2019s working. Remember, you can use the built-in features on your device. More information is available on the Bluebook \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EHelp\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E page.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor students testing with a human reader:\\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E Readers must read questions aloud as often as requested. It\\u2019s important that they read only exactly what is in the script. They must not elaborate, even if the student asks.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor students testing with a scribe: \\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EScribes must write only the answers and corrections that students dictate. They can\\u2019t prompt the student in a way that would result in a different response. Scribes will read student answers back to them if students want to review their work.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EFor students testing with raised line drawings:\\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E The raised line drawings have the same labels and numbers as the detailed descriptions you\\u2019ll hear.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EThen your proctor will read this:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EPlease pay attention to these final instructions.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EDon\\u2019t leave until I confirm your answers are submitted and dismiss you. Don\\u2019t close your laptop or cover your tablet before then. I\\u2019ve posted a reminder here.\\u003C\\/span\\u003E\\u003Cem\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E \\u003C\\/span\\u003E\\u003C\\/em\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll receive official scores you can use to apply to college. If you want to cancel your scores, let me know in the next 5 days.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you need help or extra scratch paper at any time, raise your hand and I\\u2019ll come over. Remember to write your full name on extra scratch paper.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EDoes anyone have any questions?\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will answer any final questions, then they\\u2019ll read this:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll give you the start code in a moment. When you enter the code and click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EStart Test\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E, your timer will start and you can begin testing.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you don\\u2019t see the start code screen yet, finish checking in.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW59790163 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW59790163 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll read the start code now and write it on the board. Good luck!\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW59790163 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-01-24T11:24:23-05:00\\u0022\\u003E1737735863\\u003C\\/time\\u003E\\n\"},{\"id\":\"491\",\"internal_id\":\"proctor-instrux-sat-weekend\",\"type\":\"help_detail\",\"title\":\"Verbal Instructions\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EYour proctor will read this aloud:\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EWelcome. Today you\\u2019re taking the SAT, an important step toward your college and career goals.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EPlease listen carefully to these instructions. When I finish, I\\u2019ll give you the start code. If you haven\\u2019t completed check-in yet, pause while I read. You can finish checking in later.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019d like to follow along as I read these instructions, click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EHelp\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E and then \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EVerbal Instructions\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou agreed to follow the rules and keep test content confidential.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI will dismiss anyone who tries to break the rules, and their scores will be canceled. They may also be prevented from taking College Board tests in the future.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EBluebook should be the only application open on your device unless you\\u2019re using approved assistive technology. Other applications will be detected and could result in score cancellation.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EClose all other applications now.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EDoes anyone need more time to close other applications?\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EThe proctor will pause while you close all other applications, then they\\u2019ll read this:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EBluebook times everyone individually, and it will tell you when it\\u2019s time to take your break. You might start your break at slightly different times than your neighbor, so please be quiet at all times.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003ETo take a break at any other time, go to the \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EMore\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E menu and click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EUnscheduled Break\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E. You will lose testing time if you take an unscheduled break.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you have an approved accommodation for breaks as needed, select \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EPause\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E instead so you don\\u2019t lose testing time.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll receive official scores that you can use to apply to college. If you want to cancel your scores, you go to \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003Ecollegeboard.org\\/\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun SpellingErrorV2Themed\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003Emysat\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003E \\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Ewithin 1 week from today.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll come around soon to collect prohibited items and make sure you cleared your desk as instructed in Bluebook. If you brought a calculator, I\\u2019ll make sure it\\u2019s acceptable.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EKeep your photo ID on your desk. If you leave the room, bring it with you. If you have phones, smartwatches, or other prohibited devices, turn them off before I collect them. You should have 1 sheet of scratch paper, which I\\u2019ll collect after the test. Write your full name \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun ContextualSpellingAndGrammarErrorV2Themed\\u0022 lang=\\u0022EN-US\\u0022\\u003Eat\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E the top right corner. If you don\\u2019t have one, let me know when I \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun ContextualSpellingAndGrammarErrorV2Themed\\u0022 lang=\\u0022EN-US\\u0022\\u003Ecome\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E by your desk.\\u0026nbsp;\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor checks student desks, they\\u2019ll read this:\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EPlease pay attention to these final instructions.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EWhen the test ends, raise your hand and I\\u2019ll confirm your answers are submitted and dismiss you. Don\\u2019t leave, close your laptop, or cover your tablet before then. I\\u2019ve posted a reminder here.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you need help or extra scratch paper at any time, raise your hand and I\\u2019ll come over. Remember to write your full name on extra scratch paper.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EDoes anyone have any questions?\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EAfter your proctor pauses to answer questions, they\\u2019ll read this:\\u0026nbsp;\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun EmptyTextRun SCXW41958884 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022LineBreakBlob BlobObject DragDrop SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll give you a start code in a moment. When you enter the code and click \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EStart Test\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E, your timer will \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun ContextualSpellingAndGrammarErrorV2Themed\\u0022 lang=\\u0022EN-US\\u0022\\u003Estart\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E and you can begin testing.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you don\\u2019t see the start code screen yet, finish checking in.\\u0026nbsp;\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW41958884 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW41958884 BCX0\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW41958884 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EI\\u2019ll read the start code now and write it on the board. Good luck!\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-01-24T11:23:24-05:00\\u0022\\u003E1737735804\\u003C\\/time\\u003E\\n\"},{\"id\":\"486\",\"internal_id\":\"mark-for-review\",\"type\":\"help_detail\",\"title\":\"Mark for Review\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cimg src=\\u0022data:image\\/svg+xml;base64, \\u0022 alt=\\u0022\\u0022 \\/\\u003E \\u003Cstrong\\u003EMark for Review\\u003C\\/strong\\u003E: Flag any question you want to come back to later.\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-12-04T13:49:13-05:00\\u0022\\u003E1701715753\\u003C\\/time\\u003E\\n\"},{\"id\":\"481\",\"internal_id\":\"device-requirements-sat-weekend\",\"type\":\"help_detail\",\"title\":\"Device Requirements\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cspan\\u003EYou can run Bluebook on a Windows or Mac device, an iPad, or a school-managed Chromebook.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cspan\\u003EFor detailed requirements, go to \\u003Cstrong\\u003Ebluebook.org\\/student-devices\\u003C\\/strong\\u003E.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-10-03T10:37:11-04:00\\u0022\\u003E1727966231\\u003C\\/time\\u003E\\n\"},{\"id\":\"476\",\"internal_id\":\"device-requirements-sat-schoolday\",\"type\":\"help_detail\",\"title\":\"Device Requirements\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cspan\\u003EYou can run Bluebook on a Windows or Mac device, an iPad, or a school-managed Chromebook.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cspan\\u003EFor detailed requirements, go to \\u003Cstrong\\u003Ebluebook.org\\/student-devices\\u003C\\/strong\\u003E.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-10-03T10:37:33-04:00\\u0022\\u003E1727966253\\u003C\\/time\\u003E\\n\"},{\"id\":\"471\",\"internal_id\":\"approved-calcs-sat\",\"type\":\"help_detail\",\"title\":\"Approved Calculators\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EAcceptable Calculators\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003ECalculators permitted during testing include:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EThe Desmos calculator embedded in the Bluebook testing app:\\u0026nbsp;This is a powerful calculator that includes features similar to a handheld graphing calculator. If you are familiar with how to use this calculator, the embedded version is a good choice.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EGraphing calculators that do not include CAS features:\\u0026nbsp;This type of calculator includes plotting and graphing windows, data entry and storage windows, data analysis functions, trig functions, and programming options.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EScientific calculators:\\u0026nbsp;This type of calculator includes many functions helpful for solving problems in science, statistics, and math. Common features include built-in memory to store interim calculations, statistical functions, pi, trig functions, and scientific notation.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFour-function basic calculators (not recommended):\\u0026nbsp;This type of calculator includes four functions: add, subtract, multiply, and divide; some also include percentages and square roots. This type of calculator is not recommended as they typically do not follow order of operations.\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EProhibited Calculators\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003ECalculators with the following features are prohibited:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with built-in CAS functionality. Examples of such devices include:\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECasio: ClassPad 300, 330, or 400; ClassPad II (fx-CP400); ClassPad fx-CG 500 or fx-CG500; Algebra fx 2.0; all model numbers that begin with CFX-9970G.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EHewlett Packard: HP Prime; HP 48GII; all model numbers that begin with 40G, 49G, or 50G.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETexas Instruments: TI-Nspire CAS, TI-Nspire CX II CAS; All model numbers that begin with TI-89 or TI-92 or have \\u0022CAS\\u0022 in the model name. Note that TI-Nspire models that do not include \\u0022CAS\\u0022 in the name are acceptable.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with apps, menus, or programs that perform symbolic algebra manipulation (e.g., solving algebra equations symbolically).\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with QWERTY keyboards.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDevices with wireless internet capability, Bluetooth, or cellular connectivity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDevices with built-in cameras or audio\\/video recording.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETablets and laptop computers.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EElectronic writing pads or pen-input devices.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECell phone calculator apps.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators that use paper tape.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-07-31T10:39:32-04:00\\u0022\\u003E1753972772\\u003C\\/time\\u003E\\n\"},{\"id\":\"466\",\"internal_id\":\"ready-proctor-ap\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour proctor will collect these items:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ESmart glasses, a smartphone, smartwatch, \\u003C\\/strong\\u003Eor any other connected device.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-smart-glasses\",\"id\":\"ready-proctor-ap-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ENotes, books, or any other reference materials\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-no-notes\",\"id\":\"ready-proctor-ap-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EOther devices. \\u003C\\/strong\\u003EAny camera, recording device, or timer.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-phone\",\"id\":\"ready-proctor-ap-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-13T16:09:24-04:00\\u0022\\u003E1773432564\\u003C\\/time\\u003E\\n\"},{\"id\":\"461\",\"internal_id\":\"ready-under-desk-ap\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items under your desk:\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPower cord\\/portable charger. \\u003C\\/strong\\u003EBut if you need to plug in during testing, you may.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-power-cord\",\"id\":\"ready-under-desk-ap-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EHeadphones or earbuds\\u003C\\/strong\\u003E unless you have an approved accommodation.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-headphones\",\"id\":\"ready-under-desk-ap-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EFree-response booklet. \\u003C\\/strong\\u003EIf you\\u0027re taking a hybrid AP Exam, you\\u0027ll use this booklet for Section II.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-notes\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-09-22T13:47:08-04:00\\u0022\\u003E1758563228\\u003C\\/time\\u003E\\n\"},{\"id\":\"456\",\"internal_id\":\"ready-on-desk-ap\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items on your desk:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour testing device\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-laptop\",\"id\":\"ready-on-desk-ap-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EAn external mouse or keyboard. \\u003C\\/strong\\u003EYou can use an external keyboard with a tablet\\u2014not with a laptop.\\u0026nbsp;\\u003C\\/p\\u003E\",\"icon\":\"ico-mouse\",\"id\":\"ready-on-desk-ap-p3\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EA non-mechanical pencil or a pen that uses black or dark blue ink\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-pencil-pen\",\"id\":\"ready-on-desk-ap-p4\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EThe scratch paper\\u003C\\/strong\\u003E your proctor provided you. Write your full name and the name of this course at the top of each sheet.\\u003C\\/p\\u003E\",\"icon\":\"ico-paper\",\"id\":\"ready-on-desk-ap-p5\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-09-22T13:44:19-04:00\\u0022\\u003E1758563059\\u003C\\/time\\u003E\\n\"},{\"id\":\"451\",\"internal_id\":\"ready-under-desk-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items under your desk:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPower cord\\/portable charger. \\u003C\\/strong\\u003EBut if you need to plug in during testing, you may.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-power-cord\",\"id\":\"ready-under-desk-sat-schoolday-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EFood and drink.\\u003C\\/strong\\u003E You can eat and drink during the break but not in the test room (unless you have an approved accommodation).\\u003C\\/p\\u003E\",\"icon\":\"ico-no-snacks\",\"id\":\"desk-itemscannot-sat-schoolday-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-12-08T11:50:46-05:00\\u0022\\u003E1670518246\\u003C\\/time\\u003E\\n\"},{\"id\":\"446\",\"internal_id\":\"ready-on-desk-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items on your desk:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour testing device\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-laptop\",\"id\":\"ready-on-desk-sat-schoolday-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour personal calculator\\u003C\\/strong\\u003E if you brought one. There\\u2019s also a graphing calculator built into the app.\\u003C\\/p\\u003E\",\"icon\":\"ico-calculator\",\"id\":\"ready-on-desk-sat-schoolday-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EAn external mouse or keyboard. \\u003C\\/strong\\u003EYou can use an external keyboard with a tablet\\u2014not with a laptop.\\u003C\\/p\\u003E\",\"icon\":\"ico-mouse\",\"id\":\"ready-on-desk-sat-schoolday-p3\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EA pencil or pen\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-pencil-pen\",\"id\":\"ready-on-desk-sat-schoolday-p4\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EThe scratch paper\\u003C\\/strong\\u003E your proctor provided you. Write your full name at the top of each sheet.\\u003C\\/p\\u003E\",\"icon\":\"ico-paper\",\"id\":\"ready-on-desk-sat-schoolday-p5\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-12-08T11:23:35-05:00\\u0022\\u003E1670516615\\u003C\\/time\\u003E\\n\"},{\"id\":\"441\",\"internal_id\":\"ready-under-desk-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items under your desk:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPower cord\\/portable charger. \\u003C\\/strong\\u003EBut if you need to plug in during testing, you may.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-power-cord\",\"id\":\"ready-under-desk-sat-wkd-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EFood and drink.\\u003C\\/strong\\u003E You can eat and drink during the break but not in the test room (unless you have an approved accommodation).\\u003C\\/p\\u003E\",\"icon\":\"ico-no-snacks\",\"id\":\"ready-under-desk-sat-wkd-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-12-08T11:48:39-05:00\\u0022\\u003E1670518119\\u003C\\/time\\u003E\\n\"},{\"id\":\"436\",\"internal_id\":\"ready-on-desk-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items on your desk:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour testing device\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-laptop\",\"id\":\"ready-on-desk-sat-wkd-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour personal calculator\\u003C\\/strong\\u003E if you brought one. There\\u2019s also a graphing calculator built into the app.\\u003C\\/p\\u003E\",\"icon\":\"ico-calculator\",\"id\":\"ready-on-desk-sat-wkd-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EAn external mouse or keyboard. \\u003C\\/strong\\u003EYou can use an external keyboard with a tablet\\u2014not with a laptop.\\u003C\\/p\\u003E\",\"icon\":\"ico-mouse\",\"id\":\"ready-on-desk-sat-wkd-p3\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EA pencil or pen\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-pencil-pen\",\"id\":\"ready-on-desk-sat-wkd-p4\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EThe scratch paper\\u003C\\/strong\\u003E your proctor provided you. Write your full name at the top of each sheet.\\u003C\\/p\\u003E\",\"icon\":\"ico-paper\",\"id\":\"ready-on-desk-sat-wkd-p5\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour photo ID\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-photoid\",\"id\":\"ready-on-desk-sat-wkd-p6\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-12-08T11:25:40-05:00\\u0022\\u003E1670516740\\u003C\\/time\\u003E\\n\"},{\"id\":\"431\",\"internal_id\":\"privacy-home-help\",\"type\":\"help_detail\",\"title\":\"Privacy Statement\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Ch2\\u003E\\u003Cstrong\\u003EPrivacy Statement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EEffective Date: May 25, 2026\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn addition to updates being announced on our Privacy Center, College Board online account holders will have a temporary alert within their account when updates are made.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYou count on us to take privacy seriously and we embrace that obligation.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThank you for visiting the College Board Privacy Statement, which explains how College Board (\\u0022College Board,\\u0022 \\u0022We,\\u0022 \\u0022Us\\u0022, \\u201cOur\\u201d) collects, processes, uses, discloses, and protects personally identifiable information. College Board is a mission-driven not-for-profit organization that connects students to college success and opportunity, and its data and privacy practices align directly with this mission.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EScope\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EThis Privacy Statement covers our privacy practices across all our programs, including serving individuals and organizations.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis Privacy Statement applies to the programs and services we provide to individuals and to schools, districts, state departments of education, colleges, universities, and other organizations. This Privacy Statement also explains how we use and protect the personally identifiable information you share with us when you use sites and mobile apps owned and operated by College Board.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis Privacy Statement links to other areas where you can learn even more.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EResidents of specific states and countries may find more information consistent with their applicable law in our Jurisdiction-Specific Privacy Supplements: California, \\u0026nbsp;State Consumer Privacy Laws, and EEA, UK and Brazil.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPrivacy policies for specific College Board programs give further information about their data collection, use, and disclosure practices: Program-Specific Privacy Policies and other Supplemental Resources (\\u003Cstrong\\u003Ehttps:\\/\\/privacy.collegeboard.org\\/)\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may also read our\\u0026nbsp;Data Privacy Principles, which guide our overall data privacy practices (\\u003Cstrong\\u003Ecollegeboard.org\\/data-privacy-principles\\u003C\\/strong\\u003E).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EPersonally Identifiable Information Collected\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe will collect the information we need to provide you with our programs and services, and give you choices on how much more information you share with us to best serve you.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board provides programs and services to individuals as well as to institutions. The information we may collect varies and depends on who we are serving and in which programs and services they are participating.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe types and categories of personal data collected are further specified in Program-Specific Privacy Policies, Supplemental Resources, and our agreements with educational institutions, which may include contact information; demographic information; information to verify an individual\\u2019s identity; information for test administration such as their disability; device information and audio and video recordings; information about students\\u2019 interests, educational experience, and plans for after they graduate high school; educational institutional affiliation; or information about professionals\\u2019 role(s) at an educational institution.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInformation collected from individuals.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board collects personally identifiable information that you provide to us and about your use of our programs and services.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIndividuals do not need to create an online account to view and use most of our website. If you are a student, you may create a \\u201cstudent\\u201d account, and if you are an educator, representative of an educational institution, or exam administrator (exam coordinator or proctor), you may create a \\u201cprofessional\\u201d account.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EStudent Accounts: \\u003C\\/strong\\u003EStudents need a College Board account to register for tests directly with us, view and send scores, personalize their web experience, or use certain tools on our site, such as the college and career tools on the BigFuture\\u003Csup\\u003E \\u003C\\/sup\\u003Epages of our site. Student account creation requires acceptance of Legal Terms for Students (\\u003Cstrong\\u003Ecollegeboard.org\\/student-legal-terms)\\u003C\\/strong\\u003E. Student accounts are personal to and belong to the student who creates the account and serve as the student\\u2019s gateway to various College Board programs and services.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EProfessional Accounts: \\u003C\\/strong\\u003EEducation professionals need a College Board account to perform certain tasks or save personalized information. Professional account creation requires acceptance of the Legal Terms for Educators and Institutions (\\u003Cstrong\\u003Ecollegeboard.org\\/educator-legal-terms\\u003C\\/strong\\u003E). Professional accounts are created by professionals acting solely in their capacity as authorized representatives of their respective institutions and are not for their personal use.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EFor any programs and services requiring payment for which a credit card is used, credit card information will be collected and processed by a third-party payment processor. A tokenization approach is used through which your full credit card information is not stored in our systems.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInformation collected from other sources.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board collects personally identifiable information from schools, districts, state departments of education, colleges, universities, and other third parties. When College Board has an agreement with a school, district, state department of education, or higher education institution to provide assessments, financial aid services, and\\/or other educational services, it only collects students\\u2019 and educators\\u2019 information as necessary to provide those services.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may receive information about you from other sources, such as third parties that have authority to share the information. We may also collect information automatically such as through cookies as further described here: \\u003Cstrong\\u003Eprivacy.collegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EInformation Use and Disclosure\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECollege Board will only use and disclose your personally identifiable information to carry out our organization\\u2019s mission for the following purposes.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EConsent. \\u003C\\/strong\\u003EWe will use and disclose your personally identifiable information with your consent and at your direction.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EProvide Our Programs and Services. \\u003C\\/strong\\u003EWe use and disclose personally identifiable information to provide you or your educational institution with our programs and services, such as to administer tests, facilitate the security and integrity of our tests, send scores, connect students with colleges and scholarships, and for educational efforts that help students and educators. When you agree to use a College Board program or service, you agree to the processing of your personally identifiable information as described in this Privacy Statement and the applicable agreement or terms of use presented to you, if any; see Program-Specific Privacy Policies and Supplemental Resources. All students have independent rights in their own test scores, including students\\u2019 rights to access, retain and use their test scores and direct College Board to share their test scores.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EServe Educational Institutions. \\u003C\\/strong\\u003EWhen College Board has an agreement with a school, district, state department of education, or higher education institution to provide assessments, financial aid services, and\\/or other educational services, it uses and discloses students\\u2019 and educators\\u2019 personally identifiable information as necessary to provide those services and for other limited purposes permitted by our agreements. College Board fully complies with the Family Educational Rights and Privacy Act, 20 U.S.C. s. 1232g, and its implementing regulations, 34 C.F.R. pt. 99 (\\u201cFERPA\\u201d), and state student data privacy laws, as applicable.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EEducational Reporting.\\u003C\\/strong\\u003E\\u0026nbsp;We provide student information in accordance with our contracts and applicable international and domestic law to high schools, districts, colleges, and governmental agencies. At the request of these organizations, we provide student information to third parties in support of the organization\\u2019s educational, diagnostic, and\\/or reporting purposes.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOperational Third Parties. \\u003C\\/strong\\u003EWe use and disclose personally identifiable information to third parties providing services to College Board as necessary for their performance of those services, such as:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eadministering testing services,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eproducing and generating student score reports,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eprocessing CSS Profile applications and requests for financial information,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eadministering scholarship and recognition programs,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Edeveloping instructional materials and tools,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eproviding customer service,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esending email and SMS communications,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esupporting the operation, hosting, and enhancing of our website(s),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eevent registration and administration,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Epayment processing, fulfilling orders and shipping and\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;maintaining, developing, supporting, improving, and diagnosing our products and services.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThese vendors cannot relicense, sell, rent, or otherwise repurpose the information. These organizations have contractual requirements to protect personally identifiable information from unauthorized access, use, or disclosure.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECustomer Service.\\u003C\\/strong\\u003E\\u0026nbsp;We use personally identifiable information to maintain your account and to verify user identity during customer service calls and respond to specific requests.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003Cstrong\\u003EWeb Experience.\\u003C\\/strong\\u003E We use personally identifiable information to customize and\\/or personalize your website experience, such as prefilling a test registration with stored personally identifiable information or fulfilling online purchase requests or other transactions performed on our website(s). See \\u003Cstrong\\u003Ecollegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E for more details.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EResearch:\\u003C\\/strong\\u003E\\u0026nbsp;We use personally identifiable information for research consistent with our mission, such as with respect to:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Epsychometric validity (e.g., does an assessment reliably and consistently measure what it\\u2019s supposed to measure, including across subgroups, and is that measurement predictive of performance in college?),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eassessment and program design and improvement (e.g., is there a better way to measure this skill?)\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esafeguarding test security and fairness,\\u0026nbsp;\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Estudent engagement and program effectiveness (e.g., do students who do this activity learn or otherwise receive the intended benefits?),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;identifying and producing public reports about trends in education, and\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esupporting educational research (with aggregated or de-identified data) by educational institutions and other reputable third party organizations.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EFor more information about our research, visit\\u0026nbsp;our Research page (\\u003Cstrong\\u003Eresearch.collegeboard.org\\u003C\\/strong\\u003E).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInternal Analytics\\u003C\\/strong\\u003E. We use personally identifiable information to maintain, develop, support, improve, and diagnose College Board products, services, and applications.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cspan class=\\u0022s1 Apple-tab-span\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cstrong\\u003EArtificial Intelligence.\\u003C\\/strong\\u003E We use artificial intelligence, machine learning,\\u0026nbsp;and other computational methods (collectively, \\u201c\\u003Cstrong\\u003EAI\\u003C\\/strong\\u003E\\u201d), to support certain features of our products, services, and applications. These tools may process personal information in accordance with this Privacy Notice. The use of AI is monitored and is designed to help improve efficiency and fairness.\\u0026nbsp;\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EParents and Legal Guardians\\u003C\\/strong\\u003E. If you are under the age of 18, we may disclose your information to your parent(s) and\\/or legal guardian(s).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOther Instances\\u003C\\/strong\\u003E.\\u0026nbsp;We may also disclose your personally identifiable information as required by law, for example, to comply with a subpoena or other legal process, when we believe in good faith that it\\u2019s necessary to protect our rights, protect your safety, or the safety of others, investigate and help prevent fraud, or respond to a government request.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board may use and disclose anonymized, aggregated, and de-identified data, except to the extent such disclosure may be limited by law or in an agreement it may have with an individual or institution.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EAccess to Your Information and Data Retention\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EYou can access your information and have certain choices on how to update and manage your information.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board will give you information about whether we have, or process on behalf of a third party, any of your personally identifiable information,\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003Cstrong\\u003E \\u003C\\/strong\\u003E\\u003C\\/span\\u003Eif reasonably available and subject to applicable laws.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may keep your information as needed for legitimate educational purposes, to provide services to you or your educational institution, comply with our legal obligations, resolve disputes, and enforce our agreements. Depending on where you live, you may have certain rights to request deletion of your personally identifiable information, subject to limitations and exceptions under applicable laws. College Board uses secure methods to delete or destroy personally identifiable information.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have a College Board account, you may access and correct certain of your information by logging in to your account at \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou can also ask us to close your College Board account. If College Board closes your account, you won\\u2019t be able to access your account. For students, this also means you will not be able to see or send any of your scores, or see information related to any other account activity. For educators, this also means you will lose your ability to access any of our programs or applications such as those used to administer College Board exams, AP teacher-related resources, and financial aid program tools. You\\u2019ll also be unsubscribed from optional communications and Student Search Service\\u003Csup\\u003E\\u2122\\u003C\\/sup\\u003E, if applicable. Closing your account does not delete your information and you may request that College Board reactivate your account at a future date.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo make requests to access, correct, restrict, or delete your personally identifiable information or close your College Board account, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/386?navId=gf-pc)\\u003C\\/strong\\u003E, email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E, or contact Customer Service. We\\u2019ll respond to these requests within a reasonable timeframe and as required by applicable law.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECustomer Service Contact Information:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EPhone: (844) 849-3551\\u003C\\/p\\u003E\\u003Cp\\u003ESee our State Consumer Privacy Law Supplemental Privacy Notice for additional information about your rights in certain states. EEA, UK and Brazil residents\\u2014see our\\u0026nbsp;EEA, UK and Brazil Privacy Notice\\u0026nbsp;for additional information about your rights.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ECommunications and Engagement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe keep you informed about the programs you are participating in, and you can choose what you want to learn more about.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board uses your personally identifiable information to contact you about our programs and services, which are available to you as an individual and\\/or to institutions you may represent.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have a College Board account, you can manage your communication preferences. Based on your choices, we may send you two types of emails: transactional communications and optional communications about our programs and services.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cstrong\\u003ETransactional emails \\u003C\\/strong\\u003Erelate directly to your participation in a College Board program or service or an action you took on our site.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cstrong\\u003EOptional emails \\u003C\\/strong\\u003Einform individuals about College Board programs, services, newsletters, alerts, events, and surveys. When you create a College Board account, you\\u2019re given the option to receive these communications from us and can change your preferences at any time. To unsubscribe from optional emails:\\u003Cul\\u003E\\u003Cli\\u003EClick the\\u0026nbsp;\\u003Cstrong\\u003EUnsubscribe\\u003C\\/strong\\u003E\\u0026nbsp;link at the bottom of any College Board email\\u003C\\/li\\u003E\\u003Cli\\u003EManage your email subscriptions through your\\u0026nbsp;College Board account\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EContact us\\u0026nbsp;at\\u0026nbsp;\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us\\u003C\\/strong\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003EWrite to:\\u003Cbr\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EAttention: User Account Manager\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESee SMS (Texting) Program-Specific information for more details about our optional texting programs available for students and professionals.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ECookies and Related Technologies\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe collect data through cookies and other technologies to customize and improve our programs.\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ELike most websites, our systems gather certain information automatically. This information is used to analyze usage trends in the aggregate and administer and improve the site, as well as personalize your experiences with College Board. Please visit our Cookie and Web Technologies Notice (\\u003Cstrong\\u003Ehttps:\\/\\/privacy.collegeboard.org\\/cookie-notice\\u003C\\/strong\\u003E) for more information about these technologies, information we obtain through them, how we use information, and how you can manage your choices.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EThird Parties and Online Advertising: \\u003C\\/strong\\u003EWe do not display any third party advertising on our site.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESee also our State Consumer Privacy Laws Supplemental Privacy Notice for additional information.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EProtection and Security of Information\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u003Cstrong\\u003EWe implement safeguards to protect your data.\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board has a variety of reasonable administrative, technical, and physical safeguards in place to protect the security and confidentiality of personally identifiable information. We follow industry-recognized security practices and standards to protect the personally identifiable information given to us, both during transmission and once it\\u2019s received. College Board will notify individuals in the event of a data incident involving unauthorized access to their personally identifiable information, consistent with and as required by law and contractual requirements. College Board has ISO 27001 and SOC-2 certifications and is certified by third-party auditors annually to help us proactively manage risks and controls. However, because no data transmission over the internet nor any website, mobile application, database, or system can be guaranteed 100% secure, we can\\u2019t guarantee the security of information. If you have any questions about the security of your personally identifiable information, email us at\\u0026nbsp;\\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ELinks: \\u003C\\/strong\\u003ETo give you more resources and information, we may include third-party links such as to colleges, universities, access organizations, scholarship organizations, career information, test preparation, and site administration on our site. These linked sites have separate and independent privacy policies that you should read. We have no responsibility or liability for the content and activities of these linked sites, but we want to protect the integrity of our site and welcome any feedback about these linked sites (including if a specific link doesn\\u2019t work).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EChildren Under 13\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOur online programs are for those at least 13 years old.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe do not knowingly collect personally identifiable information online from children under 13. If you know of a child giving us this type of information online, please\\u0026nbsp;send us a message\\u0026nbsp;(\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/send-message\\u003C\\/strong\\u003E) or contact\\u0026nbsp;Customer Service (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us)\\u003C\\/strong\\u003E\\u0026nbsp;to have the account deactivated.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EInternational Users and Data Transfers\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe are based in the U.S. and process data in the U.S.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board, its website, and its website servers are located and operated in the United States, requiring your information to be transferred from your location to the United States, which may not provide the same level of protection for your personally identifiable information as your home country. The information may be available to the United States government or its agencies under a lawful order in the United States. When you give information to College Board through this website for any reason or otherwise send us your personally identifiable information, including for any of the services we offer, you acknowledge a cross-border transfer of that information to the United States. In addition, College Board works with a trusted third-party service provider, Alorica, to provide customer service with contact centers in the United States and the Philippines. If you do not agree to this international transfer of data, you shouldn\\u2019t use the website and the services it offers or otherwise send us your personally identifiable information. If you choose to revoke your consent to such transfer, and this is the lawful basis for the processing, we may cease processing your information. Depending on the service you\\u2019re using the website for, it may impact your ability to apply or be accepted to a U.S. college or university.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn certain countries, data protection and privacy laws provide individuals with certain rights, such as the right to access, correct, request deletion of, restrict or object to the processing of, or portability of your personally identifiable information. To exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request?navId=gf-pc\\u003C\\/strong\\u003E) or email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E. If you exercise or seek to exercise any of those rights, our obligations to respond are limited by and subject to applicable law.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EAs part of certain test administrations outside of the United States, and only with test taker\\u2019s consent, College Board may collect special categories of personal data, as permitted by applicable law. This may include biometric data (e.g., facial images and keystrokes), throughout the test administration. College Board will not process special categories of personal data for any purpose other than for which we have received your affirmative and explicit consent (opt-in).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EEEA, UK and Brazil residents\\u2014please read the EEA, UK and Brazil Privacy Notice.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EChanges to Our Privacy Statement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe sometimes update our Privacy Statement, so visit these pages periodically to review the latest changes. Policy changes will only apply to information collection after the date of change.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EContact Us\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have any questions about this Privacy Statement or our privacy and data security practices, please contact us at \\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E. You may also contact us at:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EPhone: (844) 849-3551\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EWebsite Terms and Conditions\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease also visit our Legal Terms for Students (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/student-legal-terms\\u003C\\/strong\\u003E) and Legal Terms for Educators and Institutions (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/educator-legal-terms\\u003C\\/strong\\u003E), which establish the use, disclaimers, and limitations of liability governing the use of our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EJurisdiction-Specific Privacy Supplements\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cspan class=\\u0022s3\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ENotice of Your California Privacy Rights\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECalifornia Residents\\u2014Your Privacy Rights:\\u0026nbsp;\\u003C\\/strong\\u003ECalifornia law (California Civil Code Section 1798.83) permits residents of California to opt out of College Board disclosure of personally identifiable information to third parties for marketing purposes at any time. College Board will not disclose your personally identifiable information to third parties for marketing without giving you notice and getting your consent. Please note\\u2014this opt-out doesn\\u2019t prohibit disclosures for non-marketing purposes. You can opt out for free by\\u0026nbsp;contacting us at \\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us\\u003C\\/strong\\u003E\\u0026nbsp;or writing to:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E11955 Democracy Drive\\u003Cbr\\u003EReston, VA 20190\\u003Cbr\\u003EAttention: Student Search Service\\u003Cbr\\u003EPlease note that College Board is not subject to the California Consumer Privacy Act (CCPA) or the California Privacy Rights Act (CPRA) as a nonprofit organization.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECalifornia Do Not Track Disclosure\\u003C\\/strong\\u003E\\u003Cbr\\u003ESome browsers may be able to send a do not track signal to websites. The College Board site does not respond to do not track signals or similar mechanisms and requests.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EState Consumer Privacy Laws Supplemental Privacy Notice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003EThis supplemental privacy notice gives residents of certain states additional information required by their applicable consumer privacy laws, a current list of which is available on our Privacy Center.\\u003Cstrong\\u003E \\u003C\\/strong\\u003EThese provisions, together with the statements in the College Board privacy notices, explain our practices for processing residents\\u2019 personal data to the extent their state\\u2019s consumer privacy law applies. If there are material changes to the Privacy Statement or its State Consumer Privacy Laws Supplemental Privacy Notice, we will contact those as required by their state laws using their College Board account email address.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ESensitive Data: College Board may collect and process certain information defined as sensitive under applicable states laws. This may include your race and ethnicity to provide and personalize our programs and services and conduct research consistent with our mission, mental or physical health condition or diagnosis to process your request for testing accommodations, citizenship to process your CSS Profile application, and data about individuals under age 13 to provide programs requested by them.\\u0026nbsp; Further specificity on processing purposes for sensitive data will be provided to you through informed, express consent for any such processing as required by law. \\u0026nbsp;\\u003C\\/strong\\u003EYou may have the right to opt-out of the processing of sensitive data as part of our consumer programs and services, which you may do through our Consent Management Preferences Center at \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\/privacy\\u003C\\/strong\\u003E. You may also call Customer Service at 866-756-7346 or email \\u003Cstrong\\u003Einquiry@collegeboard.org\\u003C\\/strong\\u003E\\u0026nbsp;for further instructions or assistance with access to the Consent Management Preferences Center.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour Rights:\\u003C\\/strong\\u003E\\u0026nbsp;College Board respects your right to access, correct, and request deletion of your personally identifiable information and to portability of it as required by law. Depending on where you live, this means:\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have a right to know if College Board maintains your personally identifiable \\u0026nbsp;\\u0026nbsp;\\u0026nbsp;\\u0026nbsp;information. If we do, you have the right to access it and request that we provide you a copy of your information (subject to the rights of others) in a portable, and, to the extent technically feasible, readily usable format that allows you to transmit it to another entity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EIf your information is inaccurate, you have the right to ask us to update it.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou may ask us to delete your personally identifiable information.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou may ask us to identify third parties or categories of third parties to whom data may have been provided.\\u003Cbr\\u003E\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement and our Customer Service team will assist you. You may also go to \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\u003C\\/strong\\u003E to access and correct certain personal data. Our ability to delete personal information will be limited when we\\u2019re required to retain records, as in connection with score reports and test security processes.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhile not the \\u201csale\\u201d of data as defined under otherwise applicable state consumer privacy laws, College Board also respects your right to opt out of Student Search Service (Search). You can opt out of Search at any time by submitting the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), going to\\u0026nbsp;\\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\/privacy\\u003C\\/strong\\u003E, contacting us at 866-825-8051, or emailing us at\\u0026nbsp;\\u003Cstrong\\u003ESearchCustomerService@collegeboard.org\\u003C\\/strong\\u003E.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may authorize someone to act on your behalf to exercise these rights, using the same methods described above. We may need to verify your identity, and any authorized agent authorized by you to act on your behalf, before we can process your request. College Board\\u2019s process to authenticate identity includes name, date of birth, and security phrase or security questions, as well as further validation processes, if necessary, including use of the phone number associated with the account.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf College Board does not take the action you requested when exercising these rights, you may appeal such inaction within a reasonable period after we have notified you of our denial of your request. To submit your appeal, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMarketing Cookies:\\u003C\\/strong\\u003E\\u0026nbsp;When you visit our website and with your consent, we place cookies on your computer. While College Board does not use data for targeted advertising as defined by state consumer privacy laws otherwise applicable to College Board, for convenience visitors to our site from certain states can opt out of cookies for nonessential website purposes when they first access our site, including marketing cookies. You may exercise your right to opt out of processing personal data for marketing cookies accessing the \\u201cManage Cookies\\u201d link at the footer of a College Board webpage or a floating cookie icon at the bottom of your screen while on our website. Please see the Cookies and Website Usage (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E) for more information about cookies and similar technologies.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EEEA, UK and Brazil Supplemental Privacy Notice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis supplemental privacy notice gives those located in the European Economic Area (EEA), United Kingdom (UK), and Brazilian residents additional information required by local law. These provisions, together with the statements in the College Board privacy notices, explain our practices for processing EEA, UK, and Brazilian residents\\u2019 personal data.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECookies:\\u003C\\/strong\\u003E\\u0026nbsp;Visitors to our site from the EEA, UK and Brazil can opt out of cookies for nonessential website purposes when they first access our site. When you visit our website and with your consent, we place cookies on your computer. After you make selections through our cookie banner, you can manage options at any time here.\\u0026nbsp; This is also available to you through a \\u201cManage Cookies\\u201d link at the footer of a College Board webpage or a floating cookie icon at the bottom of your screen while on our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease see the Cookies and Website Usage for more information about cookies and similar technologies.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis EEA, UK and Brazil Privacy Notice explains why we collect your personally identifiable information and how we process it. When necessary, we collect and process your information per the lawful bases described below:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003ETo fulfill a contract with you, for instance to provide a College Board test or a test offered by another company on behalf of College Board.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EWe may provide personally identifiable information to our operational third parties (processors) and other trusted businesses or persons to process it for us, based on our written instructions and in compliance with our Privacy Statement and any other appropriate confidentiality and security measures. For example, we use service providers to help process and score our tests.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003ETo process a payment, to create an account on our website, and for website management.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information with your consent to send you optional email communications, enroll you in Student Search Service, or send your scores to your designated recipients.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information for the purposes of our legitimate interests, if processing it doesn\\u2019t outweigh your rights and freedoms. We may process your personal information as needed to:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EProtect you, us, or others from threats (such as test security, security threats, or test fraud).\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EImprove College Board tests and support College Board research initiatives.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EEnable or administer our business, such as for quality control, consolidated reporting, and customer service.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EManage corporate transactions, such as mergers or acquisitions.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EUnderstand and improve our business, improve test integrity, and for research purposes.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information to comply with applicable laws.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAutomated Decision Making and Profiling:\\u003C\\/strong\\u003E\\u0026nbsp;College Board may use automated processes in connection with scoring tests and for similar purposes, as needed to provide the test services you have requested, and for fraud prevention related to test security. All of these decisions are subject to human review. We will not make automated decisions about you that may significantly affect you, unless (a) the decision is necessary as part of a contract we have with you, (b) we have your explicit consent, or (c) we\\u2019re required by law to use the technology. You can learn more about test scoring by reading the information posted on our website about each of our tests. You can learn more about test security by reading the information posted on our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn some cases, we use certain elements of personal data for College Board research. For example, we may consider how certain types of test takers (such as non-native English speakers) respond to specific test questions. Our research initiatives reflect our commitment to fairness and equity in testing, helping to ensure that our tests are accessible and free from bias. They also aim to improve teaching, learning, and assessment. Our research results do not contain any identifiable data and aren\\u2019t used to target or profile individuals. Visit\\u0026nbsp;\\u003Cstrong\\u003Eresearch.collegeboard.org\\u003C\\/strong\\u003E\\u0026nbsp;to learn more.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour Rights:\\u003C\\/strong\\u003E\\u0026nbsp;As stated in this EEA, UK and Brazil Privacy Notice, you always have the right to object to our optional email communications. To opt out of these emails, click the\\u0026nbsp;\\u003Cstrong\\u003EUnsubscribe\\u003C\\/strong\\u003E\\u0026nbsp;link at the bottom of any email we send you. And see the sections above related to communications and engagement for information about your choices and opting out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board also respects your right to access, correct, and request erasure or restriction of your personally identifiable information as required by law. This means:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have a right to know if College Board maintains your personally identifiable information. If we do, we\\u2019ll give you a copy (subject to the rights of others). If your information is incorrect or incomplete, you have the right to ask us to update it.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have the right to object to our processing of your personally identifiable information.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may also ask us to delete or restrict your personally identifiable information, including a copy of your information related to your right to data portability.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement and our Customer Service team will assist you (we may need to verify your identity before we can process your request). Our ability to delete personal information will be limited when we\\u2019re required to retain records, as in connection with score reports and test security processes.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you believe we have processed your personally identifiable information in violation of applicable law, you can file a complaint with the College Board Chief Privacy Officer by emailing\\u0026nbsp;\\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E or with a supervisory authority.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EData Retention: \\u003C\\/strong\\u003EWe\\u2019ll retain your personally identifiable information for as long as the information is needed for the purposes detailed above and for any additional period that may be required or permitted by law. You may request that we delete your personally identifiable information by completing the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E) or emailing us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E. Unless we\\u2019re required by law to retain your information or have a legitimate interest in retaining it, we\\u2019ll delete it within 30 days of your request. If you ask us to delete your data you won\\u2019t be able to access any College Board account or test scores or send test scores to any colleges, universities, or any other third parties.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-26T14:53:18-04:00\\u0022\\u003E1782499998\\u003C\\/time\\u003E\\n\"},{\"id\":\"426\",\"internal_id\":\"app-terms-conds-home-help\",\"type\":\"help_detail\",\"title\":\"Privacy Policy and Use of This App\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EWelcome to Bluebook\\u2122, College Board\\u2019s testing app\\u003Cem\\u003E.\\u003C\\/em\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003EBluebook and all of its content, features and functionality are property of College Board\\u0026nbsp;and\\/or its licensors and are protected by copyright laws.\\u0026nbsp;You may only use Bluebook for its intended purposes. You are prohibited from taking screenshots in Bluebook and from attempting to reverse engineer, decompile, or otherwise attempt to reproduce, tamper with, or compromise the security of Bluebook in any way.\\u003C\\/p\\u003E\\u003Cp\\u003EWe (College Board) are committed to protecting your privacy.\\u0026nbsp;Please review our Privacy Policies at \\u003Cstrong\\u003Eprivacy.collegeboard.org\\u003C\\/strong\\u003E.\\u0026nbsp;You can also read the Privacy Statement under\\u0026nbsp;\\u003Cstrong\\u003EHelp\\u0026nbsp;\\u003C\\/strong\\u003Eon the Bluebook homepage.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003EDevice Data: When you download and use Bluebook, College Board will receive certain information about your testing device, including device type, operating system type and version, applications and processes running on your device, Internet Protocol (IP) address, screen size and resolution, number of screens, available memory, storage and disk bytes, disk mount, type and size, battery level, and other device-specific information for the purposes described below.\\u003C\\/li\\u003E\\u003Cli\\u003EActivity Data: We also monitor and capture the actions you take in Bluebook, including your responses, where you click, where you put your mouse on the page, how long you spend on each page, ctrl\\/alt\\/delete attempts, and how you navigate through Bluebook. As part of certain test administrations outside the United States, we may also collect cursor movements and screen data, including screenshots and the contents of the document object model (DOM) rendered on screen. With your separate consent, we may also use a biometric-enabled system to collect biometric data, including facial images (using the front-facing camera on your testing device) and keystrokes, throughout the international test administration.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp\\u003ETemporary Administrative Rights (Only International SAT Weekend on Windows) For Test Security Purposes:\\u003Cstrong\\u003E As part of certain SAT Weekend test administrations outside the United States on a Windows device and as described to you in the SAT Weekend Testing Rules, you consent to granting College Board temporary administrative rights and access to your testing device during the international SAT Weekend test administration only\\u003C\\/strong\\u003E. You will be prompted to grant administrative rights to College Board when you use or download Bluebook for the test. Through these administrative rights, College Board may monitor and collect certain information and control your testing device during testing as follows:\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003ECollect data about how your Windows device is configured and started\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003ECollect a list of any drivers on your device (e.g., printers, private network connections) and any changes to such drivers\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003EMonitor and stop other programs, applications, networks, and devices\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003EMonitor keystrokes to detect certain actions (e.g., copy\\/paste, screen capture)\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003EBlock internet access\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003EChange settings on your testing device such as those with impacts to which programs may run, access to external storage (e.g., USB), the microphone and speakers, and notifications\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003EMonitor programs such as those for incoming network connections and use of audio\\u003C\\/li\\u003E\\u003Cli\\u003EMonitor the status of Bluebook, such as attempts to shut it down or tamper with it\\u003C\\/li\\u003E\\u003Cli\\u003ECollect file locations and other data which may contain folder names, document names, and your Windows username\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board will not use these administrative rights to collect what you type, any microphone audio, any contents of personal files (e.g., photos, emails, social media messaging), any of your browser history, or any global positioning service (GPS) location.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThese temporary administrative rights are utilized\\u003Cstrong\\u003E only \\u003C\\/strong\\u003Eduring the applicable international SAT Weekend test session.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003EData Use: Information collected by Bluebook using the temporary administrative rights (only international SAT Weekend test on a Windows device), Device Data, and Activity Data (collectively, \\u201cData\\u201d) may be used by College Board to make sure your testing device is compatible with Bluebook, for test security purposes, for test validation and research, and to develop and improve College Board products and services. Data may be disclosed to trusted vendors, but only in their provision of services to College Board, and we may disclose aggregated and de-identified Data. Data may be shared with your school, district, or state education department related to tests you take on Bluebook, including any misuse of Bluebook. Data is not sold or licensed to third parties, including without limitation for their marketing or other commercial purposes. You will also be asked to type specific sentences in Bluebook. Neither Data nor those typed sentences are used for biometric identification.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp\\u003EYou will need an internet connection to use Bluebook.\\u003C\\/p\\u003E\\u003Cp\\u003EYou are responsible for maintaining the security of your login credentials, whether you login with a code or with your College Board username and password.\\u003C\\/p\\u003E\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-09-25T17:28:55-04:00\\u0022\\u003E1790371735\\u003C\\/time\\u003E\\n\"},{\"id\":\"421\",\"internal_id\":\"modal-privacy-cb\",\"type\":\"functional_content\",\"title\":\"Privacy Statement\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch2\\u003E\\u003Cstrong\\u003EPrivacy Statement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EEffective Date: July 10, 2025\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn addition to updates being announced on our Privacy Center, College Board online account holders will have a temporary alert within their account when updates are made.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYou count on us to take privacy seriously and we embrace that obligation.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThank you for visiting the College Board Privacy Statement, which explains how College Board (\\u0022College Board,\\u0022 \\u0022We,\\u0022 \\u0022Us\\u0022, \\u201cOur\\u201d) collects, processes, uses, discloses, and protects personally identifiable information. College Board is a mission-driven not-for-profit organization that connects students to college success and opportunity, and its data and privacy practices align directly with this mission.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EScope\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EThis Privacy Statement covers our privacy practices across all our programs, including serving individuals and organizations.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis Privacy Statement applies to the programs and services we provide to individuals and to schools, districts, state departments of education, colleges, universities, and other organizations. This Privacy Statement also explains how we use and protect the personally identifiable information you share with us when you use sites and mobile apps owned and operated by College Board.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis Privacy Statement links to other areas where you can learn even more.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EResidents of specific states and countries may find more information consistent with their applicable law in our Jurisdiction-Specific Privacy Supplements: California, \\u0026nbsp;State Consumer Privacy Laws, and EEA, UK and Brazil.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPrivacy policies for specific College Board programs give further information about their data collection, use, and disclosure practices: Program-Specific Privacy Policies and other Supplemental Resources (\\u003Cstrong\\u003Ehttps:\\/\\/privacy.collegeboard.org\\/)\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may also read our\\u0026nbsp;Data Privacy Principles, which guide our overall data privacy practices (\\u003Cstrong\\u003Ecollegeboard.org\\/data-privacy-principles\\u003C\\/strong\\u003E).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EPersonally Identifiable Information Collected\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe will collect the information we need to provide you with our programs and services, and give you choices on how much more information you share with us to best serve you.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board provides programs and services to individuals as well as to institutions. The information we may collect varies and depends on who we are serving and in which programs and services they are participating.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe types and categories of personal data collected are further specified in Program-Specific Privacy Policies, Supplemental Resources, and our agreements with educational institutions, which may include contact information; demographic information; information to verify an individual\\u2019s identity; information for test administration such as their disability; device information; information about students\\u2019 interests, educational experience, and plans for after they graduate high school; educational institutional affiliation; or information about professionals\\u2019 role(s) at an educational institution.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInformation collected from individuals.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board collects personally identifiable information that you provide to us and about your use of our programs and services.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIndividuals do not need to create an online account to view and use most of our website. If you are a student, you may create a \\u201cstudent\\u201d account, and if you are an educator, representative of an educational institution, or exam administrator (exam coordinator or proctor), you may create a \\u201cprofessional\\u201d account.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EStudent Accounts: \\u003C\\/strong\\u003EStudents need a College Board account to register for tests directly with us, view and send scores, personalize their web experience, or use certain tools on our site, such as the college and career tools on the BigFuture\\u003Csup\\u003E \\u003C\\/sup\\u003Epages of our site. Student account creation requires acceptance of Legal Terms for Students (\\u003Cstrong\\u003Ecollegeboard.org\\/student-legal-terms)\\u003C\\/strong\\u003E. Student accounts are personal to and belong to the student who creates the account and serve as the student\\u2019s gateway to various College Board programs and services.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EProfessional Accounts: \\u003C\\/strong\\u003EEducation professionals need a College Board account to perform certain tasks or save personalized information. Professional account creation requires acceptance of the Legal Terms for Educators and Institutions (\\u003Cstrong\\u003Ecollegeboard.org\\/educator-legal-terms\\u003C\\/strong\\u003E). Professional accounts are created by professionals acting solely in their capacity as authorized representatives of their respective institutions and are not for their personal use.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EFor any programs and services requiring payment for which a credit card is used, credit card information will be collected and processed by a third-party payment processor. A tokenization approach is used through which your full credit card information is not stored in our systems.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInformation collected from other sources.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board collects personally identifiable information from schools, districts, state departments of education, colleges, universities, and other third parties. When College Board has an agreement with a school, district, state department of education, or higher education institution to provide assessments, financial aid services, and\\/or other educational services, it only collects students\\u2019 and educators\\u2019 information as necessary to provide those services.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may receive information about you from other sources, such as third parties that have authority to share the information. We may also collect information automatically such as through cookies as further described here: \\u003Cstrong\\u003Eprivacy.collegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EInformation Use and Disclosure\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECollege Board will only use and disclose your personally identifiable information to carry out our organization\\u2019s mission for the following purposes.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EConsent. \\u003C\\/strong\\u003EWe will use and disclose your personally identifiable information with your consent and at your direction.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EProvide Our Programs and Services. \\u003C\\/strong\\u003EWe use and disclose personally identifiable information to provide you or your educational institution with our programs and services, such as to administer tests, send scores, connect students with colleges and scholarships, and for educational efforts that help students and educators. When you agree to use a College Board program or service, you agree to the processing of your personally identifiable information as described in this Privacy Statement and the applicable agreement or terms of use presented to you, if any; see Program-Specific Privacy Policies and Supplemental Resources. All students have independent rights in their own test scores, including students\\u2019 rights to access, retain and use their test scores and direct College Board to share their test scores.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EServe Educational Institutions. \\u003C\\/strong\\u003EWhen College Board has an agreement with a school, district, state department of education, or higher education institution to provide assessments, financial aid services, and\\/or other educational services, it uses and discloses students\\u2019 and educators\\u2019 personally identifiable information as necessary to provide those services and for other limited purposes permitted by our agreements. College Board fully complies with the Family Educational Rights and Privacy Act, 20 U.S.C. s. 1232g, and its implementing regulations, 34 C.F.R. pt. 99 (\\u201cFERPA\\u201d), and state student data privacy laws, as applicable.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EEducational Reporting.\\u003C\\/strong\\u003E\\u0026nbsp;We provide student information in accordance with our contracts and applicable international and domestic law to high schools, districts, colleges, and governmental agencies. At the request of these organizations, we provide student information to third parties in support of the organization\\u2019s educational, diagnostic, and\\/or reporting purposes.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOperational Third Parties. \\u003C\\/strong\\u003EWe use and disclose personally identifiable information to third parties providing services to College Board as necessary for their performance of those services, such as:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eadministering testing services,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eproducing and generating student score reports,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eprocessing CSS Profile applications and requests for financial information,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eadministering scholarship and recognition programs,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Edeveloping instructional materials and tools,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eproviding customer service,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esending email and SMS communications,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esupporting the operation, hosting, and enhancing of our website(s),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eevent registration and administration,\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Epayment processing, fulfilling orders and shipping and\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;maintaining, developing, supporting, improving, and diagnosing our products and services.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThese vendors cannot relicense, sell, rent, or otherwise repurpose the information. These organizations have contractual requirements to protect personally identifiable information from unauthorized access, use, or disclosure.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECustomer Service.\\u003C\\/strong\\u003E\\u0026nbsp;We use personally identifiable information to maintain your account and to verify user identity during customer service calls and respond to specific requests.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003Cstrong\\u003EWeb Experience.\\u003C\\/strong\\u003E We use personally identifiable information to customize and\\/or personalize your website experience, such as prefilling a test registration with stored personally identifiable information or fulfilling online purchase requests or other transactions performed on our website(s). See \\u003Cstrong\\u003Ecollegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E for more details.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EResearch:\\u003C\\/strong\\u003E\\u0026nbsp;We use personally identifiable information for research consistent with our mission, such as with respect to:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Epsychometric validity (e.g., does an assessment reliably and consistently measure what it\\u2019s supposed to measure, including across subgroups, and is that measurement predictive of performance in college?),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Eassessment and program design and improvement (e.g., is there a better way to measure this skill?)\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esafeguarding test security and fairness,\\u0026nbsp;\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Estudent engagement and program effectiveness (e.g., do students who do this activity learn or otherwise receive the intended benefits?),\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;identifying and producing public reports about trends in education, and\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003Esupporting educational research (with aggregated or de-identified data) by educational institutions and other reputable third party organizations.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EFor more information about our research, visit\\u0026nbsp;our Research page (\\u003Cstrong\\u003Eresearch.collegeboard.org\\u003C\\/strong\\u003E).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EInternal Analytics\\u003C\\/strong\\u003E. We use personally identifiable information to maintain, develop, support, improve, and diagnose College Board products, services, and applications.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EParents and Legal Guardians\\u003C\\/strong\\u003E. If you are under the age of 18, we may disclose your information to your parent(s) and\\/or legal guardian(s).\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOther Instances\\u003C\\/strong\\u003E.\\u0026nbsp;We may also disclose your personally identifiable information as required by law, for example, to comply with a subpoena or other legal process, when we believe in good faith that it\\u2019s necessary to protect our rights, protect your safety, or the safety of others, investigate and help prevent fraud, or respond to a government request.\\u003C\\/p\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board may use and disclose anonymized, aggregated, and de-identified data, except to the extent such disclosure may be limited by law or in an agreement it may have with an individual or institution.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EAccess to Your Information and Data Retention\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EYou can access your information and have certain choices on how to update and manage your information.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board will give you information about whether we have, or process on behalf of a third party, any of your personally identifiable information,\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003Cstrong\\u003E \\u003C\\/strong\\u003E\\u003C\\/span\\u003Eif reasonably available and subject to applicable laws.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may keep your information as needed for legitimate educational purposes, to provide services to you or your educational institution, comply with our legal obligations, resolve disputes, and enforce our agreements. Depending on where you live, you may have certain rights to request deletion of your personally identifiable information, subject to limitations and exceptions under applicable laws. College Board uses secure methods to delete or destroy personally identifiable information.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have a College Board account, you may access and correct certain of your information by logging in to your account at \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou can also ask us to close your College Board account. If College Board closes your account, you won\\u2019t be able to access your account. For students, this also means you will not be able to see or send any of your scores, or see information related to any other account activity. For educators, this also means you will lose your ability to access any of our programs or applications such as those used to administer College Board exams, AP teacher-related resources, and financial aid program tools. You\\u2019ll also be unsubscribed from optional communications and Student Search Service\\u003Csup\\u003E\\u2122\\u003C\\/sup\\u003E, if applicable. Closing your account does not delete your information and you may request that College Board reactivate your account at a future date.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo make requests to access, correct, restrict, or delete your personally identifiable information or close your College Board account, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/386?navId=gf-pc)\\u003C\\/strong\\u003E, email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E, or contact Customer Service. We\\u2019ll respond to these requests within a reasonable timeframe and as required by applicable law.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECustomer Service Contact Information:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EPhone: (844) 849-3551\\u003C\\/p\\u003E\\u003Cp\\u003ESee our State Consumer Privacy Law Supplemental Privacy Notice for additional information about your rights in certain states. EEA, UK and Brazil residents\\u2014see our\\u0026nbsp;EEA, UK and Brazil Privacy Notice\\u0026nbsp;for additional information about your rights.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ECommunications and Engagement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe keep you informed about the programs you are participating in, and you can choose what you want to learn more about.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board uses your personally identifiable information to contact you about our programs and services, which are available to you as an individual and\\/or to institutions you may represent.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have a College Board account, you can manage your communication preferences. Based on your choices, we may send you two types of emails: transactional communications and optional communications about our programs and services.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cstrong\\u003ETransactional emails \\u003C\\/strong\\u003Erelate directly to your participation in a College Board program or service or an action you took on our site.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cstrong\\u003EOptional emails \\u003C\\/strong\\u003Einform individuals about College Board programs, services, newsletters, alerts, events, and surveys. When you create a College Board account, you\\u2019re given the option to receive these communications from us and can change your preferences at any time. To unsubscribe from optional emails:\\u003Cul\\u003E\\u003Cli\\u003EClick the\\u0026nbsp;\\u003Cstrong\\u003EUnsubscribe\\u003C\\/strong\\u003E\\u0026nbsp;link at the bottom of any College Board email\\u003C\\/li\\u003E\\u003Cli\\u003EManage your email subscriptions through your\\u0026nbsp;College Board account\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EContact us\\u0026nbsp;at\\u0026nbsp;\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us\\u003C\\/strong\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003EWrite to:\\u003Cbr\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EAttention: User Account Manager\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESee SMS (Texting) Program-Specific information for more details about our optional texting programs available for students and professionals.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ECookies and Related Technologies\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe collect data through cookies and other technologies to customize and improve our programs.\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ELike most websites, our systems gather certain information automatically. This information is used to analyze usage trends in the aggregate and administer and improve the site, as well as personalize your experiences with College Board. Please visit our Cookie and Web Technologies Notice (\\u003Cstrong\\u003Ehttps:\\/\\/privacy.collegeboard.org\\/cookie-notice\\u003C\\/strong\\u003E) for more information about these technologies, information we obtain through them, how we use information, and how you can manage your choices.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EThird Parties and Online Advertising: \\u003C\\/strong\\u003EWe do not display any third party advertising on our site.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESee also our State Consumer Privacy Laws Supplemental Privacy Notice for additional information.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EProtection and Security of Information\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u003Cstrong\\u003EWe implement safeguards to protect your data.\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board has a variety of reasonable administrative, technical, and physical safeguards in place to protect the security and confidentiality of personally identifiable information. We follow industry-recognized security practices and standards to protect the personally identifiable information given to us, both during transmission and once it\\u2019s received. College Board will notify individuals in the event of a data incident involving unauthorized access to their personally identifiable information, consistent with and as required by law and contractual requirements. College Board has ISO 27001 and SOC-2 certifications and is certified by third-party auditors annually to help us proactively manage risks and controls. However, because no data transmission over the internet nor any website, mobile application, database, or system can be guaranteed 100% secure, we can\\u2019t guarantee the security of information. If you have any questions about the security of your personally identifiable information, email us at\\u0026nbsp;\\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ELinks: \\u003C\\/strong\\u003ETo give you more resources and information, we may include third-party links such as to colleges, universities, access organizations, scholarship organizations, career information, test preparation, and site administration on our site. These linked sites have separate and independent privacy policies that you should read. We have no responsibility or liability for the content and activities of these linked sites, but we want to protect the integrity of our site and welcome any feedback about these linked sites (including if a specific link doesn\\u2019t work).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EChildren Under 13\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOur online programs are for those at least 13 years old.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe do not knowingly collect personally identifiable information online from children under 13. If you know of a child giving us this type of information online, please\\u0026nbsp;send us a message\\u0026nbsp;(\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/send-message\\u003C\\/strong\\u003E) or contact\\u0026nbsp;Customer Service (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us)\\u003C\\/strong\\u003E\\u0026nbsp;to have the account deactivated.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EInternational Users and Data Transfers\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWe are based in the U.S. and process data in the U.S.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board, its website, and its website servers are located and operated in the United States, requiring your information to be transferred from your location to the United States, which may not provide the same level of protection for your personally identifiable information as your home country. The information may be available to the United States government or its agencies under a lawful order in the United States. When you give information to College Board through this website for any reason or otherwise send us your personally identifiable information, including for any of the services we offer, you acknowledge a cross-border transfer of that information to the United States. In addition, College Board works with a trusted third-party service provider, Alorica, to provide customer service with contact centers in the United States and the Philippines. If you do not agree to this international transfer of data, you shouldn\\u2019t use the website and the services it offers or otherwise send us your personally identifiable information. If you choose to revoke your consent to such transfer, and this is the lawful basis for the processing, we may cease processing your information. Depending on the service you\\u2019re using the website for, it may impact your ability to apply or be accepted to a U.S. college or university.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn certain countries, data protection and privacy laws provide individuals with certain rights, such as the right to access, correct, request deletion of, restrict or object to the processing of, or portability of your personally identifiable information. To exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request?navId=gf-pc\\u003C\\/strong\\u003E) or email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E. If you exercise or seek to exercise any of those rights, our obligations to respond are limited by and subject to applicable law.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EEEA, UK and Brazil residents\\u2014please read the EEA, UK and Brazil Privacy Notice.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EChanges to Our Privacy Statement\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe sometimes update our Privacy Statement, so visit these pages periodically to review the latest changes. Policy changes will only apply to information collection after the date of change.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EContact Us\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you have any questions about this Privacy Statement or our privacy and data security practices, please contact us at \\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E. You may also contact us at:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E250 Vesey Street\\u003Cbr\\u003ENew York, NY 10281\\u003Cbr\\u003EPhone: (844) 849-3551\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u0026nbsp;\\u003C\\/h2\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EWebsite Terms and Conditions\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease also visit our Legal Terms for Students (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/student-legal-terms\\u003C\\/strong\\u003E) and Legal Terms for Educators and Institutions (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/educator-legal-terms\\u003C\\/strong\\u003E), which establish the use, disclaimers, and limitations of liability governing the use of our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EJurisdiction-Specific Privacy Supplements\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cspan class=\\u0022s3\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ENotice of Your California Privacy Rights\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECalifornia Residents\\u2014Your Privacy Rights:\\u0026nbsp;\\u003C\\/strong\\u003ECalifornia law (California Civil Code Section 1798.83) permits residents of California to opt out of College Board disclosure of personally identifiable information to third parties for marketing purposes at any time. College Board will not disclose your personally identifiable information to third parties for marketing without giving you notice and getting your consent. Please note\\u2014this opt-out doesn\\u2019t prohibit disclosures for non-marketing purposes. You can opt out for free by\\u0026nbsp;contacting us at \\u003Cstrong\\u003Eprivacy.collegeboard.org\\/contact-us\\u003C\\/strong\\u003E\\u0026nbsp;or writing to:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board\\u003Cbr\\u003E11955 Democracy Drive\\u003Cbr\\u003EReston, VA 20190\\u003Cbr\\u003EAttention: Student Search Service\\u003Cbr\\u003EPlease note that College Board is not subject to the California Consumer Privacy Act (CCPA) or the California Privacy Rights Act (CPRA) as a nonprofit organization.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECalifornia Do Not Track Disclosure\\u003C\\/strong\\u003E\\u003Cbr\\u003ESome browsers may be able to send a do not track signal to websites. The College Board site does not respond to do not track signals or similar mechanisms and requests.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003E\\u0026nbsp;\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EState Consumer Privacy Laws Supplemental Privacy Notice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003EThis supplemental privacy notice gives residents of certain states additional information required by their applicable consumer privacy laws, a current list of which is available on our Privacy Center.\\u003Cstrong\\u003E \\u003C\\/strong\\u003EThese provisions, together with the statements in the College Board privacy notices, explain our practices for processing residents\\u2019 personal data to the extent their state\\u2019s consumer privacy law applies. If there are material changes to the Privacy Statement or its State Consumer Privacy Laws Supplemental Privacy Notice, we will contact those as required by their state laws using their College Board account email address.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ESensitive Data: College Board may collect and process certain information defined as sensitive under applicable states laws. This may include your race and ethnicity to provide and personalize our programs and services and conduct research consistent with our mission, mental or physical health condition or diagnosis to process your request for testing accommodations, citizenship to process your CSS Profile application, and data about individuals under age 13 to provide programs requested by them.\\u0026nbsp; Further specificity on processing purposes for sensitive data will be provided to you through informed, express consent for any such processing as required by law. \\u0026nbsp;\\u003C\\/strong\\u003EYou may have the right to opt-out of the processing of sensitive data as part of our consumer programs and services, which you may do through our Consent Management Preferences Center at \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\/privacy\\u003C\\/strong\\u003E. You may also call Customer Service at 866-756-7346 or email \\u003Cstrong\\u003Einquiry@collegeboard.org\\u003C\\/strong\\u003E\\u0026nbsp;for further instructions or assistance with access to the Consent Management Preferences Center.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour Rights:\\u003C\\/strong\\u003E\\u0026nbsp;College Board respects your right to access, correct, and request deletion of your personally identifiable information and to portability of it as required by law. Depending on where you live, this means:\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have a right to know if College Board maintains your personally identifiable \\u0026nbsp;\\u0026nbsp;\\u0026nbsp;\\u0026nbsp;information. If we do, you have the right to access it and request that we provide you a copy of your information (subject to the rights of others) in a portable, and, to the extent technically feasible, readily usable format that allows you to transmit it to another entity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EIf your information is inaccurate, you have the right to ask us to update it.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou may ask us to delete your personally identifiable information.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou may ask us to identify third parties or categories of third parties to whom data may have been provided.\\u003Cbr\\u003E\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement and our Customer Service team will assist you. You may also go to \\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\u003C\\/strong\\u003E to access and correct certain personal data. Our ability to delete personal information will be limited when we\\u2019re required to retain records, as in connection with score reports and test security processes.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWhile not the \\u201csale\\u201d of data as defined under otherwise applicable state consumer privacy laws, College Board also respects your right to opt out of Student Search Service (Search). You can opt out of Search at any time by submitting the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), going to\\u0026nbsp;\\u003Cstrong\\u003Emy.collegeboard.org\\/profile\\/privacy\\u003C\\/strong\\u003E, contacting us at 866-825-8051, or emailing us at\\u0026nbsp;\\u003Cstrong\\u003ESearchCustomerService@collegeboard.org\\u003C\\/strong\\u003E.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may authorize someone to act on your behalf to exercise these rights, using the same methods described above. We may need to verify your identity, and any authorized agent authorized by you to act on your behalf, before we can process your request. College Board\\u2019s process to authenticate identity includes name, date of birth, and security phrase or security questions, as well as further validation processes, if necessary, including use of the phone number associated with the account.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf College Board does not take the action you requested when exercising these rights, you may appeal such inaction within a reasonable period after we have notified you of our denial of your request. To submit your appeal, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMarketing Cookies:\\u003C\\/strong\\u003E\\u0026nbsp;When you visit our website and with your consent, we place cookies on your computer. While College Board does not use data for targeted advertising as defined by state consumer privacy laws otherwise applicable to College Board, for convenience visitors to our site from certain states can opt out of cookies for nonessential website purposes when they first access our site, including marketing cookies. You may exercise your right to opt out of processing personal data for marketing cookies accessing the \\u201cManage Cookies\\u201d link at the footer of a College Board webpage or a floating cookie icon at the bottom of your screen while on our website. Please see the Cookies and Website Usage (\\u003Cstrong\\u003Eprivacy.collegeboard.org\\/privacy-statement\\/cookies-do-not-track-signals\\u003C\\/strong\\u003E) for more information about cookies and similar technologies.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003EEEA, UK and Brazil Supplemental Privacy Notice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis supplemental privacy notice gives those located in the European Economic Area (EEA), United Kingdom (UK), and Brazilian residents additional information required by local law. These provisions, together with the statements in the College Board privacy notices, explain our practices for processing EEA, UK, and Brazilian residents\\u2019 personal data.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003ECookies:\\u003C\\/strong\\u003E\\u0026nbsp;Visitors to our site from the EEA, UK and Brazil can opt out of cookies for nonessential website purposes when they first access our site. When you visit our website and with your consent, we place cookies on your computer. After you make selections through our cookie banner, you can manage options at any time here.\\u0026nbsp; This is also available to you through a \\u201cManage Cookies\\u201d link at the footer of a College Board webpage or a floating cookie icon at the bottom of your screen while on our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EPlease see the Cookies and Website Usage for more information about cookies and similar technologies.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis EEA, UK and Brazil Privacy Notice explains why we collect your personally identifiable information and how we process it. When necessary, we collect and process your information per the lawful bases described below:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003ETo fulfill a contract with you, for instance to provide a College Board test or a test offered by another company on behalf of College Board.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EWe may provide personally identifiable information to our operational third parties (processors) and other trusted businesses or persons to process it for us, based on our written instructions and in compliance with our Privacy Statement and any other appropriate confidentiality and security measures. For example, we use service providers to help process and score our tests.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003ETo process a payment, to create an account on our website, and for website management.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information with your consent to send you optional email communications, enroll you in Student Search Service, or send your scores to your designated recipients.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information for the purposes of our legitimate interests, if processing it doesn\\u2019t outweigh your rights and freedoms. We may process your personal information as needed to:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EProtect you, us, or others from threats (such as test security, security threats, or test fraud).\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EImprove College Board tests and support College Board research initiatives.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EEnable or administer our business, such as for quality control, consolidated reporting, and customer service.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EManage corporate transactions, such as mergers or acquisitions.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EUnderstand and improve our business, improve test integrity, and for research purposes.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EWe may also process your personally identifiable information to comply with applicable laws.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAutomated Decision Making and Profiling:\\u003C\\/strong\\u003E\\u0026nbsp;College Board may use automated processes in connection with scoring tests and for similar purposes, as needed to provide the test services you have requested, and for fraud prevention related to test security. All of these decisions are subject to human review. We will not make automated decisions about you that may significantly affect you, unless (a) the decision is necessary as part of a contract we have with you, (b) we have your explicit consent, or (c) we\\u2019re required by law to use the technology. You can learn more about test scoring by reading the information posted on our website about each of our tests. You can learn more about test security by reading the information posted on our website.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIn some cases, we use certain elements of personal data for College Board research. For example, we may consider how certain types of test takers (such as non-native English speakers) respond to specific test questions. Our research initiatives reflect our commitment to fairness and equity in testing, helping to ensure that our tests are accessible and free from bias. They also aim to improve teaching, learning, and assessment. Our research results do not contain any identifiable data and aren\\u2019t used to target or profile individuals. Visit\\u0026nbsp;\\u003Cstrong\\u003Eresearch.collegeboard.org\\u003C\\/strong\\u003E\\u0026nbsp;to learn more.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EYour Rights:\\u003C\\/strong\\u003E\\u0026nbsp;As stated in this EEA, UK and Brazil Privacy Notice, you always have the right to object to our optional email communications. To opt out of these emails, click the\\u0026nbsp;\\u003Cstrong\\u003EUnsubscribe\\u003C\\/strong\\u003E\\u0026nbsp;link at the bottom of any email we send you. And see the sections above related to communications and engagement for information about your choices and opting out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ECollege Board also respects your right to access, correct, and request erasure or restriction of your personally identifiable information as required by law. This means:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have a right to know if College Board maintains your personally identifiable information. If we do, we\\u2019ll give you a copy (subject to the rights of others). If your information is incorrect or incomplete, you have the right to ask us to update it.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s2\\u0022\\u003E\\u003C\\/span\\u003EYou have the right to object to our processing of your personally identifiable information.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EYou may also ask us to delete or restrict your personally identifiable information, including a copy of your information related to your right to data portability.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ETo exercise these rights, please complete the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E), email us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E,\\u0026nbsp;or write to us at the U.S. address provided in this Privacy Statement and our Customer Service team will assist you (we may need to verify your identity before we can process your request). Our ability to delete personal information will be limited when we\\u2019re required to retain records, as in connection with score reports and test security processes.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EIf you believe we have processed your personally identifiable information in violation of applicable law, you can file a complaint with the College Board Chief Privacy Officer by emailing\\u0026nbsp;\\u003Cstrong\\u003Eprivacy@collegeboard.org\\u003C\\/strong\\u003E or with a supervisory authority.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EData Retention: \\u003C\\/strong\\u003EWe\\u2019ll retain your personally identifiable information for as long as the information is needed for the purposes detailed above and for any additional period that may be required or permitted by law. You may request that we delete your personally identifiable information by completing the Your Privacy Choices webform (\\u003Cstrong\\u003Eform.collegeboard.org\\/f\\/data-subject-rights-request\\u003C\\/strong\\u003E) or emailing us at\\u0026nbsp;\\u003Cstrong\\u003EDataProtectionInquiry@collegeboard.org\\u003C\\/strong\\u003E. Unless we\\u2019re required by law to retain your information or have a legitimate interest in retaining it, we\\u2019ll delete it within 30 days of your request. If you ask us to delete your data you won\\u2019t be able to access any College Board account or test scores or send test scores to any colleges, universities, or any other third parties.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"id\":\"modal-privacy-cb-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-07-10T09:03:20-04:00\\u0022\\u003E1752152600\\u003C\\/time\\u003E\\n\"},{\"id\":\"416\",\"internal_id\":\"modal-approved-calcs-sat\",\"type\":\"functional_content\",\"title\":\"Approved Calculators\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EAcceptable Calculators\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003ECalculators permitted during testing include:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EThe Desmos calculator embedded in the Bluebook testing app:\\u0026nbsp;This is a powerful calculator that includes features similar to a handheld graphing calculator. If you are familiar with how to use this calculator, the embedded version is a good choice.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EGraphing calculators that do not include CAS features:\\u0026nbsp;This type of calculator includes plotting and graphing windows, data entry and storage windows, data analysis functions, trig functions, and programming options.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EScientific calculators:\\u0026nbsp;This type of calculator includes many functions helpful for solving problems in science, statistics, and math. Common features include built-in memory to store interim calculations, statistical functions, pi, trig functions, and scientific notation.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFour-function basic calculators (not recommended):\\u0026nbsp;This type of calculator includes four functions: add, subtract, multiply, and divide; some also include percentages and square roots. This type of calculator is not recommended as they typically do not follow order of operations.\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EProhibited Calculators\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003ECalculators with the following features are prohibited:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with built-in CAS functionality. Examples of such devices include:\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECasio: ClassPad 300, 330, or 400; ClassPad II (fx-CP400); ClassPad fx-CG 500 or fx-CG500; Algebra fx 2.0; all model numbers that begin with CFX-9970G.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EHewlett Packard: HP Prime; HP 48GII; all model numbers that begin with 40G, 49G, or 50G.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETexas Instruments: TI-Nspire CAS, TI-Nspire CX II CAS; All model numbers that begin with TI-89 or TI-92 or have \\u0022CAS\\u0022 in the model name. Note that TI-Nspire models that do not include \\u0022CAS\\u0022 in the name are acceptable.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with apps, menus, or programs that perform symbolic algebra manipulation (e.g., solving algebra equations symbolically).\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators with QWERTY keyboards.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDevices with wireless internet capability, Bluetooth, or cellular connectivity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDevices with built-in cameras or audio\\/video recording.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETablets and laptop computers.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EElectronic writing pads or pen-input devices.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECell phone calculator apps.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ECalculators that use paper tape.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\",\"id\":\"modal-approved-calcs-sat-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-06-05T12:57:05-04:00\\u0022\\u003E1749142625\\u003C\\/time\\u003E\\n\"},{\"id\":\"406\",\"internal_id\":\"checkin-lockdown-accomms\",\"type\":\"functional_content\",\"title\":\"We\\u0027re About to Lock Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYou may use any assistive technology that you\\u2019re approved for.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003EIf you attempt to use any other programs or apps during the exam, your scores will be canceled.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"checkin-lockdown-accomms-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-11-30T17:32:36-05:00\\u0022\\u003E1701383556\\u003C\\/time\\u003E\\n\"},{\"id\":\"386\",\"internal_id\":\"exam-preview-intro-ap\",\"type\":\"functional_content\",\"title\":\"AP Test Preview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch2\\u003EExplore the Bluebook App\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EExperience the question types and try out the tools. You won\\u2019t receive scores or any feedback on your answers.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-search\",\"id\":\"exam-preview-intro-sat-p1\"},{\"content\":\"\\u003Ch2\\u003ETake Your Time\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EThe sections in this preview are untimed with a 1-minute break in between. On test day, a timer will be running, and there will be a break between sections.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-pending\",\"id\":\"exam-preview-intro-sat-p2\"},{\"content\":\"\\u003Ch2\\u003ETest Your Assistive Technology\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EYou may use assistive technology with the preview. If you\\u2019re approved for extra time or breaks, you\\u2019ll get that on test day but not in this preview.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-accessible\",\"id\":\"exam-preview-intro-sat-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-07-18T11:46:55-04:00\\u0022\\u003E1658159215\\u003C\\/time\\u003E\\n\"},{\"id\":\"381\",\"internal_id\":\"exam-preview-intro-sat\",\"type\":\"functional_content\",\"title\":\"SAT Test Preview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch2\\u003EExplore the Bluebook App\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EExperience the question types and try out the tools. You won\\u2019t receive scores or any feedback on your answers.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-search\",\"id\":\"exam-preview-intro-sat-p1\"},{\"content\":\"\\u003Ch2\\u003ETake Your Time\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EThe sections in this preview are untimed with a 1-minute break in between. On test day, a timer will be running, and there will be a break between sections.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-pending\",\"id\":\"exam-preview-intro-sat-p2\"},{\"content\":\"\\u003Ch2\\u003ETest Your Assistive Technology\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003EYou may use assistive technology with the preview. If you\\u2019re approved for extra time or breaks, you\\u2019ll get that on test day but not in this preview.\\u003C\\/p\\u003E\",\"icon\":\"color_icon:cb-accessible\",\"id\":\"exam-preview-intro-sat-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-10-05T10:15:34-04:00\\u0022\\u003E1664979334\\u003C\\/time\\u003E\\n\"},{\"id\":\"371\",\"internal_id\":\"checkin-overview-ap-world-hist\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe AP World History: Modern Exam has 2 sections and lasts 3 hours and 15 minutes. Section I has 2 parts.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection I, Part A: Multiple Choice\\u003C\\/h2\\u003E\\u003Cp\\u003EThe multiple-choice part has 55 questions and lasts 55 minutes. This part represents 40% of your total score. Your score on the multiple-choice part is based on the number of questions answered correctly. Points are not deducted for incorrect answers or unanswered questions.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection I, Part B: Short Answer\\u003C\\/h2\\u003E\\u003Cp\\u003EThe short-answer part has 3 short-answer questions and lasts 40 minutes. This part represents 20% of your total score for the exam, and each of the 3 questions counts equally toward your score.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection II: Free Response\\u003C\\/h2\\u003E\\u003Cp\\u003EThe free-response section has 1 document-based question (DBQ) and 1 long essay question and lasts 1 hour and 40 minutes. This section represents 40% of your total score for the exam. The DBQ represents 25% of your score on the exam, and the long essay question represents 15% of your score on the exam.\\u003C\\/p\\u003E\\u003Ch2\\u003ETaking the Exam\\u003C\\/h2\\u003E\\u003Cp\\u003EEach section and part is timed separately. You can go back and forth between questions in a section or part until time expires. The clock will turn red when 5 minutes remain in the section or part\\u2014\\u003Cem\\u003Ethe proctor will not give you any time updates or warnings\\u003C\\/em\\u003E. You cannot move ahead to a different section or part. Once time expires in a section or part, you cannot return to it.\\u003C\\/p\\u003E\\u003Cp\\u003EYou may use scratch paper for notes and planning, but credit will only be given for responses entered in this application. Any text you enter as an annotation will \\u003Cem\\u003Enot\\u003C\\/em\\u003E be included in your answer submissions. When time expires in a section or part, all answers you have already entered will be submitted.\\u003C\\/p\\u003E\\u003Cp\\u003ESource materials may have been edited for the purpose of this exam.\\u003C\\/p\\u003E\\u003Cp\\u003EThe inclusion of source material in this exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP World History: Modern Exam represent a range of different authors, historical periods, and perspectives, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze perspectives that may be different from their own and to analyze and interpret sources in historical context.\\u003C\\/p\\u003E\\u003Cp\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-ap-world-hist-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-11-20T10:18:18-05:00\\u0022\\u003E1763651898\\u003C\\/time\\u003E\\n\"},{\"id\":\"376\",\"internal_id\":\"checkin-overview-ap-eng-lit\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe AP English Literature and Composition Exam has 2 sections and lasts 3 hours.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection I: Multiple Choice\\u003C\\/h2\\u003E\\u003Cp\\u003EThe multiple-choice section has 55 questions and lasts 1 hour. This section represents 45% of your total score. Your score on the multiple-choice section is based on the number of questions answered correctly. Points are not deducted for incorrect answers or unanswered questions.\\u003C\\/p\\u003E\\u003Ch2\\u003ESection II: Free Response\\u003C\\/h2\\u003E\\u003Cp\\u003EThe free-response section has 3 questions and lasts 2 hours. This section represents 55% of your total score. Each of the 3 questions counts equally toward your score.\\u003C\\/p\\u003E\\u003Ch2\\u003ETaking the Exam\\u003C\\/h2\\u003E\\u003Cp\\u003EEach section is timed separately. You can go back and forth between questions in a section until time expires. The clock will turn red when 5 minutes remain in the section\\u2014\\u003Cem\\u003Ethe proctor will not give you any time updates or warnings\\u003C\\/em\\u003E. You cannot move ahead to a different section. Once time expires in a section, you cannot return to it.\\u003C\\/p\\u003E\\u003Cp\\u003EYou may use scratch paper for notes and planning, but credit will only be given for responses entered in this application. Any text you enter as an annotation will \\u003Cem\\u003Enot\\u003C\\/em\\u003E be included in your answer submissions. When time expires in a section, all answers you have already entered will be submitted.\\u003C\\/p\\u003E\\u003Cp\\u003EThe inclusion of source material in this exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The literary works and excerpts that appear in the AP English Literature and Composition Exam represent a range of different authors and literary styles and themes, as appropriate for measuring the critical reading and analytic writing skills that are the focus of this college-level course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze perspectives that may be different from their own and to question the meaning, purpose, or effect of such content within literary works.\\u003C\\/p\\u003E\\u003Cp\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-ap-eng-lit-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-11-20T09:38:40-05:00\\u0022\\u003E1763649520\\u003C\\/time\\u003E\\n\"},{\"id\":\"272\",\"internal_id\":\"sat-pilot-terms-conds\",\"type\":\"help_detail\",\"title\":\"SAT Pilot Terms \\u0026 Conditions\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EIntroduction\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThese Terms and Conditions (\\u201cTerms and Conditions\\u201d or \\u201cAgreement\\u201d) are a legal contract between you and College Board (\\u201cCollege Board\\u201d or \\u201cwe\\u201d). They set forth important rules and policies you must follow related to taking the Pilot\\u0026nbsp;SAT\\u0026nbsp;(\\u201cPilot\\u201d). Please read these carefully. If you register for the Pilot on behalf of another (for example, if you are a parent or legal guardian of the test taker), these Terms and Conditions govern both you and the test taker (collectively, \\u201cyou\\u201d).\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EBackground. The purpose of the Pilot is to provide information to\\u0026nbsp;College\\u0026nbsp;Board relating to its internal test development process. The Pilot will be provided\\u0026nbsp;digitally,\\u0026nbsp;and it\\u0026nbsp;will allow College Board, including its SAT\\u00ae (\\u201cSAT\\u201d) program, to test certain questions\\u0026nbsp;and\\u0026nbsp;the digital\\u0026nbsp;format\\u0026nbsp;of the assessment.\\u0026nbsp; You will not receive scores or feedback on your responses nor can the Pilot be used by you for\\u0026nbsp;college admission,\\u0026nbsp;placement, scholarships,\\u0026nbsp;or other purposes.\\u0026nbsp; You understand that this exam is a pilot and College Board is under no obligation to include the format or new questions in a generally available offering.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EAdditional COVID-19 related requirements may be communicated to you prior to or on test day. You agree to abide by such requirements.\\u0026nbsp;\\u003Cbr\\u003E\\n\\u0026nbsp;\\u003Cbr\\u003E\\n\\u003Cstrong\\u003EAll disputes between you and\\u0026nbsp;College\\u0026nbsp;Board will be resolved through binding arbitration in accordance with Section\\u0026nbsp;8\\u0026nbsp;of this Agreement. You understand that by agreeing to arbitration, you are waiving your right to resolve disputes in a court of law by a judge or jury.\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection 1.\\u0026nbsp;Preparing to Take\\u0026nbsp;the\\u0026nbsp;Pilot\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EThe Pilot is taken at a\\u0026nbsp;testing\\u0026nbsp;center.\\u0026nbsp;The Pilot is administered on a digital testing platform (\\u201cPilot App\\u201d) that you download to your testing device.\\u0026nbsp;\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EYou will need a\\u0026nbsp;Personal PC laptop or Mac Laptop\\u0026nbsp;(your \\u201cTesting Device\\u201d)\\u0026nbsp;that connects\\u0026nbsp;to\\u0026nbsp;Wi-Fi. You cannot take the Pilot on a Chromebook, tablet, mobile phone,\\u0026nbsp;or on a school managed device.\\u0026nbsp; Your\\u0026nbsp;testing device\\u0026nbsp;must\\u0026nbsp;run\\u0026nbsp;Windows 8 or later (PC users) or Mac OS 10.11 or later (Mac users). You may need to update your operating system.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EYou will need to download the Pilot App to your\\u0026nbsp;Testing\\u0026nbsp;Device and complete Exam Setup not later than the day before the Pilot.\\u0026nbsp; The Pilot App will be available for download starting five days before the Pilot.\\u0026nbsp; When\\u0026nbsp;you\\u0026nbsp;complete\\u0026nbsp;exam\\u0026nbsp;setup, the Pilot App will generate an admissions\\u0026nbsp;ticket.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EOn the day of the Pilot,\\u0026nbsp;you will need to\\u0026nbsp;physically\\u0026nbsp;check\\u0026nbsp;in\\u0026nbsp;to the\\u0026nbsp;test\\u0026nbsp;center at the designated time using your admissions\\u0026nbsp;ticket.\\u0026nbsp;\\u0026nbsp;You may use your mobile phone to display your admissions\\u0026nbsp;ticket, however phones will be collected prior to testing and returned at the end of the test. You must bring a current government-issued or school-issued photo ID.\\u0026nbsp; Additional ID may be required by the\\u0026nbsp;test\\u0026nbsp;center.\\u0026nbsp; If you have been approved for testing accommodations, you will need your SSD Student Accommodations Letter.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EOnce in your testing room,\\u0026nbsp;you will need to\\u0026nbsp;complete\\u0026nbsp;Pilot\\u0026nbsp;App check-in\\u0026nbsp;on your\\u0026nbsp;Testing\\u0026nbsp;Device, for which you will first need to connect to the\\u0026nbsp;test\\u0026nbsp;center\\u2019s Wi-Fi network.\\u0026nbsp;The exam will begin as soon as you successfully enter the exam start code into the application.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EYour\\u0026nbsp;Testing\\u0026nbsp;Device must be fully charged. If your testing device does not have at least three hours of battery life, you may wish to bring a portable charger. The\\u0026nbsp;test\\u0026nbsp;center is not responsible for device charging.\\u0026nbsp;\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection 2.\\u0026nbsp; Taking the Pilot\\u0026nbsp;\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003E\\u003Cstrong\\u003ENavigating the Pilot Questions.\\u0026nbsp;\\u003C\\/strong\\u003EEach section of the Pilot has two parts, called\\u0026nbsp;modules. Once you move on from\\u0026nbsp;a module,\\u0026nbsp;you cannot\\u0026nbsp;return to\\u0026nbsp;any questions from it.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003E\\u003Cstrong\\u003EManaging Your Time\\u003C\\/strong\\u003E.\\u0026nbsp;The\\u0026nbsp;Pilot App\\u0026nbsp;will have a timer, counting down the minutes and seconds remaining in each\\u0026nbsp;module. You can hide the timer, but once there are 5 minutes remaining, you cannot hide the timer.\\u0026nbsp;When time expires, your work\\u0026nbsp;will be automatically saved and submitted. You will not be able to keep working on a question after time expires.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003E\\u003Cstrong\\u003EAnswer Submission\\u003C\\/strong\\u003E. You will enter your answers in the Pilot\\u0026nbsp;App.\\u202fYou cannot work in any other program or application while the test is running, and you cannot paste work into the Pilot\\u0026nbsp;App from another program or application. You will not be submitting any handwritten work, and you will not be uploading any files or photos. Your answers are \\u201csubmitted\\u201d when they are received by College Board.\\u202f If your testing device is connected to the internet when the exam ends, your answers will be automatically submitted to\\u0026nbsp;College\\u0026nbsp;Board.\\u202f If your device is NOT connected to the internet when the test ends, you will need to connect to the internet and follow directions in the Pilot\\u0026nbsp;App.\\u202f\\u0026nbsp;Answers must be received by College Board immediately after the Pilot, but in every event, must be received within\\u0026nbsp;5 days of the end of the test.\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;3.\\u0026nbsp;Prohibited Items\\u0026nbsp;\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EYou\\u202f\\u003Cstrong\\u003Emay not bring\\u003C\\/strong\\u003E\\u202fprohibited items to the\\u0026nbsp;Pilot. Prohibited items include, but are not limited to:\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EMobile phones*,\\u0026nbsp;smartwatches*, fitness trackers, or other wearable technology (simple digital non-smartwatches or analog watches are acceptable).\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003E\\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; *You can bring mobile phones and\\u0026nbsp;smartwatches\\u0026nbsp;(to\\u0026nbsp;show your admission ticket\\u0026nbsp;at check-\\u0026nbsp; \\u0026nbsp;\\u003Cbr\\u003E\\n\\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp;\\u0026nbsp;in)\\u0026nbsp;but\\u0026nbsp;you\\u0026nbsp;will be required to be store\\u0026nbsp;them or they will be\\u0026nbsp;or collected\\u0026nbsp;during the Pilot in accordance\\u003Cbr\\u003E\\n\\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp; \\u0026nbsp;\\u0026nbsp;with the test center\\u2019s collection process.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EAudio players or recorders, tablets, laptops, notebooks, Bluetooth devices (e.g., wireless earbuds\\/ headphones), or any other personal computing devices\\u0026nbsp;other than your Testing Device\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ESeparate timers of any type\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ECameras or any other photographic equipment\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EBooks or references\\u0026nbsp;of any kind except as approved as an English language learner support for in-school administrations\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ECompasses, rulers, protractors, or cutting devices\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EPapers of any kind\\u0026nbsp;(scratch paper\\u0026nbsp;will be provided by a test proctor)\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ECalculators (the Pilot\\u0026nbsp;App\\u0026nbsp;has a built-in calculator)\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EEarplugs\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EWeapons or firearms.\\u202f\\u202f\\u202f\\u202f\\u202f\\u0026nbsp;\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003ENOTE: Some exceptions to the above may apply if a test taker has received a College Board\\u2013approved accommodation.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;4. Prohibited Behaviors\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EYou\\u202f\\u003Cstrong\\u003Emay not engage\\u003C\\/strong\\u003E\\u202fin the prohibited behaviors set forth below:\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EAttempting to cheat or otherwise obtain an unfair advantage on the\\u0026nbsp;Pilot.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EObtaining, or attempting to obtain, improper access to the\\u0026nbsp;Pilot, or a part of the\\u0026nbsp;Pilot, or information about the\\u0026nbsp;Pilot.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EAccessing or attempting to access\\u0026nbsp;a phone, electronic device or\\u0026nbsp;any\\u0026nbsp;other\\u0026nbsp;Prohibited Items\\u0026nbsp;during testing or during breaks.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ELeaving the testing room, building, or designated break area without permission and\\/or taking an unapproved extended break.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EReproducing or attempting to reproduce any portion of any\\u0026nbsp;Pilot\\u0026nbsp;in any form (e.g., by taking photos or making photocopies).\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ESharing\\u0026nbsp;Pilot\\u0026nbsp;content during or after the exam through any means, including, but not limited to, email, text messages, phone calls, photographs, social media, or the internet.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EHaving subject-related information on your clothing, shoes, or body.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EUsing testing accommodations not approved by\\u0026nbsp;College\\u0026nbsp;Board.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EAttempting to remove from the testing room any\\u0026nbsp;scratch paper or\\u0026nbsp;notes related to the\\u0026nbsp;Pilot.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ECopying the work of another student.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ESubmitting any work that is not entirely your own.\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EAttempting to give or get assistance, or otherwise communicate, through any means, with another person about the\\u0026nbsp;Pilot, during the\\u0026nbsp;Pilot\\u0026nbsp;administration, or after the\\u0026nbsp;Pilot\\u0026nbsp;administration.\\u0026nbsp;\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EAttempting to take or taking the exam for someone else.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EAttempting to have or having someone else take the exam on your behalf.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003ECreating a disturbance.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EEngaging in confrontational, threatening or unruly behavior, conduct or communication toward or concerning any test taker, test administrator or proctor, or employee of College Board or its vendors\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EFailing to follow any of the test administration rules set forth in these Terms and Conditions, the Instructions, or in other registration materials, or directions given by the testing staff.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EConsume food or drink in unauthorized areas\\/times.\\u0026nbsp;\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;5.\\u0026nbsp;Privacy\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003E(a) Privacy Policies\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003ECollege Board recognizes the importance of protecting your privacy. Our privacy policies located at\\u202f\\u003Cstrong\\u003Ecollegeboard.org\\/privacy-center\\u003C\\/strong\\u003E\\u202f(\\u201c\\u003Cstrong\\u003E\\u003Cem\\u003EPrivacy Policies\\u003C\\/em\\u003E\\u003C\\/strong\\u003E\\u201d)\\u0026nbsp;are part of these Terms and Conditions. You consent to College Board\\u2019s collection, use, and disclosure of your personally identifiable information as described in the Privacy Policies and in these Terms and Conditions. College Board may update its Privacy Policies from time to time and they are subject to change up to one week prior to your test date. You are required to review the Privacy Policies located at\\u202f\\u003Cstrong\\u003Ecollegeboard.org\\/privacy-center\\u003C\\/strong\\u003E\\u202fprior to taking the\\u0026nbsp;Pilot.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003E(b) Testing\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ei. Device Data: When you download and use the\\u0026nbsp;Pilot\\u0026nbsp;App, College Board will receive certain information about your device, including device type, operating system type and version, applications and processes running on your device, screen size and resolution, running processes, available memory, and other information to ensure the device is compatible.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eii. Activity Data: We also monitor the actions you take in the\\u0026nbsp;Pilot\\u0026nbsp;App, including your responses, where you click, how long you spend on each page, and how you navigate through the\\u0026nbsp;Pilot\\u0026nbsp;\\u0026nbsp;App.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eiii. Device Data and Activity Data (collectively, \\u201cPilot\\u0026nbsp;Test Data\\u201d) may be used for College Board\\u2019s test security purposes as well as to develop and improve College Board products and services.\\u0026nbsp;Pilot\\u0026nbsp;Test Data may be disclosed to trusted vendors, but only in their provision of services to College Board.\\u0026nbsp;Pilot\\u0026nbsp;Test Data is not sold or licensed to third parties including without limitation for their marketing purposes. You will also be asked to type specific sentences in the\\u0026nbsp;Pilot\\u0026nbsp;App. Those typed sentences are not used for biometric identification.\\u0026nbsp;\\u202f\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;6. Miscellaneous\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ea. In the event of a test security related concern, public health threat, natural disaster, terrorist act, civil unrest, epidemic, or other unexpected events or circumstances, College Board may cancel testing for all or a specific group of test takers. In addition, College Board may cancel at any time due to issues related to COVID-19 in College Board\\u2019s sole discretion. If this occurs, College Board will notify you in advance, if feasible.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eb. To ensure the integrity of the\\u0026nbsp;Pilot, for security reasons, or for other reasons in our sole discretion, College Board reserves the right to bar any individual or group of individuals from registering for and\\/or taking any College Board assessment.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ec. College Board reserves the right to contact any appropriate individuals or agencies\\u2014including your high school\\u2014if we believe you may be in imminent danger of harming yourself or others, based on any information you provide to College Board, including in your responses to\\u0026nbsp;Pilot\\u0026nbsp;questions. We might also provide other content, along with your personal information, to those we contact.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ed. Each College Board contractor is a third-party beneficiary and is entitled to the rights and benefits under this Agreement and may enforce the provisions of this Agreement as if it were a party to this Agreement.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ee. College Board is not responsible for providing an internet connection or for internet service interruptions or errors outside of College Board\\u2019s control, such as data transmission errors on the public internet.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ef. College Board is not responsible for any equipment failures.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eg. College Board is not responsible for personal property, including prohibited items, brought to the\\u0026nbsp;Pilot\\u0026nbsp;that are lost, stolen, or damaged.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eh. College Board is not responsible for your failure to follow directions and instructions relating to the taking the\\u0026nbsp;Pilot.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ei. After\\u0026nbsp;successfully\\u0026nbsp;completing the Pilot,\\u0026nbsp;we\\u0026nbsp;will send you a link to a survey\\u0026nbsp;via email\\u0026nbsp;and upon your completion of the survey, you will receive a US $100 gift card (or other gift as communicated to you) as\\u0026nbsp;a\\u0026nbsp;thank\\u0026nbsp;you for\\u0026nbsp;your participation in the Pilot.\\u0026nbsp;\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;7. Intellectual Property Rights\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ea. The Pilot,\\u0026nbsp;all College Board tests,\\u0026nbsp;pilot tests,\\u0026nbsp;test-related documents and materials, and test preparation materials (\\u201c\\u003Cstrong\\u003E\\u003Cem\\u003ETest Content\\u003C\\/em\\u003E\\u003C\\/strong\\u003E\\u201d) are copyrighted works owned by College Board and protected by the laws of the United States and other countries.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eb. All software, webpages, algorithms, processes, and technologies, including the\\u0026nbsp;Pilot\\u0026nbsp;App, through which you access and take the\\u0026nbsp;Pilot, your answers are scored, and the test is secured and proctored, but excluding your device, your internet service provider (ISP) and the public internet, (collectively, the \\u201c\\u003Cstrong\\u003E\\u003Cem\\u003ETest Platform\\u003C\\/em\\u003E\\u003C\\/strong\\u003E\\u201d) belong to College Board and its licensors.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ec. You shall not screenshot or attempt to make any image, copy, or download\\u0026nbsp;Pilot\\u0026nbsp;Test Content or the\\u0026nbsp;Pilot\\u0026nbsp;Test Platform. You shall not attempt to decompile, reverse engineer, or dissemble the\\u0026nbsp;Pilot\\u0026nbsp;Test Platform.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ed. All answers and answer documents you submit including all essay responses, portfolios, and audio or visual work are owned by the College Board, and these may be used by College Board for any purpose, subject to the Privacy Policies located at\\u202f\\u003Cstrong\\u003Ecollegeboard.org\\/privacy-center\\u003C\\/strong\\u003E, and in these Terms and Conditions.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;8. ARBITRATION OF DISPUTES AND CLASS ACTION WAIVER\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ea. All disputes between you and College Board and\\/or any or all of its contractors that relate in any way to registering for, participating in, or taking\\u0026nbsp;Pilot\\u0026nbsp;, but excluding all claims that a party violated the intellectual property rights of the other party, shall exclusively be resolved by a single arbitrator through binding, individual arbitration administered by the American Arbitration Association (\\u201cAAA\\u201d) under the AAA Consumer Arbitration Rules in effect at the time a request for arbitration is filed with the AAA. Copies of the AAA Rules can be located at adr.org. Any dispute as to arbitrability shall be resolved by the arbitrator.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Eb. Arbitration will be conducted on a documents-only basis (i.e., there will be no in-person or telephone hearing) unless otherwise agreed by the parties or required by the arbitrator. Should the parties agree to or the arbitrator requires proceedings, such proceedings should be conducted at a location which is reasonably convenient to both parties with due consideration of their ability to travel and other pertinent circumstances. If the parties are unable to agree on a location, the parties agree that the proceedings will be conducted via a video or telephonic call or, in the event that face-to-face proceedings are agreed to by the parties or required by the arbitrator, at a location that is reasonably convenient to both parties in accordance with the AAA Consumer Arbitration Rules.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ec. The parties agree that the Federal Arbitration Act (\\u201cFAA\\u201d) 9 U.S.C. \\u00a7 1 et seq. governs this provision, and it is the intent of the parties that the FAA shall preempt all State laws to the fullest extent permitted by law. New York law otherwise applies to these Terms and Conditions, without regard\\u0026nbsp;to choice-of-law principles.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ed. No arbitration may be maintained as a class or collective action, and the arbitrator shall not have the authority to combine or aggregate the disputes of more than one individual, conduct any class or collective proceeding, make any class or collective award, or make an award to any person or entity not a party to the arbitration, without the express written consent of College Board.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ee. By agreeing to arbitration in accordance with this section, you are waiving your right to have your dispute heard by a judge or jury.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003Ef. Each party will be responsible for its own fees and expenses and any legal fees incurred in connection with the arbitration. This does not preclude the arbitrator from granting relief in accordance with AAA Consumer Arbitration Rules.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;9. Governing Law, Venue and Waiver of Jury Trial\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EThis Agreement shall be governed by the laws of the state of New York without regard\\u0026nbsp;to choice\\u0026nbsp;or conflict of law principles. All disputes arising from or related to this Agreement that are not subject to arbitration under Section\\u0026nbsp;8\\u0026nbsp;shall be resolved exclusively in the state and federal courts located in New York County, New York State and each party to this Agreement irrevocably consents to the jurisdiction of such courts. Each Party expressly waives any right to a jury trial in any lawsuit arising from or related to this Agreement.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;10. LIMITATION OF LIABILITY\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EEXCEPT TO THE EXTENT FINALLY DETERMINED TO BE PROHIBITED BY LAW,\\u0026nbsp;IN NO WAY SHALL\\u0026nbsp;COLLEGE BOARD\\u0026nbsp;OR\\u0026nbsp;ITS AGENTS\\u0026nbsp;OR\\u0026nbsp;CONTRACTORS\\u0026nbsp;HAVE ANY LIABILITY WHATSOEVER\\u0026nbsp;FOR ANY CLAIMS, LOSSES, COSTS, OR DAMAGES\\u0026nbsp;INCLUDING DIRECT, INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR EXEMPLARY DAMAGES (EVEN IF WE HAVE BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES) IN CONTACT, TORT, OR OTHERWISE,\\u0026nbsp;ARISING OUT OF OR RESULTING FROM OR IN ANY WAY RELATED TO COLLEGE BOARD, OR ANY TEST ADMINISTRATION BY COLLEGE BOARD.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection\\u0026nbsp;11. DISCLAIMER OF WARRANTIES\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003ECOLLEGE BOARD MAKES NO WARRANTIES REGARDING THE\\u0026nbsp;PILOT, EXAM CONTENT, OR TESTING APPLICATION INCLUDING WITHOUT LIMITATION A WARRANTY THAT THE TESTING EXPERIENCE WILL BE UNINTERRUPTED OR ERROR FREE. YOU ACCEPT THE\\u0026nbsp;PILOT, EXAM CONTENT, AND TESTING APPLICATION AS IS.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection 12. Severability\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf any section or part of this Agreement is held to be invalid, illegal, or unenforceable, the remaining sections or parts will nevertheless continue in full force and effect without being impaired or invalidated in any way and to the extent possible, the invalid, illegal, or unenforceable provision shall be modified so that it is valid, legal, and enforceable and, to the fullest extent, reflects the intention of the parties.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection 13. Restricted Registrations\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003ECollege Board, along with our service providers outside of the U.S., is subject to U.S. economic sanctions, laws, and regulations and is prohibited from providing testing services to, or accepting registrations from, persons residing in certain areas or designated by the U.S. government as Specially Designated Nationals and Blocked Persons (collectively, \\u201c\\u003Cstrong\\u003E\\u003Cem\\u003ESanctioned Persons\\u003C\\/em\\u003E\\u003C\\/strong\\u003E\\u201d), unless specifically licensed or otherwise authorized by the U.S. government. If a Sanctioned Person attempts to register despite U.S. sanctions that prohibit College Board from doing business with such Sanctioned Person, College Board or a U.S. financial institution may block the registration or payments submitted by or for such Sanctioned Persons. If payment is not blocked,\\u0026nbsp;College\\u0026nbsp;Board will cancel the registration and may not be able to refund the payment.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EPlease contact Customer Service\\u0026nbsp;at\\u0026nbsp;877-348-5728\\u0026nbsp;(+1-212-307-9731\\u0026nbsp;internationally)\\u0026nbsp;or visit\\u202fOFAC\\u2019s website (\\u003Cstrong\\u003Ehttps:\\/\\/home.treasury.gov\\/policy-issues\\/financial-sanctions\\/sanctions-programs-and-country-information\\u003C\\/strong\\u003E)\\u202fto obtain the current list of sanctioned programs and Sanctioned Persons.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESection 14. Accessibility of These Terms and Conditions\\u003C\\/strong\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you have difficulty accessing these Terms and Conditions, including our policies and requirements, please contact\\u0026nbsp;Customer Service\\u0026nbsp;at\\u0026nbsp;877-348-5728\\u0026nbsp;(+1-212-307-9731\\u0026nbsp;internationally)\\u0026nbsp;or\\u0026nbsp;email\\u0026nbsp;\\u003Cstrong\\u003Edigitaltesting@collegeboard.org\\u0026nbsp;\\u003C\\/strong\\u003Ein advance of registering for or taking the\\u0026nbsp;Pilot. We will be happy to provide these Terms and Conditions in an alternative format or assist you in some other manner as reasonably necessary to enable you to access these Terms and Conditions.\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-10-07T15:45:16-04:00\\u0022\\u003E1633635916\\u003C\\/time\\u003E\\n\"},{\"id\":\"271\",\"internal_id\":\"in-app-calculator\",\"type\":\"help_detail\",\"title\":\"In-App Calculator\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cimg src=\\u0027data:image\\/svg+xml;base64,\\u0027  alt=\\u0022\\u0022 \\/\\u003E \\u003Cstrong\\u003ECalculator\\u003C\\/strong\\u003E: On all math questions, you\\u0027ll find a built-in calculator at the top right of the screen (you can also use your own approved calculator). On some exams, you\\u0027ll see more than one kind of calculator\\u2014use whichever one you prefer.\\u003C\\/p\\u003E\\n\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-07-28T10:03:59-04:00\\u0022\\u003E1753711439\\u003C\\/time\\u003E\\n\"},{\"id\":\"270\",\"internal_id\":\"digital-testing-accomms-sat\",\"type\":\"help_detail\",\"title\":\"Digital Testing Accommodations: SAT Suite\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003ESome testing accommodations work differently on the digital SAT than on the paper version of the test. Other accommodations may not be needed for a digital SAT. On your personal info page, Bluebook will list only the accommodations that apply to your digital SAT.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp\\u003EIf you\\u2019re approved for one of these accommodations, here\\u2019s how it\\u2019ll work in Bluebook.\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAccommodation\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHow it Works in Bluebook\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtended Time\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cp\\u003EYou\\u2019ll receive your approved amount of extended time and extra breaks. Once the standard time has elapsed on a module, section or part, you can move on when you are ready.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EExtended time for reading will be applied to the entire test. Extended time for math will only be applied to the Math section. \\u003Cstrong\\u003ENote:\\u003C\\/strong\\u003E For SAT Weekend, if you\\u2019re approved for up to time and one-half and double time, you\\u2019ll test in a test center on a Saturday or Sunday.\\u003C\\/p\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBreaks as Needed\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW175999598 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou\\u2019ll be able to pause the test time to take breaks as needed. The pause button appears below the timer.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW175999598 BCX0\\u0022\\u003E \\u003C\\/span\\u003E\\u003Cspan class=\\u0022NormalTextRun SCXW122385527 BCX0\\u0022\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtended Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYour section break will be twice as long as other test takers\\u2019. \\u003Cspan class=\\u0022NormalTextRun SCXW122385527 BCX0\\u0022\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtra Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou\\u2019ll get an extra 5-minute break between modules 1 and 2 in each section. \\u003Cspan class=\\u0022NormalTextRun SCXW122385527 BCX0\\u0022\\u003EThere is no pause button; you will simply take the length of break that is applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EExtra and Extended Breaks\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYour section break will be twice as long as other test takers\\u2019, and you\\u2019ll have extra breaks. \\u003Cspan class=\\u0022NormalTextRun SCXW119904727 BCX0\\u0022\\u003EThere is no pause button; you simply take the extra breaks for the length of time applied in Bluebook.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBraille (Refreshable Braille for Digital)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW111796862 BCX0 NormalTextRun CommentStart\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use a \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW111796862 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Escreen reader, text-to-speech or refreshable braille. If you use a screen reader or text-to-speech, you\\u2019ll need to use headphones, too.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW111796862 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ERaised Line Drawings\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou\\u2019ll take the test in Bluebook, and you\\u2019ll receive a raised line supplement.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBraille Writer\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou\\u2019ll use braille writing software to take the test.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ELarge-Print Exam, Large Print Answer Sheet, Magnification Device (Electronic\\/Non-Electronic)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can zoom using your device\\u2019s native controls (Control +\\/- on a PC; Command +\\/- on a Mac; pinch and zoom on an iPad).\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EColor Overlay\\/Color Contrast\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use the color settings available through your operating system and\\/or device screen, or you can use a plastic overlay attached to your device\\u0027s screen.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHuman Reader for Digital Tests\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cp class=\\u0022Paragraph SCXW70231416 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW70231416 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EMost students who use a human reader for paper exams are approved for Text-to-Speech (Embedded) and\\/or Screen Reader (Non-Embedded) for digital tests and will test digitally. You \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackedChange SCXW70231416 BCX0 TextRun NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Ewill use the built-in text-to-speech tool in Bluebook or the screen reader available through your device\\u0027s operating system or any College Board\\u2013approved screen reader software. \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW70231416 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIn rare conditions, a student who is unable to test with text-to-speech or a screen reader may be approved in SSD Online for the accommodation of human reader for digital tests.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EScreen Reader (Non-Embedded)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW252643944 BCX0 NormalTextRun CommentStart\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use the screen reader available through your device\\u0027s operating system \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW252643944 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Eor any College Board approved screen reader software (JAWS, NVDA, etc.). In addition to reading all text (reading passages, math problems and equations, and multiple-choice response questions\\/answers), your screen reader will also read all properties of the page (headers, footers, punctuation) and provide detailed descriptions of graphs and figures. And you\\u2019ll get time and one-half (+50%) on your test.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW252643944 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW44021951 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EText-to-Speech (Embedded)\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW44021951 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW261523775 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use the text-to-speech tool in Bluebook to read all text (reading passages, math problems and equations, and multiple-choice response questions\\/answers) and short descriptions of graphics.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW261523775 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW62882252 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EHuman Scribe for Digital Assessments\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW62882252 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cspan class=\\u0022TextRun SCXW123467141 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can use a human scribe to\\u0026nbsp;record the responses in Bluebook. You will test in a one-to-one setting.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW123467141 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EDictation for Digital Exams\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use speech-to-text functionality on your test. \\u003Cspan class=\\u0022NormalTextRun SCXW79833047 BCX0\\u0022\\u003ENote: This is not a tool within the Bluebook application; it is the same functionality that you use with other applications.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAssistive Technology (AT)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use your approved assistive technology software.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003E4-Function Calculator\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can use a calculator on all math questions on the test. Use the Desmos calculator that\\u2019s built into the app, or bring your own approved calculator.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ELimited Time\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EIf the test time exceeds your approved time, you will test over multiple days.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAuditory Amplification\\/FM System\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EYou can test with your FM system, and you can use headphones. The proctor should use a handheld mic to give you the instructions.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-01-29T15:37:42-05:00\\u0022\\u003E1769719062\\u003C\\/time\\u003E\\n\"},{\"id\":\"269\",\"internal_id\":\"keyboard-shortcuts-sat\",\"type\":\"help_detail\",\"title\":\"Keyboard Shortcuts: SAT\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThe following keyboard shortcuts allow you to navigate to important functions within the digital exam.\\u003C\\/p\\u003E\\n\\n\\u003Ctable\\u003E\\n\\t\\u003Ccaption\\u003EKeyboard Shortcuts\\u003C\\/caption\\u003E\\n\\t\\u003Cthead\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EPC\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EChromebook\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EMac\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EiPad\\u003C\\/th\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\u003C\\/thead\\u003E\\n\\t\\u003Ctbody\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom In\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Up Arrow (or Pinch to Zoom)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom Out\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Down Arrow (or Pinch to Zoom)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom Back to 100%\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EDouble-tap Space Bar\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EBack\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + B\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ENext\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + X\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EHelp\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + H\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + H\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + H\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + P\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EOpen\\/Close Directions\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + Shift + D\\u0026nbsp; \\u0026nbsp;\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + Shift + D\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Shift + D\\u0026nbsp; \\u0026nbsp;\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Shift + D\\u0026nbsp;\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EHide\\/Show Timer\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + T\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + T\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Option + T\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Option + T\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EClose 5-Minute Message\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Alt + T\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Alt + T\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Option + T\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Option + T\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\