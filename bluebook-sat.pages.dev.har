C\\/th\\u003E\\u003Ctd\\u003ECommand + Z\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ERedo\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Shift + Z\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECut\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + X\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECopy\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EPaste\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + V\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EInsert Symbols\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + \\/\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EFocus on Editor Toolbar\\u003C\\/th\\u003E\\u003Ctd\\u003EOption + F10\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-02-02T15:37:25-05:00\\u0022\\u003E1770064645\\u003C\\/time\\u003E\\n\"},{\"id\":\"891\",\"internal_id\":\"key-shorts-cbook\",\"type\":\"help_detail\",\"title\":\"Keyboard Shortcuts: Chromebook\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThe following keyboard shortcuts have been configured to navigate to important functions within the digital exam.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cstrong\\u003ENote: \\u003C\\/strong\\u003EFor any shortcut that includes \\u0022F1,\\u0022 \\u0022F2,\\u0022 etc., you may need to press the Search key along with top-row keys to activate the command.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ccaption\\u003EKeyboard Shortcuts for Multiple-Choice Questions\\u003C\\/caption\\u003E\\u003Cthead\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EShortcut\\u003C\\/th\\u003E\\u003C\\/tr\\u003E\\u003C\\/thead\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Keyboard Shortcuts\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Search + S\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ENavigate Exam Regions (Forward)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EF6\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ENavigate Exam Regions (Back)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EShift + F6\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EZoom In\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Plus (+)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EZoom Out\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Minus (-)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EZoom Back to 100%\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + 0\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EBack\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + B\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ENext\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + X\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Question Menu\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + G\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHelp\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + H\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Directions\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + Shift +\\u0026nbsp;D\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Line Reader\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + L\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHide\\/Show Timer or Close 5-Minute Message\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + T\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EPause Timer (w\\/certain accommodations only)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + P\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EMark for Review\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Shift + V\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EHighlights \\u0026amp; Notes\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + H\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Calculator\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOpen\\/Close Reference Sheet\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ESelect\\/Deselect Option A\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Shift + 1\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ESelect\\/Deselect Option B\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Shift + 2\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003