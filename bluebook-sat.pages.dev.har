            "mimeType": "application/json",
            "text": "{\"query\":\"\\n  query ListRegistrationsQuery($rosterEntryId: String) {\\n    listRegistrations(rosterEntryId: $rosterEntryId) {\\n      statusCode\\n      message\\n      registrations {\\n        id\\n        asmtDeliveryMode\\n        accommodationsInfo {\\n          codes {\\n            code\\n            description\\n          }\\n          enableTts\\n          enableCaption\\n          feature1\\n          hasAudioDescribedVideo\\n        }\\n        testCenter {\\n          aiCd\\n          testCenterId\\n          name\\n          address1\\n          address2\\n          address3\\n          city\\n          state\\n          zip\\n          country\\n          isInternational\\n          adminStatus\\n          display\\n          comments\\n        }\\n        event {\\n          id\\n          name\\n          testDisplayName\\n          timing {\\n            startTime\\n            endTime\\n            setupStartTime\\n            setupEndTime\\n            checkinStartTime\\n            checkinEndTime\\n            submissionStartTime\\n            submissionEndTime\\n          }\\n          asmtId\\n          asmtSubtypeCd\\n          asmtFamilyCd\\n          asmtDeliveryMethodCd\\n          asmtEventTypeCd\\n          asmtStartMode\\n        }\\n        timeZoneIndex\\n        timeZoneName\\n        timeOffsetToGMT\\n        isSetupComplete\\n        isTestStarted\\n        testStatus\\n        responseRecoveryMode\\n        multiPart\\n        testPackageSeq\\n        testPackageCount\\n        testOverviewContentId\\n        dependsOn\\n        attemptNo\\n        regNumber\\n        features\\n        examSettings {\\n          audioInput\\n          audioOutput\\n          foreignLanguages\\n          selectableLanguageContent {\\n            forcedDefaultTagValue\\n            menuTitle\\n            menuItems {\\n              label\\n              abbreviatedLabel\\n              tagValue\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n\",\"variables\":null,\"operationName\":\"ListRegistrationsQuery\"}"
          }
