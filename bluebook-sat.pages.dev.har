            "text": "\n      <!DOCTYPE html>\n      <html lang=\"en\">\n        <head>\n          <meta charset=\"utf-8\" />\n          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n          <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' 'unsafe-eval' 'unsafe-inline';\nfont-src 'self' data: https://*.collegeboard.org:*;\nstyle-src 'self' 'unsafe-inline';\nmedia-src 'self' blob: data: https://*.collegeboard.org:*;\nimg-src 'self' data:;\nworker-src 'self' blob:;\nscript-src-elem 'self' 'unsafe-inline' blob: https://*.collegeboard.org:*;\nconnect-src https://*.collegeboard.org:* https://o516766.ingest.sentry.io/api/5667256/ https://agwtc.collegeboard.org/ https://login.microsoftonline.com ws://*.collegeboard.org:*;\nstyle-src-elem 'self' https://*.collegeboard.org:* 'unsafe-inline';\nform-action https://login.microsoftonline.com;\nframe-src https://login.microsoftonline.com;\">\n          <title>Bluebook</title><script src=./shim.js?v=7></script>\n          <meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\" />\n          <meta http-equiv=\"Pragma\" content=\"no-cache\" />\n          <meta http-equiv=\"Expires\" content=\"0\" />\n          <meta name=\"robots\" content=\"noindex, nofollow\">\n          <style>\n            body {\n                margin: 0;\n                padding: 0;\n            }\n          </style>\n          \n        \n        \n        <script type=\"text/javascript\">\n          navigator.userAgent.includes(\"Windows\") &&\n            document.querySelector(\"meta[name=viewport]\")?.setAttribute(\"content\",\"width=device-width, initial-scale=\" + 1 / window.devicePixelRatio);\n        </script>\n\n        \n  <link rel=\"stylesheet\" type=\"text/css\" href=\"./fonts/NotoSerif.css\" />\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"./fonts/CourierPrime.css\" />\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"./fonts/CrimsonText.css\" />\n\n        <style>\n          \n.app-loading {\n  width: 100vw;\n  height: 100vh;\n  background-color: #324dc7;\n  color: #fff;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  font-family: Roboto, sans-serif;\n  animation: app-loading__fade-in 0.5s ease-in-out;\n}\n\n.app-loading--vertical__logo {\n  fill: #fff;\n  height: 75px;\n  margin-bottom: 17px;\n  animation: app-loading__logo 1s 0.5s 1 ease-in-out both;\n}\n\n@media (orientation: landscape) {\n  .app-loading--vertical__logo  {\n    width: 0;\n    height: 0;\n  }\n}\n\n.app-loading--vertical__header {\n  height: 57px;\n  width: 313px;\n  padding: 0 0 0 15px;\n  opacity: 0;\n  animation: app-loading__appear 1s 1s ease-in-out both;\n  margin-bottom: -25px;\n}\n\n@media (orientation: landscape) {\n  /*\n    This is used to show the logo in stacked form vs horizontal form depending on\n    the screen orientation. I would have preferred to do this another way but other\n    strategies I tried resulted in fairly garish spacing/layout issues. The\n    negative margin-bottom above addresses part of this.\n  */\n  .app-loading--vertical__header {\n    width: 0;\n    height: 0;\n    margin-bottom: 0;\n  }\n}\n\n.app-loading__logo--horizontal {\n  margin: 24px 0;\n  height: 84px;\n  padding: 0px;\n  opacity: 0;\n  animation: app-loading__appear 1s 1s ease-in-out both;\n}\n\n@media (orientation: portrait) {\n  .app-loading__logo--horizontal {\n    width: 0;\n    height: 0;\n  }\n}\n\n.app-loading__content {\n  font-weight: normal;\n  font-size: 24px;\n  line-height: 1.5em;\n  margin: 0px;\n  padding: 0px;\n  opacity: 0;\n  animation: app-loading__appear 1s 1.5s ease-in-out both;\n}\n\n.app-loading__content:nth-of-type(2) {\n  animation-delay: 2s;\n}\n\n.app-loading__spinner {\n  margin-top: 32px;\n  width: 100px;\n  height: 100px;\n  fill: #fff;\n  animation: app-loading__appear 1s 2.5s ease-in-out both;\n}\n\n.app-loading__spinner circle {\n  --delay: 0.2s;\n  animation: app-loading__pulse calc(var(--delay) * 12) infinite ease-in-out;\n  animation-fill-mode: both;\n}\n\n.app-loading__spinner circle:nth-of-type(1) {\n  animation-delay: calc(var(--delay) * 1);\n  transform-origin: 50px 10px;\n}\n\n.app-loading__spinner circle:nth-of-type(2) {\n  animation-delay: calc(var(--delay) * 2);\n  transform-origin: 70px 15px;\n}\n\n.app-loading__spinner circle:nth-of-type(3) {\n  animation-delay: calc(var(--delay) * 3);\n  transform-origin: 85px 30px;\n}\n\n.app-loading__spinner circle:nth-of-type(4) {\n  animation-delay: calc(var(--delay) * 4);\n  transform-origin: 90px 50px;\n}\n\n.app-loading__spinner circle:nth-of-type(5) {\n  animation-delay: calc(var(--delay) * 5);\n  transform-origin: 85px 70px;\n}\n\n.app-loading__spinner circle:nth-of-type(6) {\n  animation-delay: calc(var(--delay) * 6);\n  transform-origin: 70px 85px;\n}\n\n.app-loading__spinner circle:nth-of-type(7) {\n  animation-delay: calc(var(--delay) * 7);\n  transform-origin: 50px 90px;\n}\n\n.app-loading__spinner circle:nth-of-type(8) {\n  animation-delay: calc(var(--delay) * 8);\n  transform-origin: 30px 85px;\n}\n\n.app-loading__spinner circle:nth-of-type(9) {\n  animation-delay: calc(var(--delay) * 9);\n  transform-origin: 15px 70px;\n}\n\n.app-loading__spinner circle:nth-of-type(10) {\n  animation-delay: calc(var(--delay) * 10);\n  transform-origin: 10px 50px;\n}\n\n.app-loading__spinner circle:nth-of-type(11) {\n  animation-delay: calc(var(--delay) * 11);\n  transform-origin: 15px 30px;\n}\n\n.app-loading__spinner circle:nth-of-type(12) {\n  animation-delay: calc(var(--delay) * 12);\n  transform-origin: 30px 15px;\n}\n\n@keyframes app-loading__fade-in {\n  0% {\n    opacity:0;\n  }\n  100% {\n    opacity:1;\n  }\n}\n\n@keyframes app-loading__pulse {\n  0% {\n    opacity:0;\n    transform: scale(0%);\n  }\n  50% {\n    opacity:1;\n    transform: scale(100%);\n  }\n  100% {\n    opacity:0;\n    transform: scale(0%);\n  }\n}\n\n@keyframes app-loading__appear {\n  0% {\n    opacity:0;\n    transform: translateY(10%) scale(90%, 110%);\n  }\n  33% {\n    opacity:1;\n    transform: translateY(-5%) scale(105%, 95%);\n  }\n  66% {\n    opacity:1;\n    transform: translateY(2.5%) scale(95%, 105%);\n  }\n  100% {\n    opacity:1;\n    transform: translateY(0%) scale(100%, 100%);\n  }\n}\n\n@keyframes app-loading__logo {\n  0% {\n    opacity:0;\n    transform: translateY(20%) scale(80%, 120%);\n  }\n  33% {\n    opacity:1;\n    transform: translateY(-10%) scale(110%, 90%);\n  }\n  66% {\n    opacity:1;\n    transform: translateY(5%) scale(90%, 110%);\n  }\n  100% {\n    opacity:1;\n    transform: translateY(0%) scale(100%, 100%);\n  }\n}\n\n        </style>\n        \n          <script defer src=\"./desmos/calculator.js?xc2cfix09\" id=\"Desmos-script\"></script>\n<script defer src=\"./ckeditor/ckeditor.js?xc2cfix09\"></script>\n<script defer src=\"./vendor-public.js?xc2cfix09\"></script><script defer src=\"./vendor-private.js?xc2cfix09\"></script><script defer src=\"./main.js?xc2cfix09\"></script><meta name=\"theme-color\" content=\"white\"><link rel=\"manifest\" href=\"/manifest.webmanifest\"><link rel=\"icon\" href=\"/bluebook-16x16.1121fe81.png\"><link rel=\"icon\" href=\"/bluebook-32x32.cb8ed68a.png\">\n          \n        </head>\n        <body>\n          \n        \n        <div id=\"app-utility\"></div>\n        <div id=\"app\">\n          \n  <div class=\"app-loading\">\n      <svg class=\"app-loading--vertical__logo\" height=\"150px\" viewBox=\"0 0 144 144\">\n        <path d=\"M114.74,56.43l19.45-32.15c1.15-1.9-.79-4.16-2.84-3.32l-34.76,14.27c-.36,.15-.48,.61-.22,.91l17.43,20.36c.26,.3,.73,.26,.93-.08Z\"/><path d=\"M38.66,59.32L4.08,73.87c-2.04,.86-1.81,3.83,.35,4.35l36.46,8.87c.38,.09,.74-.22,.71-.61l-2.14-26.68c-.03-.39-.44-.64-.8-.49Z\"/><path d=\"M140.77,106.51L51.12,1.81c-1.45-1.68-4.2-.53-4.03,1.68l10.99,137.4c.19,2.21,3.08,2.9,4.25,1.01l25.82-41.84c.52-.84,1.52-1.26,2.48-1.03l47.87,11.21c2.16,.51,3.71-2.04,2.28-3.73Z\"/>\n      <