03C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Play\\/Pause)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EAlt + P\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Stop)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Click Mode On\\/Off)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EAlt + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003ENote: For multiselect options, use the space bar to make your selection.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ccaption\\u003EKeyboard Shortcuts for Free-Response Questions and Student-Produced Responses\\u003C\\/caption\\u003E\\u003Cthead\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EShortcut\\u003C\\/th\\u003E\\u003C\\/tr\\u003E\\u003C\\/thead\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EBold\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + B\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EItalics\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + I\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EUnderline\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + U\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESuperscript\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + Plus (+)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESubscript\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + Minus (-)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EUndo\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Z\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ERedo\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Y\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECut\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + X\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECopy\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EPaste\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + V\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EInsert Symbols\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + \\/\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EFocus on Editor Toolbar\\u003C\\/th\\u003E\\u003Ctd\\u003EAlt + F10\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\",\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-03-14T13:11:06-04:00\\u0022\\u003E1678813866\\u003C\\/time\\u003E\\n\"},{\"id\":\"896\",\"internal_id\":\"key-shorts-mac-ipad\",\"type\":\"help_detail\",\"title\":\"Keyboard Shortcuts: Mac and iPad\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThe following keyboard shortcuts have been configured to navigate to important functions within the digital exam.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003ENote: \\u003C\\/strong\\u003EFor any shortcut that includes \\u0022F1,\\u0022 \\u0022F2,\\u0022 etc., you may need to press \\u0022Fn\\u0022 first to activate the command.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ccaption\\u003EKeyboard Shortcuts for Multiple-Choice Questions\\u003C\\/caption\\u003E\\u003Cthead\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EShortcut\\u003C\\/th\\u003E\\u003C\\/tr\\u003E\\u003C\\/thead\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EOpen\\/Close Keyboard Shortcuts\\u003C\\/th\\u003E\\u003Ctd\\u003EF1\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003ENavigate Exam Regions (Forward)\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003EF6\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003ENavigate Exam Regions (Back)\\u003C\\/th\\u003E\\u003Ctd\\u003EShift + F6\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EZoom In\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Plus (+) (or Pinch to Zoom)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EZoom Out\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Minus (-) (or Pinch to Zoom)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EZoom Back to 100%\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + 0\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EBack\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + B\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ENext\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand+ Ctrl + X\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003E\\u003Cstrong\\u003EOpen\\/Close Question Menu\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl\\u0026nbsp;+ G\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EHelp\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + H (Mac);\\u0026nbsp;Command + Ctrl + P (iPad)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EOpen\\/Close Directions\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + Shift + D\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003E\\u003Cstrong\\u003EOpen\\/Close Line Reader\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + L\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EHide\\/Show Timer or Close 5-Minute Message\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + T\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EPause Timer (w\\/certain accommodations only)\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + P\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003E\\u003Cstrong\\u003EMark for Review\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Shift + V\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EHighlights \\u0026amp; Notes\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + H\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003E\\u003Cstrong\\u003EOpen\\/Close Calculator\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EOpen\\/Close Reference Sheet\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESelect\\/Deselect Option A\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + 1\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESelect\\/Deselect Option B\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + 2\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESelect\\/Deselect Option C\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + 3\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESelect\\/Deselect Option D\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + 4\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESelect\\/Deselect Option E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Ctrl + 5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EOption Eliminator Mode\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + O\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EEliminate Option A\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + 1\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EEliminate Option B\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + 2\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EEliminate Option C\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + 3\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EEliminate Option D\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + 4\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth\\u003E\\u003Cstrong\\u003EEliminate Option E\\u003C\\/strong\\u003E\\u003C\\/th\\u003E\\u003Ctd\\u003ECommand + Option + 5\\u003C\\/td\\u003E\\u003C\