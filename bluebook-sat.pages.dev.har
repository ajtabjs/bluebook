E\\n\\u003C\\/table\\u003E\\n\\n\\u003Cp\\u003ENote: For multiselect options, use the space bar to make your selection.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Ctable class=\\u0022cb-table\\u0022\\u003E\\n\\t\\u003Ccaption\\u003EKeyboard Shortcuts for Free-Response Questions\\u003C\\/caption\\u003E\\n\\t\\u003Cthead\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EPC\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EChromebook\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EMac\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EiPad\\u003C\\/th\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\u003C\\/thead\\u003E\\n\\t\\u003Ctbody\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EBold\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + B\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + B\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EItalics\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + I\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + I\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + I\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + I\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EUnderline\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + U\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + U\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + U\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + U\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EIndent\\u0026nbsp;Text\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + M\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + M\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + M\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand\\u0026nbsp;+ M\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ESuperscript\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + Plus (+)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + Plus (+)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Plus (+)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Plus (+)\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ESubscript\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + Minus (-)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + Minus (-)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Minus (-)\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + Minus (-)\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EUndo\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Z\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Z\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Z\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Z\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ERedo\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Y\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Y\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Shift + Z\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Shift + Z\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ECut\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + X\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + X\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003ECopy\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + C\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + C\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + C\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + C\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EPaste\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + V\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + V\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + V\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + V\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003EInsert Symbols\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + \\/\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003EControl + Shift + \\/\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + \\/\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003ECommand + Ctrl + \\/\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\u003C\\/tbody\\u003E\\n\\u003C\\/table\\u003E\\n\\n\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-03-01T18:01:57-05:00\\u0022\\u003E1677711717\\u003C\\/time\\u003E\\n\"},{\"id\":\"301\",\"internal_id\":\"you-cannot-test-on-multiple-devices\",\"type\":\"help_detail\",\"title\":\"You Cannot Test on Multiple Devices\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThe digital testing app will not work on multiple devices. It\\u2019s critical that you download the app and check in on the device you\\u2019ll test with.\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-02-11T13:13:49-05:00\\u0022\\u003E1644603229\\u003C\\/time\\u003E\\n\"},{\"id\":\"292\",\"internal_id\":\"calculator-policies-1-before-test\",\"type\":\"help_detail\",\"title\":\"Calculator Policies\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003ESome AP Exams require or allow a calculator. On these exams, a Desmos graphing calculator will be available on the Bluebook testing screens. You can also use your own approved calculator.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003ECalculator Policies by Course\\u003C\\/caption\\u003E\\u003Cthead\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EAP Course\\u003C\\/th\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003ECalculator Type\\u003C\\/th\\u003E\\u003C\\/tr\\u003E\\u003C\\/thead\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EBiology\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function (with square root), scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ECalculus AB and BC\\u003C\\/td\\u003E\\u003Ctd\\u003EGraphing calculator required for Section I, Part B and Section II, Part A. Calculators are not allowed on other sections.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EChemistry\\u003C\\/td\\u003E\\u003Ctd\\u003EA scientific calculator or graphing calculator is recommended for free-response questions; a four-function calculator is allowed but not recommended.\\u0026nbsp;\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EEnvironmental Science\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function (with square root), scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMacroeconomics\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function calculator is allowed. \\u003Cspan\\u003EHandheld calculators with storage capabilities such as scientific calculators and graphing calculators are not allowed.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMicroeconomics\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function calculator is allowed. \\u003Cspan\\u003EHandheld calculators with storage capabilities such as scientific calculators and graphing calculators are not allowed.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EPhysics 1\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function, scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EPhysics 2\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function, scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EPhysics C: Mechanics\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function, scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EPhysics C: Electricity and Magnetism\\u003C\\/td\\u003E\\u003Ctd\\u003EFour-function, scientific, or graphing calculator allowed.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EPrecalculus\\u003C\\/td\\u003E\\u003Ctd\\u003EGraphing calculator required for Section I, Part B and Section II, Part A. Calculators are not allowed on other sections.\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStatistics\\u003C\\/td\\u003E\\u003Ctd\\u003EGraphing calculator with statistical capabilities is allowed. Nongraphing calculators are permitted if they meet the requirements described in the \\u003Cem\\u003EAP Statistics Course and Exam Description\\u003C\\/em\\u003E.\\u0026nbsp;\\u003Cbr\\u003E\\u003Cbr\\u003E\\u003Cstrong\\u003ENote:\\u003C\\/strong\\u003E\\u003Cspan\\u003E The Desmos graphing calculator is not available for this exam because Desmos does not currently have the required statistics computational capabilities.\\u003C\\/span\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003EStudents won\\u0027t benefit from using a calculator on digital versions of other AP Exams.\\u003C\\/p\\u003E\\u003Cp\\u003EFor further details on calculator policies, visit \\u003Cstrong\\u003Eapstudents.org\\/calculators\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-12-18T10:30:09-05:00\\u0022\\u003E1734535809\\u003C\\/time\\u003E\\n\"},{\"id\":\"273\",\"internal_id\":\"testing-timers\",\"type\":\"help_detail\",\"title\":\"Testing Timers\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EDuring testing, a timer will let you know how much time remains for each module or part of the test.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EAt the end of section 1, you\\u2019ll have a short break. During the break, we\\u2019ll show you a timer counting down to the beginning of section 2.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EWhen time runs out on section 2, the test will end, and your answers will be automatically submitted.\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-03-13T14:06:17-04:00\\u0022\\u003E1678730777\\u003C\\/time\\u003E\\n\"},{\"id\":\"286\",\"internal_id\":\"you-cannot-go-back-during-testing\",\"type\":\"help_detail\",\"title\":\"You Cannot Go Back During Testing\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003ETo keep digital testing secure, you will not be able to move back and forth between questions or review questions you\\u2019ve already answered. \\u0026nbsp;\\u003Cbr\\u003E\\n\\u0026nbsp;\\u003Cbr\\u003E\\nOn free-response questions that have multiple parts, you will be able to go back and forth until you\\u2019re done working on the entire question. Once you hit \\u201cNext\\u201d to move on from the last part, you will no longer be able to go back to that question.\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-04-29T10:22:57-04:00\\u0022\\u003E1619706177\\u003C\\/time\\u003E\\n\"},{\"id\":\"302\",\"internal_id\":\"photo-id-requirements\",\"type\":\"help_detail\",\"title\":\"Photo ID Requirements\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EYou must have one of these kinds of photo ID:\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EOfficial student ID from your current school\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EGovernment-issued driver\\u2019s license or non-driver ID card\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EGovernment-issued passport or U.S. Global Entry ID card\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\\n\\n\\u003Cp\\u003EYour photo ID must meet these requirements:\\u003C\\/p\\u003E\\n\\n\\u003Cul\\u003E\\n\\t\\u003Cli\\u003EIt\\u2019s unexpired (note: school IDs from the 2019-20 school year will be accepted).\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EIt\\u2019s an original, physical document\\u2014not a photo or a digital copy.\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EIt includes your full legal name, exactly as it appears in your College Board account.\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EIt includes a recent photograph that matches your appearance on test day.\\u003C\\/li\\u003E\\n\\t\\u003Cli\\u003EIt\\u2019s in good condition with legible English language text.\\u003C\\/li\\u003E\\n\\u003C\\/ul\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:05:32-05:00\\u0022\\u003E1636715132\\u003C\\/time\\u003E\\n\"},{\"id\":\"303\",\"internal_id\":\"multiple-cameras\",\"type\":\"help_detail\",\"title\":\"Multiple Cameras\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you have more than one camera connected to your device, the app will ask you to pick one. You\\u2019ll use the camera to take a picture of yourself and your photo ID, so we can verify your identity. For security purposes, the app will take intermittent photos of you. The camera you choose must be facing you.\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:05:37-05:00\\u0022\\u003E1636715137\\u003C\\/time\\u003E\\n\"},{\"id\":\"298\",\"internal_id\":\"device-requirements-ap\",\"type\":\"help_detail\",\"title\":\"Device Requirements\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003E\\u003Cspan\\u003EYou can run Bluebook on a Windows or Mac device, an iPad, or a school-managed Chromebook.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cspan\\u003EFor detailed requirements, go to \\u003Cstrong\\u003Ebluebook.org\\/student-devices\\u003C\\/strong\\u003E.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-10-03T10:34:36-04:00\\u0022\\u003E1727966076\\u003C\\/time\\u003E\\n\"},{\"id\":\"348\",\"internal_id\":\"exam-setup-personal-info-radio-buttons\",\"type\":\"functional_content\",\"title\":\"Is this information correct?\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[],\"cancel_interaction\":{\"context\":\"\\u003Cp\\u003EIf this information is incorrect, call us at 833-711-1334.\\u003C\\/p\\u003E\\n\",\"label\":\"No\"},\"confirm_interaction\":{\"label\":\"Yes\"},\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-07-18T16:38:19-04:00\\u0022\\u003E1689712699\\u003C\\/time\\u003E\\n\"},{\"id\":\"353\",\"internal_id\":\"exam-setup-response-permission\",\"type\":\"functional_content\",\"title\":\"Answer Reuse Permission\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"Section 2: Exam Setup (24 hours before test day) - Response permission page\\u003Cbr \\/\\u003E\\r\\n\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EI grant College Board the unlimited right to use, reproduce, and publish my free-response materials, for educational research and instructional purposes. My name and the name of my school will not be used in any way in connection with my free-response materials. I understand that I am free to uncheck this box with no effect on my score or its reporting.\\u003C\\/p\\u003E\",\"id\":\"exam-setup-response-permission-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":{\"label\":\"I grant College Board these rights.\"},\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:44-05:00\\u0022\\u003E1636715384\\u003C\\/time\\u003E\\n\"},{\"id\":\"349\",\"internal_id\":\"exam-setup-system-error\",\"type\":\"functional_content\",\"title\":\"no title: exam setup system error\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"Section 2: Exam Setup (24 hours before test day) - Personal Info Page: System Error Modal\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EWe weren\\u2019t able to pull your information, and you can\\u2019t continue without it.\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EPlease reload this page and see if your information displays.\\u0026nbsp;\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf that doesn\\u2019t work, call us at 833-711-1334.\\u003C\\/p\\u003E\",\"id\":\"exam-setup-system-error-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":{\"label\":\"Reload\"},\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:30-05:00\\u0022\\u003E1636715370\\u003C\\/time\\u003E\\n\"},{\"id\":\"346\",\"internal_id\":\"checkin-terms-conds-privacy\",\"type\":\"functional_content\",\"title\":\"Privacy\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"Section 2: Exam Setup (24 hours before test day) - Terms and Conditions \\u0026amp; Privacy Policy Page\\u003Cbr \\/\\u003E\\r\\n\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe privacy provisions listed here are part of the complete AP Exam Terms and Conditions that you accepted during Exam Setup. We have included them here as a reminder to you of these terms. Please review them and then acknowledge that you\\u2019ve read and accepted the AP Exam Terms and Conditions\\u0026nbsp;including without limitation, the privacy provisions.\\u003C\\/p\\u003E\\n\\n\\u003Ch2\\u003EPrivacy Provisions\\u003C\\/h2\\u003E\\n\\n\\u003Cp\\u003ECollege Board recognizes the importance of protecting your privacy. The privacy policies located at collegeboard.org\\/privacy-center (\\u201c\\u003Cem\\u003EPrivacy Policies\\u003C\\/em\\u003E\\u201d)\\u003Cem\\u003E \\u003C\\/em\\u003Eare part of these Terms and Conditions. You consent to College Board\\u2019s collection, use, and disclosure of your personally identifiable information as described in the Privacy Policies and in these Terms and Conditions. College Board may update its Privacy Policies from time to time and they are subject to change up to one week prior to your test date. You are required to review the Privacy Policies located at \\u003Cstrong\\u003Ecollegeboard.org\\/privacy-center\\u003C\\/strong\\u003E prior to taking the AP Exam.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EDevice Data: When you download and use the AP\\u0026nbsp;Exam App, College Board will receive certain information about your device, including device type, operating system type and version, applications and processes running on your device, screen size and resolution, available memory, and other information to ensure the device is compatible.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EActivity Data: We also monitor the actions you take in the AP Exam App, including your responses, where you click, how long you spend on each page, and how you navigate through the AP Exam App.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EDevice Data, Images and Activity Data (collectively, \\u201c\\u003Cem\\u003EAP Test Data\\u003C\\/em\\u003E\\u201d) may be used for College Board\\u2019s test security purposes as well as to develop and improve College Board products and services. AP Test Data may be disclosed to trusted vendors, but only in their provision of services to College Board. AP Test Data is not sold or licensed to third parties including without limitation for their marketing purposes. You will also be asked to type specific sentences in the AP Exam App. Those typed sentences are not used for biometric identification.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EWhen you download and use the AP Exam App, College Board will share certain information with your school, including whether you have: downloaded and logged into the app, completed exam setup, used the app\\u2019s practice resources, checked in to your AP Exam, commenced your AP Exam, and submitted your AP Exam answers.\\u003C\\/p\\u003E\",\"id\":\"exam-setup-terms-conditions-privacy-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":{\"label\":\"I acknowledge that I have accepted and am bound by the 2021 AP Exam Terms and Conditions.\"},\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:30-05:00\\u0022\\u003E1636715370\\u003C\\/time\\u003E\\n\"},{\"id\":\"350\",\"internal_id\":\"exam-setup-exit-setup\",\"type\":\"functional_content\",\"title\":\"Are You Sure You Want to Exit?\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"Section 2: Exam Setup (24 hours before test day) - Exit Exam Setup Modal\\u003Cbr \\/\\u003E\\r\\n\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EYou must complete the exam setup process before your test starts.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"exam-setup-exit-setup-p1\"}],\"cancel_interaction\":{\"label\":\"Complete Exam Setup\"},\"confirm_interaction\":{\"label\":\"Exit Now\"},\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:30-05:00\\u0022\\u003E1636715370\\u003C\\/time\\u003E\\n\"},{\"id\":\"351\",\"internal_id\":\"exam-setup-authentication-fail\",\"type\":\"functional_content\",\"title\":\"We Can\\u2019t Open the Application\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"Section 2: Exam Setup (24 hours before test day) - Authentication Fail Message\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003ESomething\\u2019s not right. Please call us at 833-711-1334.\\u003C\\/p\\u003E\",\"id\":\"exam-setup-authentication-fail-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:30-05:00\\u0022\\u003E1636715370\\u003C\\/time\\u003E\\n\"},{\"id\":\"352\",\"internal_id\":\"launch-app-has-loaded\",\"type\":\"functional_content\",\"title\":\"You\\u2019re All Set!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp dir=\\u0022ltr\\u0022\\u003EThe CB Digital Testing app has been successfully installed.\\u003C\\/p\\u003E\\n\\n\\u003Cp dir=\\u0022ltr\\u0022\\u003E72 hours before the exam, we\\u2019ll send you an email with directions for a quick exam setup you\\u2019ll complete before test day.\\u003C\\/p\\u003E\\n\\n\\u003Cp dir=\\u0022ltr\\u0022\\u003EGood luck on test day!\\u003C\\/p\\u003E\",\"id\":\"launch-app-has-loaded-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:30-05:00\\u0022\\u003E1636715370\\u003C\\/time\\u003E\\n\"},{\"id\":\"354\",\"internal_id\":\"launch-app-loading\",\"type\":\"functional_content\",\"title\":\"The Application Is Loading\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"Section 1: Launching the App - Loading Screen\",\"external_description\":\"\",\"overview\":\"\",\"content\":[],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"College Board\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222021-11-12T06:09:44-05:00\\u0022\\u003E1636715384\\u003C\\/time\\u003E\\n\"}]"
          },
