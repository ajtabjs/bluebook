            "text": "[{\"id\":\"2096\",\"internal_id\":\"checkin-practice-typing-ja\",\"type\":\"functional_content\",\"title\":\"Practice Typing in Japanese\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-ja-p1\"},{\"content\":\"\\u003Cp lang=\\u0022ja\\u0022\\u003EJAPANESE SAMPLE IS TK\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-ja-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:58:47-04:00\\u0022\\u003E1782421127\\u003C\\/time\\u003E\\n\"},{\"id\":\"2091\",\"internal_id\":\"checkin-practice-typing-zh\",\"type\":\"functional_content\",\"title\":\"Practice Typing in Chinese\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-zh-p1\"},{\"content\":\"\\u003Cp lang=\\u0022zh\\u0022\\u003E\\u003Cstrong\\u003EType Either \\u003C\\/strong\\u003E(Simplified):\\u003Cbr\\u003E\\u003Cspan\\u003E\\u4eca\\u5929\\u7684\\u8003\\u8bd5\\u6211\\u4f1a\\u52a0\\u6cb9\\u7684\\uff01\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cstrong\\u003EOr \\u003C\\/strong\\u003E(\\u003Cspan\\u003ETraditional):\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cbr\\u003E\\u003Cspan\\u003E\\u4eca\\u5929\\u7684\\u8003\\u8a66\\u6211\\u6703\\u52a0\\u6cb9\\u7684\\uff01\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-zh-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-28T13:55:53-04:00\\u0022\\u003E1785261353\\u003C\\/time\\u003E\\n\"},{\"id\":\"2131\",\"internal_id\":\"checkin-practice-typing-de\",\"type\":\"functional_content\",\"title\":\"Practice Typing in German\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EPress and hold letters to add accents or special characters (\\u00fc, \\u00df).\\u003Cbr\\u003E\\u003Cbr\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-de-p1\"},{\"content\":\"\\u003Cp lang=\\u0022de\\u0022\\u003EGERMAN SAMPLE IS TK\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-de-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:59:35-04:00\\u0022\\u003E1782421175\\u003C\\/time\\u003E\\n\"},{\"id\":\"2126\",\"internal_id\":\"checkin-practice-typing-it\",\"type\":\"functional_content\",\"title\":\"Practice Typing in Italian\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EPress and hold letters to add accents (\\u00e0, \\u00e9).\\u003Cbr\\u003E\\u003Cbr\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-it-p1\"},{\"content\":\"\\u003Cp lang=\\u0022it\\u0022\\u003EITALIAN SAMPLE IS TK\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-it-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:59:35-04:00\\u0022\\u003E1782421175\\u003C\\/time\\u003E\\n\"},{\"id\":\"2136\",\"internal_id\":\"checkin-practice-typing-fr\",\"type\":\"functional_content\",\"title\":\"Practice Typing in French\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EPress and hold letters to add accents or special characters (\\u00e2, \\u00e8, \\u00e7).\\u003Cbr\\u003E\\u003Cbr\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-fr-p1\"},{\"content\":\"\\u003Cp lang=\\u0022fr\\u0022\\u003EFRENCH SAMPLE IS TK\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-fr-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:59:35-04:00\\u0022\\u003E1782421175\\u003C\\/time\\u003E\\n\"},{\"id\":\"2111\",\"internal_id\":\"checkin-practice-typing-es\",\"type\":\"functional_content\",\"title\":\"Practice Typing in Spanish\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EPress and hold letters to add accents (\\u00e1, \\u00f1) or shift + key for punctuation (\\u00bf, \\u00a1).\\u0026nbsp;\\u003Cbr\\u003E\\u003Cbr\\u003EIf you use a non-English keyboard, press\\u0026nbsp;\\u003Cstrong\\u003E{{CMD_KEYBOARD_SHORTCUT}}\\u003C\\/strong\\u003E\\u0026nbsp;to switch keyboards.\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-es-p1\"},{\"content\":\"\\u003Cp lang=\\u0022es\\u0022\\u003E\\u00a1Me ir\\u00e1 muy bien en el examen de espa\\u00f1ol!\\u003C\\/p\\u003E\",\"id\":\"checkin-practice-typing-es-p2\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-28T13:21:31-04:00\\u0022\\u003E1785259291\\u003C\\/time\\u003E\\n\"},{\"id\":\"2116\",\"internal_id\":\"overview-ap-music-theory-linear-singleday-part2\",\"type\":\"functional_content\",\"title\":\"Exam Overview: Sight-Singing\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch3\\u003E\\u003Cstrong\\u003ESection II, Part B\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 2 sight-singing questions and lasts approximately 5 minutes. You will record your responses to the questions in this application.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cem\\u003EAfter you complete the sight-singing questions, the exam will be over.\\u003C\\/em\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe inclusion of source material in this exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP Music Theory Exam represent a range of different works, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze and interpret sources in their disciplinary contexts.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-16T09:33:55-04:00\\u0022\\u003E1784208835\\u003C\\/time\\u003E\\n\"},{\"id\":\"2101\",\"internal_id\":\"overview-ap-music-theory-linear-singleday-part1\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EThe AP Music Theory Exam has 2 sections and lasts approximately 2 hours and 35 minutes.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EAfter Section II: Part A, all of your work will be submitted, and then you\\u0027ll move to another room to complete the sight-singing questions.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ESection I: Multiple Choice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe multiple-choice section of the AP Music Theory Exam includes 2 parts and lasts approximately 1 hour and 20 minutes. There are 75 multiple-choice questions in Section I.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection I, Part A\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam lasts approximately 45 minutes and includes multiple-choice questions that are based on audio recordings.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection I, Part B\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam lasts approximately 35 minutes and includes multiple-choice questions that are based on written concepts and musical scores.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ESection II: Free Response\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe free-response section of the AP Music Theory Exam has 9 free-response questions, including sight-singing, and lasts approximately 1 hour and 15 minutes.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection II, Part A\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 7 free-response questions and lasts approximately 1 hour and 10 minutes. All questions require written responses which you will write in the separate free-response booklet. Questions 1 through 4 in this part include audio recordings.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cem\\u003EAfter this part of the exam, you\\u0027ll move to another room to complete the sight-singing questions in Section II, Part B.\\u003C\\/em\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe inclusion of source material in this exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP Music Theory Exam represent a range of different works, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze and interpret sources in their disciplinary contexts.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-16T10:12:59-04:00\\u0022\\u003E1784211179\\u003C\\/time\\u003E\\n\"},{\"id\":\"2121\",\"internal_id\":\"overview-ap-music-theory-linear-multiday-part3-of-3\",\"type\":\"functional_content\",\"title\":\"Day 2 Overview: Multiple Choice\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EThe multiple-choice section of the AP Music Theory Pilot Exam includes 2 parts and lasts approximately 38 minutes.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003ESection I, Part A: Aural\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the pilot exam includes 21 multiple-choice questions and lasts approximately 24 minutes. Questions in this part include audio recordings that you will use to answer the questions.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003ESection I, Part B: Nonaural\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the pilot exam includes 12 multiple-choice questions and lasts approximately 13 minutes.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESource materials may have been edited for the purpose of this pilot exam.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe inclusion of source material in this pilot exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP Music Theory Exam represent a range of different works, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze and interpret sources in their disciplinary contexts.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:59:35-04:00\\u0022\\u003E1782421175\\u003C\\/time\\u003E\\n\"},{\"id\":\"2106\",\"internal_id\":\"overview-ap-music-theory-linear-multiday-part2-of-3\",\"type\":\"functional_content\",\"title\":\"Day 2 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003EThis section includes 2 sight-singing questions that you\\u0027ll have approximately 5 minutes to answer. In Bluebook, you\\u0027ll review the melody, listen to a starting pitch, get time to practice, then record your response. You\\u0027ll also have an exam booklet to write any notes you may need.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T16:59:35-04:00\\u0022\\u003E1782421175\\u003C\\/time\\u003E\\n\"},{\"id\":\"2161\",\"internal_id\":\"overview-ap-music-theory-linear-multiday-part1-of-3\",\"type\":\"functional_content\",\"title\":\"Day 1 Overview: Free Response\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EThe free-response section of the AP Music Theory Exam includes 3 free-response questions and lasts approximately 23 minutes. All 3 questions require written responses. Questions 1 and 2 include audio sources, and there is a one-minute break before proceeding to question 3. The free-response questions are referenced in this application, but you will write your responses to the questions in the separate free-response booklet.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESource materials may have been edited for the purpose of this pilot exam.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe inclusion of source material in this pilot exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP Music Theory Exam represent a range of different works, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze and interpret sources in their disciplinary contexts.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2156\",\"internal_id\":\"overview-ap-japanese-linear-multiday-part2\",\"type\":\"functional_content\",\"title\":\"Day 2 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2171\",\"internal_id\":\"overview-ap-japanese-linear-multiday-part1\",\"type\":\"functional_content\",\"title\":\"Day 1 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2166\",\"internal_id\":\"overview-ap-japanese-linear-singleday\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2146\",\"internal_id\":\"overview-ap-chinese-linear-multiday-part2\",\"type\":\"functional_content\",\"title\":\"Day 2 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2176\",\"internal_id\":\"overview-ap-chinese-linear-multiday-part1\",\"type\":\"functional_content\",\"title\":\"Day 1 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2181\",\"internal_id\":\"overview-ap-chinese-linear-singleday\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EThe AP Chinese Language and Culture Exam has 2 sections and lasts approximately 1 hour and 50 minutes.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ESection I: Free Response\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe free-response section of the AP Chinese Language and Culture Exam includes 4 free-response questions and lasts approximately 45 minutes.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection I, Part A:\\u003C\\/strong\\u003E \\u003Cstrong\\u003ESpeaking\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 2 free-response questions about your project. The part lasts approximately 15 minutes.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection I, Part B:\\u003C\\/strong\\u003E \\u003Cstrong\\u003EWriting\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 2 free-response questions and lasts approximately 30 minutes. Both questions require written responses in Chinese.\\u003C\\/p\\u003E\\u003Ch2\\u003E\\u003Cstrong\\u003ESection II: Multiple Choice\\u003C\\/strong\\u003E\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe multiple-choice section of the exam includes 2 parts and lasts approximately 1 hour and 5 minutes.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection II, Part A:\\u003C\\/strong\\u003E \\u003Cstrong\\u003EListening\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 5 question sets, each containing 5 multiple-choice questions, and lasts approximately 25 minutes. Each set includes an audio source that you will use to answer the questions. Once timing for each set expires, you will automatically move on to the next set, and you will be unable to return to the prior set.\\u003C\\/p\\u003E\\u003Ch3\\u003E\\u003Cstrong\\u003ESection II, Part B:\\u003C\\/strong\\u003E \\u003Cstrong\\u003EReading\\u003C\\/strong\\u003E\\u003C\\/h3\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThis part of the exam includes 6 question sets, each containing 5 multiple-choice questions, and lasts approximately 40 minutes. Each set includes reading material that you will use to answer the questions. Once time expires in this part, all the answers you have already selected will be automatically submitted, and you will be unable to return to the questions.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003ESource materials may have been edited for the purpose of this exam.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThe inclusion of source material in this exam is not intended as an endorsement by College Board of the content, ideas, or values expressed in the material. The sources that appear in the AP Chinese Language and Culture Exam represent a range of different works, as appropriate for measuring the college-level knowledge and skills that are the focus of this course. AP students are not expected or asked to subscribe to any specific cultural or political values, but they are expected to analyze perspectives that may be different from their own and to analyze and interpret sources in their disciplinary contexts.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EThere may be references in AP testing materials to companies, products, and brands that are owned by others and subject to trademark law. Neither College Board nor the AP testing materials are affiliated with or endorsed by these trademark owners.\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-13T10:31:44-04:00\\u0022\\u003E1783953104\\u003C\\/time\\u003E\\n\"},{\"id\":\"2186\",\"internal_id\":\"overview-ap-german-linear-multiday-part2\",\"type\":\"functional_content\",\"title\":\"Day 2 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\",\"content\":[],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2151\",\"internal_id\":\"overview-ap-german-linear-multiday-part1\",\"type\":\"functional_content\",\"title\":\"Day 1 Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2141\",\"internal_id\":\"overview-ap-german-linear-singleday\",\"type\":\"functional_content\",\"title\":\"Exam Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EContent is TK\\u003C\\/p\\u003E\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-06-25T17:00:21-04:00\\u0022\\u003E1782421221\\u003C\\/time\\u003E\\n\"},{\"id\":\"2216\",\"internal_id\":\"overview-ap-italian-linear-multiday-part2\",\"type\":\"functional_content\",\"title\":\"Day 2 Exam Overview\",\"short_title\":\"