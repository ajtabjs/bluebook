003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003ESelect\\/Deselect Option E\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Shift + 5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EOption Eliminator Mode\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + O\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EEliminate Option A\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 1\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EEliminate Option B\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 2\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EEliminate Option C\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 3\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EEliminate Option D\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 4\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EEliminate Option E\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl + Alt + 5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Play\\/Pause)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EAlt + P\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Stop)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EControl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EText-to-Speech (Click Mode On\\/Off)\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003EAlt + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003ENote: For multiselect options, use the space bar to make your selection.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable class=\\u0022table cb-table\\u0022\\u003E\\u003Ccaption\\u003EKeyboard Shortcuts for Free-Response Questions and Student-Produced Responses\\u003C\\/caption\\u003E\\u003Cthead\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\u003Cth scope=\\u0022col\\u0022\\u003EShortcut\\u003C\\/th\\u003E\\u003C\\/tr\\u003E\\u003C\\/thead\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EBold\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + B\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EItalics\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + I\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EUnderline\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + U\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESuperscript\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + Plus (+)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ESubscript\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + Minus (-)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EUndo\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Z\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ERedo\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Y\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECut\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + X\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003ECopy\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + C\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EPaste\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + V\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EInsert Symbols\\u003C\\/th\\u003E\\u003Ctd\\u003EControl + Shift + \\/\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Cth scope=\\u0022row\\u0022\\u003EFocus on Editor Toolbar\\u003C\\/th\\u003E\\u003Ctd\\u003EAlt + F10\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-02-02T15:40:48-05:00\\u0022\\u003E1770064848\\u003C\\/time\\u003E\\n\"},{\"id\":\"881\",\"internal_id\":\"assist-tech-help-test\",\"type\":\"profile_collection\",\"title\":\"Assistive Technology\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"277\",\"title\":\"Assistive Technology\",\"body\":\"\\u003Cp\\u003EAny approved assistive technology that you use when you\\u2019re online should still work during your exam. If you use assistive technologies (AT), such as screen readers (JAWS, NVDA, VoiceOver, ChromeVox, ZoomText Fusion, etc.) to interact with a standard web browser, the same commands can be used to navigate through content in the digital exam. The exception to this would be if you use a web-based assistive technology or a browser extension.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you use assistive technology, open\\/start the AT device or software before\\u003Cstrong\\u003E \\u003C\\/strong\\u003Eyou open Bluebook for practice and on exam day. On exam day, adjust any necessary settings before you start to check in for the digital exam. Exceptions are noted when configuration is not required ahead of the exam.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"290\",\"title\":\"Text-to-Speech\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019re approved for the accommodation \\u201cText-to-Speech (Embedded),\\u201d then a built-in text-to-speech (TTS) tool will be available whenever you test with Bluebook. You don\\u2019t need to do anything to configure this tool.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EUse the \\u003Cstrong\\u003EPlay\\/Pause \\u003C\\/strong\\u003Ebutton to hear entire passages or engage \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EClick Mode \\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Eto hear specific sentences.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can adjust voice selection, speed, or volume of the playback.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun MacChromeBold NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u0027re testing\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E on a Mac or iPad and you\\u0027re approved for embedded text-to-speech, you can now choose from any \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun ContextualSpellingAndGrammarErrorV2Themed CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003Evoices\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E previously downloaded to the device in addition to standard Bluebook options.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"289\",\"title\":\"Speech-to-Text\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Dictation\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChromebook provides two options for using the dictation feature for items requiring text entry: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003EDictation:\\u003C\\/em\\u003E\\u0026nbsp;From the floating accessibility menu, select \\u003Cstrong\\u003EDictation\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003ESpeak with the onscreen keyboard:\\u0026nbsp;\\u003C\\/em\\u003EFrom the floating accessibility menu select \\u003Cstrong\\u003EOnscreen keyboard\\u003C\\/strong\\u003E. At the top of the onscreen keyboard, select\\u0026nbsp;\\u003Cstrong\\u003ESpeak\\u003C\\/strong\\u003E\\u0026nbsp;(microphone).\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EYou can move, float, dock, and resize the onscreen keyboard.\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003ETap or select where you want to type (input field, free-response questions, essays, etc.). Press\\u202f\\u003Cstrong\\u003ESearch\\u202f+\\u202fD\\u003C\\/strong\\u003E\\u0026nbsp;or \\u202f\\u003Cstrong\\u003ELauncher\\u202f+\\u202fD\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Speech\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Speech, follow the steps below for your operating system:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 10:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fSpeech Recognition\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 11:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fVoice Access\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcut: Press\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fCtrl\\u202f+\\u202fS\\u202f\\u003C\\/strong\\u003Eto turn on speech recognition.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;For Windows 10 or 11, to help with navigation and selecting elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it\\u202f(e.g.,\\u0026nbsp;\\u201c19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use\\u0026nbsp;Voice Control\\u0026nbsp;on a Mac, go to \\u003Cstrong\\u003ESystem Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u0026nbsp;\\u003C\\/em\\u003ETo help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ERecommended:\\u003C\\/em\\u003E Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Voice Control Guide \\u0026gt; Open Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using\\u0026nbsp;Voice Control\\u0026nbsp;on an iPad, go to\\u0026nbsp;\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;To help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ERecommended: Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Open Voice Control Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"278\",\"title\":\"Screen Readers\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook ChromeVox\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo enable ChromeVox, press \\u003Cstrong\\u003ECtrl\\u0026nbsp;+\\u0026nbsp;Alt\\u0026nbsp;+\\u0026nbsp;Z\\u003C\\/strong\\u003E or select it from the floating accessibility menu.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003ENote: \\u003C\\/strong\\u003EIf you\\u0027re approved to use a screen reader and you don\\u0027t see the floating accessibility menu on your Chromebook, let someone at your school know right away.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIf ChromeVox turns off when you launch the Bluebook app or at any time, you can turn it back on with \\u003Cstrong\\u003ECtrl + Alt + Z\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETest content can be navigated with the keyboard. Depending on your keyboard, you can press the \\u003Cstrong\\u003ESearch\\u0026nbsp;\\u003C\\/strong\\u003Eor \\u003Cstrong\\u003ELauncher\\u003C\\/strong\\u003E key for some shortcuts. Both keys work the same way.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation: \\u003C\\/strong\\u003EUse the keyboard shortcuts if parts of the content are not initially reading.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead items on a page\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + right arrow (or left arrow to move back)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EGo to the next\\/previous line\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + up\\/down arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading from the current location\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Narrator\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start or stop Narrator, press the \\u003Cstrong\\u003EWindows logo key + Ctrl + Enter\\u003C\\/strong\\u003E together.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EImportant:\\u0026nbsp;\\u003C\\/strong\\u003EThe Narrator key is a modifier key in the Narrator commands. Both the \\u003Cstrong\\u003ECaps Lock\\u003C\\/strong\\u003E and \\u003Cstrong\\u003EInsert\\u003C\\/strong\\u003E keys are the Narrator key by default. The Narrator key is referred to as \\u201cNarrator\\u201d in commands.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart or stop Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003EWindows logo key + Ctrl + Enter\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EExit Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + Esc\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the next item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + right arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the previous item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + down arrow or Narrator + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChoose \\u003Cstrong\\u003EApple\\u003C\\/strong\\u003E menu \\u0026gt; \\u003Cstrong\\u003ESystem Settings\\u003C\\/strong\\u003E, then click \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E in the sidebar. Click \\u003Cstrong\\u003EVoiceOver on\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPress \\u003Cstrong\\u003ECommand + F5\\u003C\\/strong\\u003E with the keyboard to turn VoiceOver on\\/off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E VO is an abbreviation for VoiceOver keys \\u003Cstrong\\u003EControl + Option\\u003C\\/strong\\u003E.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Command\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ETurn the screen reader on\\/off\\u003C\\/td\\u003E\\u003Ctd\\u003ECommand + F5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead next\\/previous item\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + right arrow\\/left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead the next focusable item (e.g., link, button)\\u003C\\/td\\u003E\\u003Ctd\\u003ETab\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously from this point on\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + A\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver: Go to \\u003Cstrong\\u003ESettings\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EVoiceOver\\u003C\\/strong\\u003E, then on or off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EiPad Only: \\u003C\\/strong\\u003ENavigating Multiple-Choice Answer Options\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard-only users can navigate to a\\u202fradio\\u202fbutton option with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMore radio button options can be accessed with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey and the\\u202f\\u003Cstrong\\u003Espacebar\\u003C\\/strong\\u003E to make an explicit selection.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAlternatively, keyboard-only users can navigate through multiple-choice options with\\u202f\\u003Cstrong\\u003EOption\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys or\\u202f\\u003Cstrong\\u003EControl\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"1031\",\"title\":\"Zoom and Magnification\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Zoom and Magnification\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use the\\u0026nbsp;magnification\\u0026nbsp;feature, select the options from the floating accessibility menu:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull-screen magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + M\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 whole-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAdjust the full-screen magnifier from the floating\\u0026nbsp;\\u003Cstrong\\u003EAccessibility menu\\u0026nbsp;\\u0026gt;\\u0026nbsp;Settings\\u0026nbsp;\\u0026gt;\\u0026nbsp;Display and magnification\\u0026nbsp;\\u0026gt;\\u0026nbsp;Full screen magnifier\\u0026nbsp;\\u0026gt;\\u003C\\/strong\\u003E select any of these options:\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen continuously as mouse moves\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen keeping mouse at center of screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen when mouse touches edge of screen (default)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + D\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 split-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo adjust zoom level, select the down arrow in the\\u0026nbsp;\\u003Cstrong\\u003EDocked zoom level\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo change what\\u2019s magnified, move your pointer or press\\u0026nbsp;\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Zoom and Magnifier\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Magnifier: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 10:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fMagnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 11:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fAccessibility\\u0026nbsp;\\u0026gt;\\u202fVision:\\u0026nbsp;Magnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EOr press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fplus sign (+)\\u003C\\/strong\\u003E. To turn off the Magnifier, press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fEsc\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust the\\u0026nbsp;Magnifier view per your preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ELens\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fL\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fF\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fD\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003ECommand +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003ECommand +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo customize how the zoom area appears, go to\\u202f\\u003Cstrong\\u003EApple menu\\u202f\\u0026gt;\\u202fSystem Settings \\u0026gt;\\u202fAccessibility\\u003C\\/strong\\u003E\\u0026nbsp;and click\\u0026nbsp;\\u003Cstrong\\u003EZoom\\u202fon the right (keyboard shortcut:\\u202fOption\\u202f+\\u202fCommand\\u202f+\\u202f8)\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIn the Advanced Options, select the checkboxes for your zoom preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse keyboard shortcuts to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse trackpad gesture to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse scroll gesture with modifier keys to zoom\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ESelect\\u202fZoom\\u202fstyle\\u0026nbsp;options per student preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ESplit screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EPicture-in-picture\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPinch to zoom in or zoom out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor additional zoom options in the iPad, tap\\u202f\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fZoom\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust any of the following:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcuts:\\u0026nbsp;Control zoom using shortcuts on an external keyboard.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom controller:\\u202fTurn the controller on, set controller actions, and adjust the color and opacity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom region:\\u202fChoose Pinned Zoom, Full Screen Zoom, or Window Zoom.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom filters:\\u202fChoose None, Inverted, Grayscale, Grayscale Inverted, or Low Light.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMaximum zoom level:\\u202fDrag the slider to adjust the level.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\",\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"288\",\"title\":\"MathJax\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EBluebook implements MathJax technology to:\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDisplay mathematical content, such as expressions, equations, and inequalities elegantly in browsers.\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EProvide students who use screen readers with MathCAT access to off-screen accessible MathML for both UEB and Nemeth braille support with refreshable braille displays.\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAccess a variety of accessibility features via menus attached to the MathJax content to assist students with low vision and students that need highlighted rendering.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EMathJax objects within Bluebook exams are custom-configured to function with all mainstream text-to-speech and screen-reading assistive technologies across all supported operating systems. This custom configuration ensures that all mainstream assistive technologies will read the textual alternatives without additional configurations.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOptional MathJax configurations (UEB Support)\\u0026nbsp;\\u003C\\/strong\\u003E\\u0026nbsp;\\u003Cbr\\u003ESome students may prefer to navigate complex math equations and math expressions with math viewers or plugins like MathCAT with personal screen readers like JAWS and NVDA.\\u202f\\u0026nbsp;\\u0026nbsp;\\u003Cbr\\u003ETo explore MathML content, you can press \\u003Cstrong\\u003EAlt + M\\u003C\\/strong\\u003E\\u202f(Windows and Chromebook) or\\u202f\\u003Cstrong\\u003EOption + M\\u003C\\/strong\\u003E\\u202f(Mac and iOS) to turn graphic mode on\\/off. When graphic mode is turned off, students can access the MathML and choose UEB or Nemeth from MathCAT.\\u0026nbsp;\\u003Cbr\\u003E\\u003Cbr\\u003EAlternatively, hidden MathML can be enabled via the MathJax context menu via \\u003Cstrong\\u003EOptions \\u0026gt; Include Hidden MathML\\u003C\\/strong\\u003E\\u003Cbr\\u003E\\u0026nbsp;\\u003Cbr\\u003ENOTE:\\u202fThis action can be set once at the start of an exam, and it will persist throughout the duration. The student may press \\u003Cstrong\\u003EAlt + M\\u003C\\/strong\\u003E (or \\u003Cstrong\\u003EOption + M\\u003C\\/strong\\u003E) again to revert to the default \\u201cgraphic mode on\\u201d configuration or by activating \\u003Cstrong\\u003EReset to defaults\\u003C\\/strong\\u003E within the MathJax Settings (context menu).\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"279\",\"title\":\"Link to Referenced Content\",\"body\":\"\\u003Cp\\u003EOn questions that refer to a specific section of the stimulus content, this symbol \\u003Cstrong\\u003E\\u0026gt;\\u0026gt;\\u003C\\/strong\\u003E will display after the reference. \\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EIf you\\u2019re using a screen reader and you navigate to \\u201clink to referenced content,\\u201d the referenced content will be read to you.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E \\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E For all users, if you scroll past the referenced content and you click on this symbol, the passage will scroll back so the referenced content is at the top of your screen.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"297\",\"title\":\"Refreshable Braille Displays\",\"body\":\"\\u003Cp\\u003ERBDs are used to read text-only content on digital exams. Alternative text descriptions are embedded in the exams for all graphics. RBDs must be properly set up before they can be used by students. For information about installing and setting up RBDs, refer to the product\\u2019s provided instructions and manuals.\\u003C\\/p\\u003E\\u003Cp\\u003ERefreshable braille is not recommended for students that require tactile graphics. Students can request a braille exam or raised line drawings.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-11T10:15:26-04:00\\u0022\\u003E1720707326\\u003C\\/time\\u003E\\n\"},{\"id\":\"876\",\"internal_id\":\"assist-tech-help-home\",\"type\":\"profile_collection\",\"title\":\"Assistive Technology\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"277\",\"title\":\"Assistive Technology\",\"body\":\"\\u003Cp\\u003EAny approved assistive technology that you use when you\\u2019re online should still work during your exam. If you use assistive technologies (AT), such as screen readers (JAWS, NVDA, VoiceOver, ChromeVox, ZoomText Fusion, etc.) to interact with a standard web browser, the same commands can be used to navigate through content in the digital exam. The exception to this would be if you use a web-based assistive technology or a browser extension.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you use assistive technology, open\\/start the AT device or software before\\u003Cstrong\\u003E \\u003C\\/strong\\u003Eyou open Bluebook for practice and on exam day. On exam day, adjust any necessary settings before you start to check in for the digital exam. Exceptions are noted when configuration is not required ahead of the exam.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"290\",\"title\":\"Text-to-Speech\",\"body\":\"\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u2019re approved for the accommodation \\u201cText-to-Speech (Embedded),\\u201d then a built-in text-to-speech (TTS) tool will be available whenever you test with Bluebook. You don\\u2019t need to do anything to configure this tool.\\u0026nbsp;\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EUse the \\u003Cstrong\\u003EPlay\\/Pause \\u003C\\/strong\\u003Ebutton to hear entire passages or engage \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun MacChromeBold SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cstrong\\u003EClick Mode \\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003Eto hear specific sentences.\\u003C\\/span\\u003E\\u003Cspan class=\\u0022EOP SCXW225774823 BCX0\\u0022\\u003E\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TextRun SCXW225774823 BCX0 NormalTextRun\\u0022 lang=\\u0022EN-US\\u0022\\u003EYou can adjust voice selection, speed, or volume of the playback.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022Paragraph SCXW225774823 BCX0\\u0022 lang=\\u0022EN-US\\u0022\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun MacChromeBold NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003EIf you\\u0027re testing\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E on a Mac or iPad and you\\u0027re approved for embedded text-to-speech, you can now choose from any \\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun ContextualSpellingAndGrammarErrorV2Themed CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003Evoices\\u003C\\/span\\u003E\\u003Cspan class=\\u0022TrackChangeTextInsertion TrackedChange SCXW163433578 BCX0 TextRun NormalTextRun CommentHighlightRest\\u0022 lang=\\u0022EN-US\\u0022\\u003E previously downloaded to the device in addition to standard Bluebook options.\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"289\",\"title\":\"Speech-to-Text\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Dictation\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChromebook provides two options for using the dictation feature for items requiring text entry: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003EDictation:\\u003C\\/em\\u003E\\u0026nbsp;From the floating accessibility menu, select \\u003Cstrong\\u003EDictation\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003E\\u003Cem\\u003ESpeak with the onscreen keyboard:\\u0026nbsp;\\u003C\\/em\\u003EFrom the floating accessibility menu select \\u003Cstrong\\u003EOnscreen keyboard\\u003C\\/strong\\u003E. At the top of the onscreen keyboard, select\\u0026nbsp;\\u003Cstrong\\u003ESpeak\\u003C\\/strong\\u003E\\u0026nbsp;(microphone).\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EYou can move, float, dock, and resize the onscreen keyboard.\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003ETap or select where you want to type (input field, free-response questions, essays, etc.). Press\\u202f\\u003Cstrong\\u003ESearch\\u202f+\\u202fD\\u003C\\/strong\\u003E\\u0026nbsp;or \\u202f\\u003Cstrong\\u003ELauncher\\u202f+\\u202fD\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Speech\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Speech, follow the steps below for your operating system:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 10:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fSpeech Recognition\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003EWindows 11:\\u0026nbsp;\\u003C\\/em\\u003ESelect\\u0026nbsp;\\u003Cstrong\\u003EStart \\u0026gt; Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fSpeech\\u202f\\u0026gt; Turn on\\u202fVoice Access\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcut: Press\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fCtrl\\u202f+\\u202fS\\u202f\\u003C\\/strong\\u003Eto turn on speech recognition.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cbr\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;For Windows 10 or 11, to help with navigation and selecting elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it\\u202f(e.g.,\\u0026nbsp;\\u201c19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use\\u0026nbsp;Voice Control\\u0026nbsp;on a Mac, go to \\u003Cstrong\\u003ESystem Settings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u0026nbsp;\\u003C\\/em\\u003ETo help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ERecommended:\\u003C\\/em\\u003E Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Voice Control Guide \\u0026gt; Open Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Voice Control\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using\\u0026nbsp;Voice Control\\u0026nbsp;on an iPad, go to\\u0026nbsp;\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u003C\\/strong\\u003E\\u0026nbsp;enable (turn on)\\u202f\\u003Cstrong\\u003EVoice Control\\u003C\\/strong\\u003E.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cem\\u003ETip:\\u003C\\/em\\u003E\\u0026nbsp;To help navigate and select elements in Bluebook, say\\u0026nbsp;\\u201cshow numbers.\\u201d Numbers will appear on the screen for every element\\/grid in the active window. Say an item\\u2019s corresponding number to select it (e.g.,\\u0026nbsp;\\u201cClick 19, OK\\u201d).\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ERecommended: Learn and practice Voice Control commands in the interactive guide. Go to \\u003Cstrong\\u003ESettings \\u0026gt; Accessibility \\u0026gt; Voice Control \\u0026gt; Open Voice Control Guide\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"278\",\"title\":\"Screen Readers\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook ChromeVox\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo enable ChromeVox, press \\u003Cstrong\\u003ECtrl\\u0026nbsp;+\\u0026nbsp;Alt\\u0026nbsp;+\\u0026nbsp;Z\\u003C\\/strong\\u003E or select it from the floating accessibility menu.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003ENote: \\u003C\\/strong\\u003EIf you\\u0027re approved to use a screen reader and you don\\u0027t see the floating accessibility menu on your Chromebook, let someone at your school know right away.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIf ChromeVox turns off when you launch the Bluebook app or at any time, you can turn it back on with \\u003Cstrong\\u003ECtrl + Alt + Z\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETest content can be navigated with the keyboard. Depending on your keyboard, you can press the \\u003Cstrong\\u003ESearch\\u0026nbsp;\\u003C\\/strong\\u003Eor \\u003Cstrong\\u003ELauncher\\u003C\\/strong\\u003E key for some shortcuts. Both keys work the same way.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation: \\u003C\\/strong\\u003EUse the keyboard shortcuts if parts of the content are not initially reading.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead items on a page\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + right arrow (or left arrow to move back)\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EGo to the next\\/previous line\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + up\\/down arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading from the current location\\u003C\\/td\\u003E\\u003Ctd\\u003ESearch or Launcher + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Narrator\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start or stop Narrator, press the \\u003Cstrong\\u003EWindows logo key + Ctrl + Enter\\u003C\\/strong\\u003E together.\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EImportant:\\u0026nbsp;\\u003C\\/strong\\u003EThe Narrator key is a modifier key in the Narrator commands. Both the \\u003Cstrong\\u003ECaps Lock\\u003C\\/strong\\u003E and \\u003Cstrong\\u003EInsert\\u003C\\/strong\\u003E keys are the Narrator key by default. The Narrator key is referred to as \\u201cNarrator\\u201d in commands.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Shortcut\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart or stop Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003EWindows logo key + Ctrl + Enter\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EExit Narrator\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + Esc\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the next item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + right arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EMove to the previous item\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously\\u003C\\/td\\u003E\\u003Ctd\\u003ENarrator + down arrow or Narrator + R\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver:\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EChoose \\u003Cstrong\\u003EApple\\u003C\\/strong\\u003E menu \\u0026gt; \\u003Cstrong\\u003ESystem Settings\\u003C\\/strong\\u003E, then click \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E in the sidebar. Click \\u003Cstrong\\u003EVoiceOver on\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPress \\u003Cstrong\\u003ECommand + F5\\u003C\\/strong\\u003E with the keyboard to turn VoiceOver on\\/off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Ctable\\u003E\\u003Ccaption\\u003E\\u003Cstrong\\u003EBasic keyboard navigation:\\u003C\\/strong\\u003E VO is an abbreviation for VoiceOver keys \\u003Cstrong\\u003EControl + Option\\u003C\\/strong\\u003E.\\u003C\\/caption\\u003E\\u003Ctbody\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EAction\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003Ctd\\u003E\\u003Cstrong\\u003EKeyboard Command\\u003C\\/strong\\u003E\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ETurn the screen reader on\\/off\\u003C\\/td\\u003E\\u003Ctd\\u003ECommand + F5\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStop\\/pause reading\\u003C\\/td\\u003E\\u003Ctd\\u003ECtrl\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead next\\/previous item\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + right arrow\\/left arrow\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003ERead the next focusable item (e.g., link, button)\\u003C\\/td\\u003E\\u003Ctd\\u003ETab\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003Ctr\\u003E\\u003Ctd\\u003EStart reading continuously from this point on\\u003C\\/td\\u003E\\u003Ctd\\u003EVO + A\\u003C\\/td\\u003E\\u003C\\/tr\\u003E\\u003C\\/tbody\\u003E\\u003C\\/table\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad VoiceOver\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo start using VoiceOver: Go to \\u003Cstrong\\u003ESettings\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EAccessibility\\u003C\\/strong\\u003E \\u0026gt; \\u003Cstrong\\u003EVoiceOver\\u003C\\/strong\\u003E, then on or off.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003E\\u003Cstrong\\u003EiPad Only: \\u003C\\/strong\\u003ENavigating Multiple-Choice Answer Options\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard-only users can navigate to a\\u202fradio\\u202fbutton option with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMore radio button options can be accessed with the\\u202f\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E\\u202fkey and the\\u202f\\u003Cstrong\\u003Espacebar\\u003C\\/strong\\u003E to make an explicit selection.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAlternatively, keyboard-only users can navigate through multiple-choice options with\\u202f\\u003Cstrong\\u003EOption\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys or\\u202f\\u003Cstrong\\u003EControl\\u202f+\\u202farrow\\u003C\\/strong\\u003E\\u202fkeys.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"1031\",\"title\":\"Zoom and Magnification\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EChromebook Zoom and Magnification\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use the\\u0026nbsp;magnification\\u0026nbsp;feature, select the options from the floating accessibility menu:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull-screen magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + M\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 whole-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAdjust the full-screen magnifier from the floating\\u0026nbsp;\\u003Cstrong\\u003EAccessibility menu\\u0026nbsp;\\u0026gt;\\u0026nbsp;Settings\\u0026nbsp;\\u0026gt;\\u0026nbsp;Display and magnification\\u0026nbsp;\\u0026gt;\\u0026nbsp;Full screen magnifier\\u0026nbsp;\\u0026gt;\\u003C\\/strong\\u003E select any of these options:\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen continuously as mouse moves\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen keeping mouse at center of screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMove screen when mouse touches edge of screen (default)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked magnifier\\u202f(\\u003Cstrong\\u003ESearch + Ctrl + D\\u003C\\/strong\\u003E)\\u0026nbsp;\\u2014 split-screen magnification\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo adjust zoom level, select the down arrow in the\\u0026nbsp;\\u003Cstrong\\u003EDocked zoom level\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ETo change what\\u2019s magnified, move your pointer or press\\u0026nbsp;\\u003Cstrong\\u003ETab\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EWindows Zoom and Magnifier\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003EControl +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003EControl +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo use Windows Magnifier: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 10:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fEase of Access\\u202f\\u0026gt;\\u202fMagnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EWindows 11:\\u0026nbsp;Select\\u202f\\u003Cstrong\\u003EStart\\u202f\\u0026gt;\\u202fSettings\\u202f\\u0026gt;\\u202fAccessibility\\u0026nbsp;\\u0026gt;\\u202fVision:\\u0026nbsp;Magnifier\\u202f\\u0026gt;\\u202fTurn on\\u202fMagnifier\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EOr press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fplus sign (+)\\u003C\\/strong\\u003E. To turn off the Magnifier, press the\\u202f\\u003Cstrong\\u003EWindows logo key\\u202f+\\u202fEsc\\u003C\\/strong\\u003E.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust the\\u0026nbsp;Magnifier view per your preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ELens\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fL\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fF\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDocked\\u0026nbsp;(\\u003Cstrong\\u003ECtrl\\u202f+\\u202fAlt\\u202f+\\u202fD\\u003C\\/strong\\u003E)\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EMacOS Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo\\u0026nbsp;zoom in\\/out, press\\u0026nbsp;\\u003Cstrong\\u003ECommand +\\/-\\u003C\\/strong\\u003E. To\\u0026nbsp;reset zoom, press\\u202f\\u003Cstrong\\u003ECommand +\\u202f0\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor touchscreen and touchpad, pinch in\\/out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ETo customize how the zoom area appears, go to\\u202f\\u003Cstrong\\u003EApple menu\\u202f\\u0026gt;\\u202fSystem Settings \\u0026gt;\\u202fAccessibility\\u003C\\/strong\\u003E\\u0026nbsp;and click\\u0026nbsp;\\u003Cstrong\\u003EZoom\\u202fon the right (keyboard shortcut:\\u202fOption\\u202f+\\u202fCommand\\u202f+\\u202f8)\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EIn the Advanced Options, select the checkboxes for your zoom preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse keyboard shortcuts to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse trackpad gesture to zoom\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EUse scroll gesture with modifier keys to zoom\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003ESelect\\u202fZoom\\u202fstyle\\u0026nbsp;options per student preference: \\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EFull screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003ESplit screen\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EPicture-in-picture\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p3\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EiPad Zoom\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EPinch to zoom in or zoom out.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EFor additional zoom options in the iPad, tap\\u202f\\u003Cstrong\\u003ESettings\\u202f\\u0026gt;\\u202fAccessibility\\u202f\\u0026gt;\\u202fZoom\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p2\\u0022\\u003EAdjust any of the following:\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EKeyboard shortcuts:\\u0026nbsp;Control zoom using shortcuts on an external keyboard.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom controller:\\u202fTurn the controller on, set controller actions, and adjust the color and opacity.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom region:\\u202fChoose Pinned Zoom, Full Screen Zoom, or Window Zoom.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EZoom filters:\\u202fChoose None, Inverted, Grayscale, Grayscale Inverted, or Low Light.\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EMaximum zoom level:\\u202fDrag the slider to adjust the level.\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p4\\u0022\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/51\\u0022 hreflang=\\u0022en\\u0022\\u003EAP\\u003C\\/a\\u003E\",\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/60\\u0022 hreflang=\\u0022en\\u0022\\u003ESAT\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"288\",\"title\":\"MathJax\",\"body\":\"\\u003Cp class=\\u0022p1\\u0022\\u003EBluebook implements MathJax technology to:\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cul\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EDisplay mathematical content, such as expressions, equations, and inequalities elegantly in browsers.\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EProvide students who use screen readers with MathCAT access to off-screen accessible MathML for both UEB and Nemeth braille support with refreshable braille displays.\\u0026nbsp;\\u003C\\/li\\u003E\\u003Cli\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u003C\\/span\\u003EAccess a variety of accessibility features via menus attached to the MathJax content to assist students with low vision and students that need highlighted rendering.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/li\\u003E\\u003C\\/ul\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EMathJax objects within Bluebook exams are custom-configured to function with all mainstream text-to-speech and screen-reading assistive technologies across all supported operating systems. This custom configuration ensures that all mainstream assistive technologies will read the textual alternatives without additional configurations.\\u0026nbsp;\\u003Cbr\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EOptional MathJax configurations (UEB Support)\\u0026nbsp;\\u003C\\/strong\\u003E\\u0026nbsp;\\u003Cbr\\u003ESome students may prefer to navigate complex math equations and math expressions with math viewers or plugins like MathCAT with personal screen readers like JAWS and NVDA.\\u202f\\u0026nbsp;\\u0026nbsp;\\u003Cbr\\u003ETo explore MathML content, you can press \\u003Cstrong\\u003EAlt + M\\u003C\\/strong\\u003E\\u202f(Windows and Chromebook) or\\u202f\\u003Cstrong\\u003EOption + M\\u003C\\/strong\\u003E\\u202f(Mac and iOS) to turn graphic mode on\\/off. When graphic mode is turned off, students can access the MathML and choose UEB or Nemeth from MathCAT.\\u0026nbsp;\\u003Cbr\\u003E\\u003Cbr\\u003EAlternatively, hidden MathML can be enabled via the MathJax context menu via \\u003Cstrong\\u003EOptions \\u0026gt; Include Hidden MathML\\u003C\\/strong\\u003E\\u003Cbr\\u003E\\u0026nbsp;\\u003Cbr\\u003ENOTE:\\u202fThis action can be set once at the start of an exam, and it will persist throughout the duration. The student may press \\u003Cstrong\\u003EAlt + M\\u003C\\/strong\\u003E (or \\u003Cstrong\\u003EOption + M\\u003C\\/strong\\u003E) again to revert to the default \\u201cgraphic mode on\\u201d configuration or by activating \\u003Cstrong\\u003EReset to defaults\\u003C\\/strong\\u003E within the MathJax Settings (context menu).\\u0026nbsp;\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"279\",\"title\":\"Link to Referenced Content\",\"body\":\"\\u003Cp\\u003EOn questions that refer to a specific section of the stimulus content, this symbol \\u003Cstrong\\u003E\\u0026gt;\\u0026gt;\\u003C\\/strong\\u003E will display after the reference. \\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EIf you\\u2019re using a screen reader and you navigate to \\u201clink to referenced content,\\u201d the referenced content will be read to you.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E \\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E For all users, if you scroll past the referenced content and you click on this symbol, the passage will scroll back so the referenced content is at the top of your screen.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"},{\"id\":\"297\",\"title\":\"Refreshable Braille Displays\",\"body\":\"\\u003Cp\\u003ERBDs are used to read text-only content on digital exams. Alternative text descriptions are embedded in the exams for all graphics. RBDs must be properly set up before they can be used by students. For information about installing and setting up RBDs, refer to the product\\u2019s provided instructions and manuals.\\u003C\\/p\\u003E\\u003Cp\\u003ERefreshable braille is not recommended for students that require tactile graphics. Students can request a braille exam or raised line drawings.\\u003C\\/p\\u003E\",\"audience\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/25\\u0022 hreflang=\\u0022en\\u0022\\u003EStudents\\u003C\\/a\\u003E\"],\"offering\":[\"\\u003Ca href=\\u0022\\/taxonomy\\/term\\/104\\u0022 hreflang=\\u0022en\\u0022\\u003ECollege Board\\u003C\\/a\\u003E\"],\"suppress_faq_view\":\"Off\"}],\"offering\":\"\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-11T10:14:09-04:00\\u0022\\u003E1720707249\\u003C\\/time\\u003E\\n\"},{\"id\":\"871\",\"internal_id\":\"prac-help-full-AP\",\"type\":\"help_detail\",\"title\":\"Full-Length AP Practice\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EFull-length AP practice is not available in Bluebook. Your AP teacher can assign practice exams to you in \\u003Cstrong\\u003EAP Classroom\\u003C\\/strong\\u003E. Please check there to see what practice resources are available for your course.\\u003C\\/p\\u003E\",\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-02-09T19:54:49-05:00\\u0022\\u003E1675990489\\u003C\\/time\\u003E\\n\"},{\"id\":\"866\",\"internal_id\":\"prac-help-preview-AP\",\"type\":\"help_detail\",\"title\":\"AP Exam Previews\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EThese short previews will give you a way to see real AP questions in the app, try out the testing tools, and practice testing with any assistive technology you may use.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EAP Exam previews will not be scored.\\u003C\\/p\\u003E\",\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-03-31T15:47:59-04:00\\u0022\\u003E1680292079\\u003C\\/time\\u003E\\n\"},{\"id\":\"861\",\"internal_id\":\"test-preview-overview\",\"type\":\"functional_content\",\"title\":\"Test Preview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Ch2\\u003EExplore Bluebook\\u003C\\/h2\\u003E\\u003Cp\\u003ESample questions from AP Exams or the SAT Suite, and try out the testing tools. You won\\u2019t receive scores or any feedback on your answers.\\u003C\\/p\\u003E\",\"icon\":\"ico-magnify-glass\",\"id\":\"test-preview-overview-p1\"},{\"content\":\"\\u003Ch2\\u003ETake Your Time\\u003C\\/h2\\u003E\\u003Cp\\u003EThe sections in this preview are untimed. On test day, a timer will be running. If you\\u2019re approved for extra time or breaks, you\\u2019ll get that on test day.\\u003C\\/p\\u003E\",\"icon\":\"ico-clock\",\"id\":\"test-preview-overview-p2\"},{\"content\":\"\\u003Ch2\\u003EAssistive Technology (AT)\\u003C\\/h2\\u003E\\u003Cp\\u003EBe sure to practice with any AT you use for testing. If you configure your AT settings here, \\u0026nbsp;you may need to repeat this step on test day.\\u0026nbsp;\\u003C\\/p\\u003E\",\"icon\":\"ico-assist-tech-figure\",\"id\":\"test-preview-overview-p3\"},{\"content\":\"\\u003Ch2\\u003ENo Device Lock\\u003C\\/h2\\u003E\\u003Cp\\u003EWe don\\u2019t lock your device on previews. On test day, you\\u0027ll be blocked from using other programs or apps.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\",\"icon\":\"ico-unlock\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP, SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-13T13:56:09-04:00\\u0022\\u003E1773424569\\u003C\\/time\\u003E\\n\"},{\"id\":\"856\",\"internal_id\":\"submit-success-ap-pilot\",\"type\":\"functional_content\",\"title\":\"This Part of the Exam Is Over\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003EThank you for joining this AP Exam pilot!\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAP Music Theory: \\u003C\\/strong\\u003EAfter you complete the sight-singing questions, the exam is over.\\u003C\\/p\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003E\\u003Cstrong\\u003EAP Chinese \\u003C\\/strong\\u003Eand \\u003Cstrong\\u003EAP Spanish: \\u003C\\/strong\\u003EYou\\u2019re all done!\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-07-21T15:29:55-04:00\\u0022\\u003E1784662195\\u003C\\/time\\u003E\\n\"},{\"id\":\"851\",\"internal_id\":\"short-break-ap\",\"type\":\"functional_content\",\"title\":\"Testing Resumes Shortly: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EPlease stay in your seat and remain silent\\u2014other students may still be testing.\\u003C\\/p\\u003E\",\"id\":\"short-break-ap-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-07-11T14:50:28-04:00\\u0022\\u003E1689101428\\u003C\\/time\\u003E\\n\"},{\"id\":\"846\",\"internal_id\":\"short-break-sat\",\"type\":\"functional_content\",\"title\":\"Testing Resumes Shortly: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EPlease stay in your seat and remain silent\\u2014other students may still be testing.\\u003C\\/p\\u003E\",\"id\":\"short-break-sat-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222023-07-11T14:49:43-04:00\\u0022\\u003E1689101383\\u003C\\/time\\u003E\\n\"},{\"id\":\"841\",\"internal_id\":\"submit-success-ap\",\"type\":\"functional_content\",\"title\":\"Congratulations!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EThe exam is over, and your answers have been submitted.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EStay seated\\u003C\\/strong\\u003E until your proctor dismisses you.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003ERemain quiet. \\u003C\\/strong\\u003EOther students may still be testing.\\u003C\\/p\\u003E\\u003Cp\\u003ECheck \\u003Cstrong\\u003Eapstudents.org\\u003C\\/strong\\u003E to see when your scores will be available.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-09-30T14:40:21-04:00\\u0022\\u003E1727721621\\u003C\\/time\\u003E\\n\"},{\"id\":\"836\",\"internal_id\":\"submit-success-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Congratulations!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EThe test is complete, and your answers have been submitted.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour proctor will dismiss you\\u003C\\/strong\\u003E when it\\u2019s time to go.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EPlease be quiet\\u003C\\/strong\\u003E; other students may still be testing.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-10-09T16:44:50-04:00\\u0022\\u003E1728506690\\u003C\\/time\\u003E\\n\"},{\"id\":\"831\",\"internal_id\":\"submit-success-sat-schoolday-pilot\",\"type\":\"functional_content\",\"title\":\"Congratulations!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYour test is complete, and your answers have been submitted.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EYour proctor will excuse you when it\\u2019s time to go.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EPlease be quiet; other students may still be testing.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp\\u003EThank you for joining this pilot exam! We\\u2019ll email you a post-exam survey soon.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-11-30T18:02:45-05:00\\u0022\\u003E1669849365\\u003C\\/time\\u003E\\n\"},{\"id\":\"826\",\"internal_id\":\"ready-bag-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EPut these items in your bag:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ESmart glasses, a smartphone, smartwatch, or any other devices \\u003C\\/strong\\u003Eincluding cameras, recording devices, or timers. Your proctor may collect these items before testing.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-smart-glasses\",\"id\":\"ready-bag-sat-schoolday-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ENotes, books, or any other reference materials\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-no-notes\",\"id\":\"ready-bag-sat-schoolday-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EHeadphones or earbuds\\u003C\\/strong\\u003E unless you have an approved accommodation.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-headphones\",\"id\":\"ready-bag-sat-schoolday-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-13T16:12:48-04:00\\u0022\\u003E1773432768\\u003C\\/time\\u003E\\n\"},{\"id\":\"821\",\"internal_id\":\"ready-proctor-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Get Your Desk Ready\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour proctor will collect these items:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cstrong\\u003ESmart glasses, a smartphone, smartwatch\\u003C\\/strong\\u003E, or any other connected device including cameras, recording devices, or timers.\\u0026nbsp;\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-no-smart-glasses\",\"id\":\"ready-proctor-sat-wkd-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ENotes, books, or any other reference materials\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"icon\":\"ico-no-notes\",\"id\":\"ready-proctor-sat-wkd-p2\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EHeadphones or earbuds\\u0026nbsp;\\u003C\\/strong\\u003Eunless you have an approved accommodation.\\u003C\\/p\\u003E\",\"icon\":\"ico-no-headphones\",\"id\":\"ready-proctor-sat-wkd-p3\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-03-13T16:10:21-04:00\\u0022\\u003E1773432621\\u003C\\/time\\u003E\\n\"},{\"id\":\"816\",\"internal_id\":\"checkin-overview-sat-linear-day2\",\"type\":\"functional_content\",\"title\":\"Day 2 Test Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EDay 2 of the SAT, PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9 consists of the Math section.\\u003C\\/p\\u003E\\u003Ch2\\u003EMath (54 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Math section. Each module has 27 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003EModules\\u003C\\/h2\\u003E\\u003Cp\\u003EThe two modules are timed separately. If time permits, you can review your answers in a given module. When the timer reaches zero, you will automatically move on. Once you move on from any module, you cannot return to it.\\u003C\\/p\\u003E\\u003Ch2\\u003EDirections\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDirections for answering the questions appear at the start of each section. You can find these directions at the top-left corner of every question screen.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-sat-linear-day2-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-31T12:56:38-04:00\\u0022\\u003E1722444998\\u003C\\/time\\u003E\\n\"},{\"id\":\"811\",\"internal_id\":\"checkin-overview-sat-linear-day1\",\"type\":\"functional_content\",\"title\":\"Day 1 Test Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EDay 1 of the SAT, PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9 consists of the Reading and Writing section.\\u003C\\/p\\u003E\\u003Ch2\\u003EReading and Writing (66 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Reading and Writing section. Each module has 33 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003EModules\\u003C\\/h2\\u003E\\u003Cp\\u003EThe two modules are timed separately. If time permits, you can review your answers in a given module. When the timer reaches zero, you will automatically move on. Once you move on from any module, you cannot return to it.\\u003C\\/p\\u003E\\u003Ch2\\u003EDirections\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDirections for answering the questions appear at the start of each section. You can find these directions at the top-left corner of every question screen.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-sat-linear-day1-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-31T12:55:57-04:00\\u0022\\u003E1722444957\\u003C\\/time\\u003E\\n\"},{\"id\":\"806\",\"internal_id\":\"checkin-overview-sat-day2\",\"type\":\"functional_content\",\"title\":\"Day 2 Test Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EDay 2 of the SAT, PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9 consists of the Math section.\\u003C\\/p\\u003E\\u003Ch2\\u003EMath (44 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Math section. Each module has 22 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003EModules\\u003C\\/h2\\u003E\\u003Cp\\u003EThe two modules are timed separately. If time permits, you can review your answers in a given module. When the timer reaches zero, you will automatically move on. Once you move on from any module, you cannot return to it.\\u003C\\/p\\u003E\\u003Ch2\\u003EDirections\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDirections for answering the questions appear at the start of each section. You can find these directions at the top-left corner of every question screen.\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-sat-day2-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-07-31T12:45:17-04:00\\u0022\\u003E1722444317\\u003C\\/time\\u003E\\n\"},{\"id\":\"801\",\"internal_id\":\"checkin-overview-sat-day1\",\"type\":\"functional_content\",\"title\":\"Day 1 Test Overview\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EDay 1 of the SAT, PSAT\\/NMSQT, PSAT 10, or PSAT 8\\/9 consists of a Reading and Writing section.\\u003C\\/p\\u003E\\u003Ch2\\u003EReading and Writing (54 Questions)\\u003C\\/h2\\u003E\\u003Cp\\u003EThere are two modules in the Reading and Writing section. Each module has 27 questions.\\u003C\\/p\\u003E\\u003Ch2\\u003EModules\\u003C\\/h2\\u003E\\u003Cp\\u003EThe two modules are timed separately. If time permits, you can review your answers in a given module. When the timer reaches zero, you will automatically move on. Once you move on from any module, you cannot return to it.\\u003C\\/p\\u003E\\u003Ch2\\u003EDirections\\u003C\\/h2\\u003E\\u003Cp class=\\u0022p1\\u0022\\u003EDirections for answering the questions appear at the start of each section. You can find these directions at the top-left corner of every question screen.\\u0026nbsp;\\u003C\\/p\\u003E\",\"id\":\"checkin-overview-sat-day1-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222026-01-15T15:38:45-05:00\\u0022\\u003E1768509525\\u003C\\/time\\u003E\\n\"},{\"id\":\"796\",\"internal_id\":\"submit-success-sat-wkd-pilot\",\"type\":\"functional_content\",\"title\":\"Congratulations!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYour test is complete, and your answers have been submitted.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003ERaise your hand, and your proctor will collect your scratch paper and return any items they collected.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EPlease be quiet as you leave the test center; other students may still be testing.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp\\u003EThank you for joining this pilot exam! We\\u2019ll email you a post-exam survey soon.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-11-10T15:14:32-05:00\\u0022\\u003E1668111272\\u003C\\/time\\u003E\\n\"},{\"id\":\"791\",\"internal_id\":\"submit-success-sat-wkd\",\"type\":\"functional_content\",\"title\":\"Congratulations!\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EYour test is complete, and your answers have been submitted.\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\",\"id\":\"submit-success-p1\"},{\"content\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ERaise your hand\\u003C\\/strong\\u003E, and your proctor will dismiss you.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EPlease be quiet\\u003C\\/strong\\u003E; other students may still be testing.\\u003C\\/p\\u003E\\u003Cp\\u003EGo to \\u003Cstrong\\u003EMy SAT \\u003C\\/strong\\u003Eto see when your scores will be available.\\u003C\\/p\\u003E\",\"id\":\"submit-success-p2\"},{\"id\":\"submit-success-button-p3\",\"title\":\"Return to Homepage\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222024-09-30T14:38:39-04:00\\u0022\\u003E1727721519\\u003C\\/time\\u003E\\n\"},{\"id\":\"786\",\"internal_id\":\"section-break-ap-practice\",\"type\":\"functional_content\",\"title\":\"Practice Test Break\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYou can resume this practice test as soon as you\\u2019re ready to move on. On test day, you\\u2019ll wait until the clock counts down. Read below to see how breaks work on test day.\\u003C\\/p\\u003E\",\"id\":\"section-break-ap-practice-p1\",\"title\":\"Practice Test Break\"},{\"content\":\"\\u003Cp\\u003EAfter the break, a \\u003Cspan data-ssml-sub-alias=\\u0022\\u201crezoom\\u201d\\u0022\\u003E\\u003Cstrong\\u003EResume\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cstrong\\u003E Testing Now\\u003C\\/strong\\u003E\\u0026nbsp;button will appear and you\\u0027ll start the next section.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EFollow these rules during the break:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Col\\u003E\\u003Cli\\u003EDo not disturb students who are still testing.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not exit the app or close your laptop.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not access\\u0026nbsp;phones, smartwatches, textbooks, notes, or the internet.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not eat or drink in the test room.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not speak in the test room; outside the test room, do not discuss the exam with anyone.\\u003C\\/li\\u003E\\u003C\\/ol\\u003E\",\"id\":\"section-break-ap-practice-p2\",\"title\":\"Take a Break: Do Not Close Your Device\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-06-05T13:16:15-04:00\\u0022\\u003E1749143775\\u003C\\/time\\u003E\\n\"},{\"id\":\"781\",\"internal_id\":\"section-break-sat-practice\",\"type\":\"functional_content\",\"title\":\"Practice Test Break\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYou can resume this practice test as soon as you\\u2019re ready to move on. On test day, you\\u2019ll wait until the clock counts down. Read below to see how breaks work on test day.\\u003C\\/p\\u003E\",\"id\":\"section-break-sat-practice-p1\",\"title\":\"Practice Test Break\"},{\"content\":\"\\u003Cp\\u003EAfter the break, a \\u003Cspan data-ssml-sub-alias=\\u0022\\u201crezoom\\u201d\\u0022\\u003E\\u003Cstrong\\u003EResume\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cstrong\\u003E Testing Now\\u003C\\/strong\\u003E\\u0026nbsp;button will appear and you\\u0027ll start the next section.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EFollow these rules during the break:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Col\\u003E\\u003Cli\\u003EDo not disturb\\u0026nbsp;students who are still testing.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not exit the app or close your laptop.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not access\\u0026nbsp;phones, smartwatches, textbooks, notes, or the internet.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not eat or drink near any testing device.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not speak in the testing room; outside the room, do not discuss the exam with anyone.\\u003C\\/li\\u003E\\u003C\\/ol\\u003E\",\"id\":\"section-break-sat-practice-p2\",\"title\":\"Take a Break: Do Not Close Your Device\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-06-05T13:16:54-04:00\\u0022\\u003E1749143814\\u003C\\/time\\u003E\\n\"},{\"id\":\"776\",\"internal_id\":\"section-break-ap\",\"type\":\"functional_content\",\"title\":\"Take a Break: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EAfter the break, a \\u003Cspan data-ssml-sub-alias=\\u0022\\u201crezoom\\u201d\\u0022\\u003E\\u003Cstrong\\u003EResume\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cstrong\\u003E Testing Now\\u003C\\/strong\\u003E\\u0026nbsp;button will appear and you\\u0027ll start the next section.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EFollow these rules during the break:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Col\\u003E\\u003Cli\\u003EDo not disturb students who are still testing.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not exit the\\u0026nbsp;app or close your laptop.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not access phones, smartwatches, textbooks, notes, or the internet.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not eat or drink in the test room.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not speak in the test room; outside the test room, do not discuss the exam with anyone.\\u003C\\/li\\u003E\\u003C\\/ol\\u003E\",\"id\":\"section-break-ap-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"AP\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-06-05T13:15:14-04:00\\u0022\\u003E1749143714\\u003C\\/time\\u003E\\n\"},{\"id\":\"771\",\"internal_id\":\"section-break-sat-schoolday\",\"type\":\"functional_content\",\"title\":\"Take a Break: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EAfter the break, a \\u003Cspan data-ssml-sub-alias=\\u0022\\u201crezoom\\u201d\\u0022\\u003E\\u003Cstrong\\u003EResume\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003Cstrong\\u003E Testing Now\\u003C\\/strong\\u003E\\u0026nbsp;button will appear and you\\u0027ll start the next section.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EFollow these rules during the break:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Col\\u003E\\u003Cli\\u003EDo not disturb students who are still testing.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not exit the app or close your laptop.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not access\\u0026nbsp;phones, smartwatches, textbooks, notes, or the internet.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not eat or drink near any testing device.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not speak in the testing room; outside the room, do not discuss the exam with anyone.\\u003C\\/li\\u003E\\u003C\\/ol\\u003E\",\"id\":\"section-break-sat-schoolday-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-05-28T12:35:20-04:00\\u0022\\u003E1748450120\\u003C\\/time\\u003E\\n\"},{\"id\":\"766\",\"internal_id\":\"section-break-sat-weekend\",\"type\":\"functional_content\",\"title\":\"Take a Break: Do Not Close Your Device\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003EYou may leave the room, but do not disturb students who are still testing.\\u003C\\/p\\u003E\\u003Cp\\u003ETesting won\\u2019t \\u003Cspan data-ssml-sub-alias=\\u0022\\u201crezoom\\u201d\\u0022\\u003Eresume\\u003C\\/span\\u003E until you return.\\u003C\\/p\\u003E\\u003Cp\\u003E\\u003Cstrong\\u003EFollow these rules during the break:\\u003C\\/strong\\u003E\\u003C\\/p\\u003E\\u003Col\\u003E\\u003Cli\\u003EDo not access your phone,\\u0026nbsp;smartwatch, textbooks, notes, or the internet.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not eat or drink in the testing room.\\u003C\\/li\\u003E\\u003Cli\\u003EDo not speak in the testing room; outside the room, do not discuss the exam with anyone.\\u003C\\/li\\u003E\\u003Cli\\u003EIf you leave the room, bring your photo ID.\\u003C\\/li\\u003E\\u003C\\/ol\\u003E\",\"id\":\"section-break-sat-weekend-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222025-06-05T13:18:46-04:00\\u0022\\u003E1749143926\\u003C\\/time\\u003E\\n\"},{\"id\":\"756\",\"internal_id\":\"review-1234-sat-practice\",\"type\":\"functional_content\",\"title\":\"Check Your Work\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"content\":[{\"content\":\"\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EOn test day, you won\\u2019t be able to move on to the next module until time expires.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003EFor these practice questions, you can click \\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cstrong\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003ENext\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/strong\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E\\u003Cspan\\u003E when you\\u2019re ready to move on.\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/span\\u003E\\u003C\\/p\\u003E\",\"id\":\"review-1234-sat-practice-p1\"}],\"cancel_interaction\":[],\"confirm_interaction\":[],\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-09-21T17:07:02-04:00\\u0022\\u003E1663794422\\u003C\\/time\\u003E\\n\"},{\"id\":\"751\",\"internal_id\":\"accomms-for-practice\",\"type\":\"help_detail\",\"title\":\"Selecting Accommodations for Practice Tests\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EYou\\u2019re encouraged to apply accommodations to your full-length practice test so you can get a feel for how accommodations work with digital exams. But selecting accommodations on a practice test does not mean those accommodations will be applied to your actual test. On test day, only College Board\\u2013approved accommodations will be applied to your digital exam.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-09-21T09:01:30-04:00\\u0022\\u003E1663765290\\u003C\\/time\\u003E\\n\"},{\"id\":\"746\",\"internal_id\":\"apply-for-accomms\",\"type\":\"help_detail\",\"title\":\"How to Apply for an Accommodation\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EFor most accommodations, the easiest thing to do is to have your school\\u2019s SSD coordinator apply for the accommodation on your behalf. (\\u201cSSD\\u201d stands for Services for Students with Disabilities.) If you\\u2019re not sure who the SSD coordinator is at your school, ask your counselor. For more information, visit \\u003Cstrong\\u003Eaccommodations.collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-09-12T17:05:44-04:00\\u0022\\u003E1663016744\\u003C\\/time\\u003E\\n\"},{\"id\":\"741\",\"internal_id\":\"what-accomms-approved\",\"type\":\"help_detail\",\"title\":\"Find Your Approved Accommodations\\u00a0\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you have a College Board\\u2013approved accommodation, you should\\u2019ve received a letter from our SSD office (\\u201cSSD\\u201d stands for Services for Students with Disabilities). For more information, visit \\u003Cstrong\\u003Eaccommodations.collegeboard.org\\u003C\\/strong\\u003E.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-09-12T17:04:57-04:00\\u0022\\u003E1663016697\\u003C\\/time\\u003E\\n\"},{\"id\":\"731\",\"internal_id\":\"enable-keyboard-mac\",\"type\":\"help_detail\",\"title\":\"Enable Full Keyboard Access for Macs\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\\u003Cp\\u003EIf you use the tab and shift keys to navigate websites and applications, you may need to enable this setting on your Mac laptop.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you\\u2019re on Monterey (macOS 12.0 or later), go to \\u003Cstrong\\u003ESystem Preferences \\u003C\\/strong\\u003E\\u0026gt; \\u003Cstrong\\u003EAccessibility \\u003C\\/strong\\u003E\\u0026gt; \\u003Cstrong\\u003EKeyboard \\u003C\\/strong\\u003E\\u0026gt; and check \\u201cEnable full keyboard access.\\u201d\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003EIf you\\u2019re on an earlier Mac operating system, you may need to update your OS to take advantage of this feature.\\u003C\\/p\\u003E\",\"offering\":\"SAT\",\"delivery_method\":\"\",\"changed\":\"\\u003Ctime datetime=\\u00222022-09-07T18:08:42-04:00\\u0022\\u003E1662588522\\u003C\\/time\\u003E\\n\"},{\"id\":\"726\",\"internal_id\":\"keyboard-shortcuts-ap-testing\",\"type\":\"profile_collection\",\"title\":\"Keyboard Shortcuts\",\"short_title\":\"\",\"alternate_title\":\"\",\"internal_description\":\"\",\"external_description\":\"\",\"overview\":\"\",\"body\":\"\",\"help_items\":[{\"id\":\"280\",\"title\":\"Keyboard Shortcuts: AP\",\"body\":\"\\u003Cp\\u003EThe following keyboard shortcuts have been configured to navigate to important functions within the digital exam.\\u003C\\/p\\u003E\\n\\n\\u003Cp\\u003E\\u0026nbsp;\\u003C\\/p\\u003E\\n\\n\\u003Ctable class=\\u0022cb-table\\u0022\\u003E\\n\\t\\u003Ccaption\\u003EKeyboard Shortcuts for Multiple-Choice Questions\\u003C\\/caption\\u003E\\n\\t\\u003Cthead\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EAction\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EPC\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EChromebook\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EMac\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022col\\u0022\\u003EiPad\\u003C\\/th\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\u003C\\/thead\\u003E\\n\\t\\u003Ctbody\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom In\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Plus (+)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Up Arrow (or Pinch to Zoom)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom Out\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Minus (-)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + Down Arrow (or Pinch to Zoom)\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\u003C\\/tr\\u003E\\n\\t\\t\\u003Ctr\\u003E\\n\\t\\t\\t\\u003Cth scope=\\u0022row\\u0022\\u003E\\n\\t\\t\\t\\u003Cp\\u003EZoom Back to 100%\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/th\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003EControl + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\\u003Cp\\u003ECommand + 0\\u003C\\/p\\u003E\\n\\t\\t\\t\\u003C\\/td\\u003E\\n\\t\\t\\t\\u003Ctd\\u003E\\n\\t\\t\\t\